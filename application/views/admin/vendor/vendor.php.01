<script>
$(document).ready(function() {
    $('select').select2({allowClear: true, placeholder: "Select Status"});
    $('.btn_back').on('click', function(){
        window.location.href = "/<?= $TYPE; ?>/vendor";
    });

	$(document).on('change', '.vendor-status-select', function(){
		var admin_id = $(this).data('id');
		var new_status = $(this).val();
		var admin_note = '';
		var $sel = $(this);

        // Immediate Commission input toggle
        if(new_status == '0') {
            $('input[name="commission"]').prop('disabled', false);
        } else {
            $('input[name="commission"]').prop('disabled', true);
        }

		if (!confirm('Are you sure you want to change this vendor\'s status?')) {
            // Revert changes if cancelled
            $sel.val('<?= isset($status) ? $status : '0'; ?>').trigger('change.select2');
            if('<?= isset($status) ? $status : '0'; ?>' == '0') {
                $('input[name="commission"]').prop('disabled', false);
            } else {
                $('input[name="commission"]').prop('disabled', true);
            }
			return;
		}
		if(new_status == '2'){
			admin_note = prompt('Enter rejection note:', '') || '';
			admin_note = (admin_note || '').trim();
			if(admin_note === ''){
				alert('Rejection note is required.');
				$sel.val('<?= isset($status) ? $status : '0'; ?>').trigger('change.select2');
				return;
			}
		}
		$sel.prop('disabled', true);

		var postData = {
			'<?= isset($csrf) ? $csrf->name : '' ?>': '<?= isset($csrf) ? $csrf->hash : '' ?>',
			admin_id: admin_id,
			status: new_status,
			admin_note: admin_note
		};

		$.ajax({
			url: "/<?= $TYPE; ?>/vendor/ajax_update_status",
			type: 'POST',
			dataType: 'json',
			data: postData,
			success: function(resp){
				if(!(resp && resp.success)){
					alert((resp && resp.msg) ? resp.msg : 'Failed to update status.');
				}
				$sel.prop('disabled', false);
			},
			error: function(){
				alert('An error occurred.');
				$sel.prop('disabled', false);
			}
		});
	});

	$(document).on('change', '.vendor-enabled-switch', function(){
		var vendor_id = $(this).data('id');
		var enabled = $(this).is(':checked') ? '1' : '0';
		var $chk = $(this);
		var $state = $('.vendor-enabled-state');
		$chk.prop('disabled', true);
		var postData = {
			'<?= isset($csrf) ? $csrf->name : '' ?>': '<?= isset($csrf) ? $csrf->hash : '' ?>',
			vendor_id: vendor_id,
			enabled: enabled
		};
		$.ajax({
			url: "/<?= $TYPE; ?>/vendor/ajax_toggle_vendor_enabled",
			type: 'POST',
			dataType: 'json',
			data: postData,
			success: function(resp){
				if(!(resp && resp.success)){
					alert((resp && resp.msg) ? resp.msg : 'Failed to update.');
					$chk.prop('checked', ! $chk.is(':checked'));
					enabled = $chk.is(':checked') ? '1' : '0';
				}
				$state.text((enabled === '1') ? 'Enabled' : 'Disabled');
				$state.attr('data-enabled', enabled);
				$chk.prop('disabled', false);
			},
			error: function(){
				alert('An error occurred.');
				enabled = $chk.is(':checked') ? '1' : '0';
				$state.text((enabled === '1') ? 'Enabled' : 'Disabled');
				$state.attr('data-enabled', enabled);
				$chk.prop('disabled', false);
			}
		});
	});
});
</script>