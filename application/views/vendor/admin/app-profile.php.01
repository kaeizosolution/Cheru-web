<script>        
$(document).ready(function(){
    
    $('#success_msg').hide();   
    $('#owner_error_msg').hide();       
    
    // Owner Form Submit
    $('#owner_information').on('submit', function (e) {
      e.preventDefault();
      var formdata = new FormData(this);      
      $.ajax({
        type: 'POST',
        url: '<?= (isset($use_api) && $use_api && !empty($access_token)) ? base_url("api/v1/vendor/profile/update") : "/vendor/profile/ajaxform" ?>',
        headers: <?= (isset($use_api) && $use_api && !empty($access_token)) ? json_encode(['Authorization' => 'Bearer ' . $access_token]) : '{}' ?>,
        data: formdata,
        contentType:false,
        processData:false,
        dataType:"json",
        success: function (data) {
                var isSuccess = data.success || (data.status == 1);
                var msg = data.msg || data.message || 'Updated Successfully.';
                if(isSuccess){
                    $('#success_msg').html('<div class="alert alert-success">'+msg+'</div>');              
                    $('#success_msg').show(); 
                    window.location.reload();
                }else{                  
                    var errMsg = (data.errors && data.errors.length > 0) ? data.errors[0] : msg;
                    $('#owner_error_msg').html('<div class="alert alert-danger">'+errMsg+'</div>');
                    $('#owner_error_msg').show(); 
                }
            },
        error: function(xhr) {
                var errMsg = 'Failed to update profile.';
                if (xhr.responseText) {
                    try {
                        var res = JSON.parse(xhr.responseText);
                        errMsg = (res.errors && res.errors.length > 0) ? res.errors[0] : (res.message || errMsg);
                    } catch(e) {}
                }
                $('#owner_error_msg').html('<div class="alert alert-danger">'+errMsg+'</div>');
                $('#owner_error_msg').show(); 
            }
        });
    });
    
    // Account Form Submit
    $('#account_success_msg').hide();
    $('#account_error_msg').hide();     
    $('#account_information').on('submit', function (e) {
      e.preventDefault();
	  if(<?= $__vendor_profile_readonly ? 'true' : 'false' ?>){
		return;
	  }
      var data_acc = new FormData(this);    
      $.ajax({
        type: 'POST',
        url: '<?= (isset($use_api) && $use_api && !empty($access_token)) ? base_url("api/v1/vendor/profile/update_profile") : "/vendor/profile/ajax_accountform" ?>',
        headers: <?= (isset($use_api) && $use_api && !empty($access_token)) ? json_encode(['Authorization' => 'Bearer ' . $access_token]) : '{}' ?>,
        data: data_acc,
        contentType:false,
        processData:false,
        dataType:"json",
        success: function (data) {
                var isSuccess = data.success || (data.status == 1);
                var msg = data.msg || data.message || 'Updated Successfully.';
                if(isSuccess){
                    $('#account_success_msg').html('<div class="alert alert-success">'+msg+'</div>');
                    $('#account_success_msg').show(); 
                    window.location.reload();
                }else{                  
                    var errMsg = (data.errors && data.errors.length > 0) ? data.errors[0] : msg;
                    $('#account_error_msg').html('<div class="alert alert-danger">'+errMsg+'</div>');
                    $('#account_error_msg').show(); 
                }
            },
        error: function(xhr) {
                var errMsg = 'Failed to update store info.';
                if (xhr.responseText) {
                    try {
                        var res = JSON.parse(xhr.responseText);
                        errMsg = (res.errors && res.errors.length > 0) ? res.errors[0] : (res.message || errMsg);
                    } catch(e) {}
                }
                $('#account_error_msg').html('<div class="alert alert-danger">'+errMsg+'</div>');
                $('#account_error_msg').show(); 
            }
        });
    });
 
	$('#doc_success_msg').hide();
	$('#doc_error_msg').hide();
	$('#vendor_documents_reupload').on('submit', function(e){
		e.preventDefault();
		var formData = new FormData(this);
		$.ajax({
			type: 'POST',
			url: '<?= (isset($use_api) && $use_api && !empty($access_token)) ? base_url("api/v1/vendor/profile/documents") : "/vendor/profile/reupload_documents" ?>',
			headers: <?= (isset($use_api) && $use_api && !empty($access_token)) ? json_encode(['Authorization' => 'Bearer ' . $access_token]) : '{}' ?>,
			data: formData,
			contentType:false,
			processData:false,
			dataType:"json",
			success: function(data) {
				var isSuccess = data.success || (data.status == 1);
				var msg = data.msg || data.message || 'Documents submitted successfully.';
				if(isSuccess){
					$('#doc_success_msg').html('<div class="alert alert-success">'+msg+'</div>');
					$('#doc_success_msg').show();
					setTimeout(function(){ window.location.reload(); }, 900);
				}else{
					var errMsg = (data.errors && data.errors.length > 0) ? data.errors[0] : msg;
					$('#doc_error_msg').html('<div class="alert alert-danger">'+errMsg+'</div>');
					$('#doc_error_msg').show();
				}
			},
			error: function(xhr) {
				var errMsg = 'Failed to submit documents.';
				if (xhr.responseText) {
					try {
						var res = JSON.parse(xhr.responseText);
						errMsg = (res.errors && res.errors.length > 0) ? res.errors[0] : (res.message || errMsg);
					} catch(e) {}
				}
				$('#doc_error_msg').html('<div class="alert alert-danger">'+errMsg+'</div>');
				$('#doc_error_msg').show();
			}
		});
	});

    <?php if (isset($use_api) && $use_api && !empty($access_token)) { ?>
    // Fetch profile info from API (visible in Network Tab)
    $.ajax({
        type: 'GET',
        url: '<?= base_url("api/v1/vendor/profile") ?>',
        headers: {
            'Authorization': 'Bearer <?= $access_token ?>'
        },
        dataType: 'json',
        success: function(res) {
            if(res && res.status == 1 && res.data) {
                var p = res.data;
                if(p.name)       $('input[name="fname"]').val(p.name);
                if(p.email)      $('input[name="email"]').val(p.email);
                if(p.mobile)     $('input[name="mobile"]').val(p.mobile);
                if(p.store_name) { $('input[name="store_name"]').val(p.store_name); $('.profile-name h4').text(p.store_name); }
                if(p.address)    $('input[name="address"]').val(p.address);
                if(p.city)       { $('input[name="city"]').val(p.city); $('.profile-name p').text(p.city); }
                if(p.zip)        $('input[name="zip"]').val(p.zip);
                if(p.country)    $('input[name="country"]').val(p.country);
                if(p.house_no)   $('input[name="house_no"]').val(p.house_no);
                if(p.latitude)   $('#latitude').val(p.latitude);
                if(p.longitude)  $('#longitude').val(p.longitude);
                if(p.place_id)   $('#location_id').val(p.place_id);
            }
        }
    });
    <?php } ?>

    // ===== CHANGE PASSWORD FORM =====
    $('#pwd_success_msg').hide();
    $('#pwd_error_msg').hide();
    $('#change_password_form').on('submit', function(e) {
        e.preventDefault();
        var newPass = $('#new_password').val();
        var confirmPass = $('#pwd_confirm').val();
        if (newPass !== confirmPass) {
            $('#pwd_error_msg').html('<div class="alert alert-danger" style="border-radius:8px;"><i class="fa fa-exclamation-circle mr-1"></i>New password and confirm password do not match.</div>').show();
            return;
        }
        var btn = $('#pwd_submit_btn');
        btn.prop('disabled', true).find('.btn-text').hide();
        btn.find('.btn-loader').show();
        $('#pwd_success_msg').hide();
        $('#pwd_error_msg').hide();

        $.ajax({
            type: 'POST',
            url: '<?= base_url("api/v1/vendor/profile/password") ?>',
            headers: {
                'Authorization': 'Bearer <?= !empty($access_token) ? $access_token : "" ?>'
            },
            data: JSON.stringify({
                new_password: newPass,
                confirm_password: confirmPass
            }),
            contentType: 'application/json',
            dataType: 'json',
            success: function(res) {
                btn.prop('disabled', false).find('.btn-text').show();
                btn.find('.btn-loader').hide();
                if (res && res.status == 1) {
                    $('#pwd_success_msg').html('<div class="alert alert-success" style="border-radius:8px;"><i class="fa fa-check-circle mr-1"></i>' + (res.message || 'Password updated successfully.') + '</div>').show();
                    $('#change_password_form')[0].reset();
                } else {
                    var errMsg = 'Failed to update password.';
                    if (res && res.errors && res.errors.length > 0) {
                        errMsg = res.errors[0];
                    } else if (res && res.message) {
                        errMsg = res.message;
                    }
                    $('#pwd_error_msg').html('<div class="alert alert-danger" style="border-radius:8px;"><i class="fa fa-exclamation-circle mr-1"></i>' + errMsg + '</div>').show();
                }
            },
            error: function(xhr) {
                btn.prop('disabled', false).find('.btn-text').show();
                btn.find('.btn-loader').hide();
                var errMsg = 'Server error. Please try again.';
                if (xhr.responseJSON) {
                    var res = xhr.responseJSON;
                    if (res.errors && res.errors.length > 0) {
                        errMsg = res.errors[0];
                    } else if (res.message) {
                        errMsg = res.message;
                    }
                }
                $('#pwd_error_msg').html('<div class="alert alert-danger" style="border-radius:8px;">' + errMsg + '</div>').show();
            }
        });
    });

});
</script>