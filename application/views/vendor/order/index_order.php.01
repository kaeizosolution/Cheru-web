            </div>
            
        </div>
    </div>
</div>

<!-- Order Detail Modal -->
<div class="modal fade" id="orderDetailModal" tabindex="-1" aria-labelledby="orderDetailModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content" style="border-radius: 16px; border: none; box-shadow: 0 15px 30px rgba(0,0,0,0.15);">
            <div class="modal-header" style="background: linear-gradient(135deg, var(--primary), #818cf8); color: #fff; border-radius: 16px 16px 0 0; border-bottom: none; padding: 20px;">
                <h5 class="modal-title font-weight-bold" id="orderDetailModalLabel" style="font-family: 'Poppins', sans-serif;">
                    <i class="fa fa-file-text-o mr-2"></i> Order Invoice #<span id="mdOrderUid"></span>
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close" style="filter: brightness(0) invert(1);"></button>
            </div>
            <div class="modal-body" style="padding: 25px; max-height: 75vh; overflow-y: auto;">
                <!-- Loader -->
                <div id="orderDetailLoader" class="text-center py-5">
                    <div class="spinner-border text-primary" role="status" style="width: 3rem; height: 3rem;">
                        <span class="visually-hidden">Loading...</span>
                    </div>
                    <p class="mt-3 text-muted">Fetching invoice details...</p>
                </div>

                <!-- Content (Hidden initially) -->
                <div id="orderDetailContent" style="display: none;">
                    <!-- Top section: Order summary & Dates -->
                    <div class="row mb-4">
                        <div class="col-md-6">
                            <h6 class="text-muted text-uppercase small font-weight-bold">Order Information</h6>
                            <p class="mb-1"><strong>Status:</strong> <span class="badge" id="mdStatusBadge" style="padding: 6px 12px; font-size: 12px;"></span></p>
                            <p class="mb-1"><strong>Placed On:</strong> <span id="mdOrderDate"></span></p>
                        </div>
                        <div class="col-md-6 text-md-end">
                            <h6 class="text-muted text-uppercase small font-weight-bold">Payment & Delivery</h6>
                            <p class="mb-1"><strong>Payment Method:</strong> <span id="mdPaymentMethod"></span></p>
                            <p class="mb-1"><strong>Payment Status:</strong> <span id="mdPaymentStatus"></span></p>
                        </div>
                    </div>
                    
                    <hr class="my-3" style="border-color: var(--border-color);">

                    <!-- Customer & Shipping info -->
                    <div class="row mb-4">
                        <div class="col-md-12">
                            <h6 class="text-muted text-uppercase small font-weight-bold"><i class="fa fa-map-marker mr-1"></i> Shipping Address</h6>
                            <div class="p-3 bg-light rounded" style="border-left: 4px solid var(--primary); font-size: 14px;">
                                <p class="mb-1"><strong>Name:</strong> <span id="mdShippingName"></span></p>
                                <p class="mb-1"><strong>Mobile:</strong> <span id="mdShippingMobile"></span></p>
                                <p class="mb-1"><strong>Address:</strong> <span id="mdShippingAddress"></span></p>
                                <p class="mb-1"><strong>City / Postcode:</strong> <span id="mdShippingCity"></span></p>
                            </div>
                        </div>
                    </div>

                    <!-- Items Table -->
                    <h6 class="text-muted text-uppercase small font-weight-bold mb-3"><i class="fa fa-shopping-basket mr-1"></i> Invoice Items</h6>
                    <div class="table-responsive mb-4">
                        <table class="table align-middle" style="font-size: 14px;">
                            <thead class="table-light">
                                <tr>
                                    <th scope="col" style="width: 80px;">Item</th>
                                    <th scope="col">Product Name</th>
                                    <th scope="col" class="text-center">Status</th>
                                    <th scope="col" class="text-end">Price</th>
                                    <th scope="col" class="text-center" style="width: 60px;">Qty</th>
                                    <th scope="col" class="text-end">Total</th>
                                </tr>
                            </thead>
                            <tbody id="mdItemsList">
                                <!-- Dynamic -->
                            </tbody>
                        </table>
                    </div>

                    <!-- Totals Section -->
                    <div class="row justify-content-end">
                        <div class="col-md-5">
                            <div class="d-flex justify-content-between mb-2">
                                <span class="text-muted">Subtotal:</span>
                                <span class="font-weight-bold" id="mdSubtotal"></span>
                            </div>
                            <div class="d-flex justify-content-between mb-2">
                                <span class="text-muted">Shipping:</span>
                                <span class="font-weight-bold" id="mdShipping"></span>
                            </div>
                            <div class="d-flex justify-content-between mb-2">
                                <span class="text-muted">Tax:</span>
                                <span class="font-weight-bold" id="mdTax"></span>
                            </div>
                            <div class="d-flex justify-content-between mb-2" id="mdDiscountRow">
                                <span class="text-muted">Discount:</span>
                                <span class="text-danger font-weight-bold" id="mdDiscount"></span>
                            </div>
                            <hr class="my-2">
                            <div class="d-flex justify-content-between align-items-center">
                                <span class="h6 mb-0 font-weight-bold">Grand Total:</span>
                                <span class="h5 mb-0 text-primary font-weight-bold" id="mdTotal"></span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer" style="border-top: none; padding: 15px 20px;">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal" style="border-radius: 8px;">Close</button>
