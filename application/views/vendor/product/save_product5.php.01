<script>
let productData    = <?= json_encode($product    ?? []) ?>;
let variationData  = <?= json_encode($variations ?? []) ?>;
const categories   = <?= json_encode($categories ?? []) ?>;
let attributes     = <?= json_encode($attributes ?? []) ?>;
let attr_items     = <?= json_encode($attr_items ?? []) ?>;
$(document).ready(function () {

    // ── Build attribute registry ──────────────────────────────────────────

    const attributeRegistry = {};
    attributes.forEach(attr => {
        const options = attr_items
            .filter(item => item.attribute_id == attr.attribute_id)
            .map(item => ({ id: item.attribute_item_id, name: item.name.trim() }));
        if (options.length > 0) {
            attributeRegistry[attr.attribute_id] = { label: attr.name, options };
        }
    });

    // ── Category & Brand API helpers ──────────────────────────────────────
    const API_TOKEN = '<?= isset($access_token) ? htmlspecialchars($access_token, ENT_QUOTES, 'UTF-8') : '' ?>';
    const API_BASE  = '<?= base_url('api/v1/vendor/products') ?>';

    function loadCategories($el, parentId, label, selectedVal, callback) {
        $el.empty().append('<option value="">Loading...</option>').prop('disabled', true);
        $.ajax({
            url: API_BASE + '/categories',
            type: 'POST',
            dataType: 'json',
            headers: API_TOKEN ? { 'Authorization': 'Bearer ' + API_TOKEN } : {},
            data: { parent_id: parentId || 0 },
            success: function(resp) {
                var cats = (resp && resp.data && resp.data.categories) ? resp.data.categories : [];
                $el.empty().append('<option value="">Select ' + label + '</option>');
                if (cats.length > 0) {
                    $el.prop('disabled', false);
                    cats.forEach(function(c) {
                        $el.append($('<option>', { value: c.id, text: (c.name || '').trim() }));
                    });
                    if (selectedVal) { $el.val(String(selectedVal)); }
                } else {
                    $el.prop('disabled', true);
                }
                if (typeof callback === 'function') callback();
            },
            error: function() {
                $el.empty().append('<option value="">Select ' + label + '</option>').prop('disabled', true);
                if (typeof callback === 'function') callback();
            }
        });
    }

    function loadBrandsByCategory(catId, selectedBrandId) {
        var cid = parseInt(catId || 0, 10);
        $('#brand_id').html('<option value="">Loading...</option>').prop('disabled', true);
        var reqData = cid ? { category_id: cid } : {};
        $.ajax({
            url: API_BASE + '/brands',
            type: 'POST',
            dataType: 'json',
            headers: API_TOKEN ? { 'Authorization': 'Bearer ' + API_TOKEN } : {},
            data: reqData,
            success: function(resp){
                var data = (resp && resp.data && resp.data.brands) ? resp.data.brands : [];
                var html = '<option value="">Select Brand</option>';
                if (Array.isArray(data)) {
                    data.forEach(function(b){
                        if (!b) return;
                        html += '<option value="'+b.brand_id+'">'+(b.name || '')+'</option>';
                    });
                }
                $('#brand_id').html(html).prop('disabled', false);
                if (selectedBrandId) {
                    $('#brand_id').val(String(selectedBrandId));
                }
            },
            error: function(){
                $('#brand_id').html('<option value="">Select Brand</option>').prop('disabled', false);
            }
        });
    }

    loadCategories($('#category'), 0, 'Category', null);
    $('#category').on('change', function () {
        var catId = $(this).val();
        $('#subCategory').html('<option value="">Sub Category</option>').prop('disabled', true);
        $('#subSubCategory').html('<option value="">Select Sub-Sub Category</option>').prop('disabled', true);
        if (catId) {
            loadCategories($('#subCategory'), catId, 'Sub Category', null);
            loadBrandsByCategory(catId, null);
        } else {
            loadBrandsByCategory(0, null);
        }
    });
    $('#subCategory').on('change', function () {
        var subCatId = $(this).val();
        $('#subSubCategory').html('<option value="">Select Sub-Sub Category</option>').prop('disabled', true);
        if (subCatId) {
            loadCategories($('#subSubCategory'), subCatId, 'Sub-Sub Category', null);
        }
    });

    // ── Render attribute picker ───────────────────────────────────────────
    function renderAttributes() {
        let html = '';
        attributes.forEach(attr => {
            if (attributeRegistry[attr.attribute_id]) {
                html += `<label class="attr-chip" data-id="${attr.attribute_id}">
                    <input type="checkbox" class="attr-check" value="${attr.attribute_id}" data-label="${attr.name.toUpperCase()}">
                    <i class="fa fa-check" style="font-size:10px; display:none;"></i>
                    ${attr.name}
                </label>`;
            }
        });
        $('#attrList').html(html);
    }
    renderAttributes();

    // Attr chip visual toggle
    $(document).on('change', '.attr-check', function () {
        const $chip = $(this).closest('.attr-chip');
        if ($(this).is(':checked')) {
            $chip.addClass('selected').find('i').show();
        } else {
            $chip.removeClass('selected').find('i').hide();
        }
        if ($('.attr-check:checked').length > 0) {
            $('#variationTable').show();
            $('#noAttrMsg').hide();
            updateTableHeaders();
        } else {
            $('#variationTable').hide();
            $('#noAttrMsg').show();
            $('#varBody').empty();
        }
    });

    $('#attrSearch').on('keyup', function () {
        const val = $(this).val().toLowerCase();
        $('.attr-chip').filter(function () { $(this).toggle($(this).text().toLowerCase().indexOf(val) > -1); });
    });

    // ── Product type toggle ───────────────────────────────────────────────
    $('input[name="product_type"]').on('change', function () {
        $('.type-toggle label').removeClass('active');
        $(this).parent().addClass('active');
        if ($(this).val() === 'variable') {
            $('#attributeSection').show();
            $('#simpleSection').hide();
            $('#global_stock_wrapper').hide();
        } else {
            $('#attributeSection').hide();
            $('#simpleSection').show();
            $('#global_stock_wrapper').show();
        }
    });

    // ── Simple tier add/remove ────────────────────────────────────────────
    $('#addSimpleTier').click(function () {
        $('#simpleTierContainer').append(`
            <div class="tier-row">
                <input type="number" name="simple_min_qty[]" placeholder="Min Qty">
                <span class="tier-sep">|</span>
                <input type="number" name="simple_max_qty[]" placeholder="Max Qty">
                <span class="tier-sep">|</span>
                <input type="number" step="0.01" name="simple_price[]" placeholder="Price">
                <button type="button" class="btn-icon-danger remove-simple-tier"><i class="fa fa-times"></i></button>
            </div>`);
    });
    $(document).on('click', '.remove-simple-tier', function () { $(this).closest('.tier-row').remove(); });

    // ── Variation table ───────────────────────────────────────────────────
    let varRowCount = 0;

    function updateTableHeaders() {
        $('.dyn-h').remove();
        $('.attr-check:checked').each(function () {
            $('#mediaHeader').before(`<th class="dyn-h">${$(this).data('label')}</th>`);
        });
    }

    function addVariationRow(data = null) {
        const selected = $('.attr-check:checked');
        if (selected.length === 0) { alert('Select attributes first'); return; }
        varRowCount++;

        let row = `<tr class="var-row">`;
        selected.each(function () {
            const attrId   = $(this).val();
            const attrData = attributeRegistry[attrId];
            const savedId  = data?.attr?.[attrId] ?? '';
            let sel = `<td><select name="vars[${varRowCount}][attr][${attrId}]" class="form-control form-control-sm">`;
            attrData.options.forEach(opt => {
                const selected = (opt.id == savedId) ? 'selected' : '';
                sel += `<option ${selected} value="${opt.id}">${opt.name}</option>`;
            });
            row += sel + '</select></td>';
        });

        // Media column
        row += `<td>
            <input type="hidden" name="vars[${varRowCount}][variation_id]" value="${data?.id ?? ''}">
            <input type="file" name="variation_images[${varRowCount}][]" multiple accept="image/*" class="form-control-file" style="font-size:12px;">
            <div class="img-thumb-wrap">`;
        if (data?.images) {
            data.images.forEach(img => {
                row += `<div class="img-thumb-item">
                    <img src="<?= base_url('uploads/products/') ?>${img.image_path}" alt="">
                    <button type="button" class="del-img delete-img" data-id="${img.id}">×</button>
                </div>`;
            });
        }
        row += `</div></td>`;

        // Price tiers column
        row += `<td><div id="tier_wrap_${varRowCount}">`;
        if (data?.prices && data.prices.length) {
            data.prices.forEach(p => {
                row += `<div class="tier-row">
                    <input type="number" name="vars[${varRowCount}][min_qty][]" value="${p.min_qty}" placeholder="Min">
                    <span class="tier-sep">|</span>
                    <input type="number" name="vars[${varRowCount}][max_qty][]" value="${p.max_qty}" placeholder="Max">
                    <span class="tier-sep">|</span>
                    <input type="number" step="0.01" name="vars[${varRowCount}][price][]" value="${p.price}" placeholder="Price">
                    <button type="button" class="btn-icon-danger remove-sub-tier"><i class="fa fa-times"></i></button>
                </div>`;
            });
        } else {
            row += `<div class="tier-row">
                <input type="number" name="vars[${varRowCount}][min_qty][]" value="1" placeholder="Min">
                <span class="tier-sep">|</span>
                <input type="number" name="vars[${varRowCount}][max_qty][]" placeholder="Max">
                <span class="tier-sep">|</span>
                <input type="number" step="0.01" name="vars[${varRowCount}][price][]" placeholder="Price">
            </div>`;
        }
        row += `</div>
            <button type="button" class="btn-outline-custom mt-2 add-row-tier" data-id="${varRowCount}" style="font-size:12px; padding:4px 10px;">
                <i class="fa fa-plus"></i> Tier
            </button></td>`;

        // Stock column (only 1 column for 1 variation)
        row += `<td>
            <input type="number" name="vars[${varRowCount}][stock]" value="${data?.stock ?? '1000'}" class="form-control form-control-sm" placeholder="Stock" min="0" style="width:100px;">
        </td>`;

        // Remove column
        row += `<td class="text-center">
            <button type="button" class="btn-icon-danger remove-v" style="padding:7px 10px; border-radius:8px;">
                <i class="fa fa-trash"></i>
            </button></td></tr>`;

        $('#varBody').append(row);
    }

    $('#addVarRow').click(() => addVariationRow());

    $(document).on('click', '.add-row-tier', function () {
        const id = $(this).data('id');
        $(`#tier_wrap_${id}`).append(`<div class="tier-row">
            <input type="number" name="vars[${id}][min_qty][]" placeholder="Min">
            <span class="tier-sep">|</span>
            <input type="number" name="vars[${id}][max_qty][]" placeholder="Max">
            <span class="tier-sep">|</span>
            <input type="number" step="0.01" name="vars[${id}][price][]" placeholder="Price">
            <button type="button" class="btn-icon-danger remove-sub-tier"><i class="fa fa-times"></i></button>
        </div>`);
    });

    $(document).on('click', '.remove-v',        function () { $(this).closest('tr').remove(); });
    $(document).on('click', '.remove-sub-tier', function () { $(this).closest('.tier-row').remove(); });

    // ── Delete existing image ─────────────────────────────────────────────
    $(document).on('click', '.delete-img', function () {
        const id  = $(this).data('id');
        const box = $(this).closest('.img-thumb-item');
        $.post('<?= base_url('vendor/item/delete_image') ?>', { id }, function (res) {
            if (res.status) box.remove();
        }, 'json');
    });

    // ── Video file preview ────────────────────────────────────────────
    $('#productVideoInput').on('change', function () {
        const file = this.files[0];
        if (!file) return;
        const url  = URL.createObjectURL(file);
        $('#videoPreviewSrc').attr('src', url);
        $('#videoPreview')[0].load();
        $('#videoFileName').text(file.name + ' (' + (file.size / 1048576).toFixed(1) + ' MB)');
        $('#videoPreviewWrap').show();
    });

    // ── Remove existing video ─────────────────────────────────────────
    $(document).on('click', '#removeVideoBtn', function () {
        if (!confirm('Are you sure you want to remove this video?')) return;
        const $btn = $(this);
        const pid  = $btn.data('product_id');
        $btn.prop('disabled', true).html('<i class="fa fa-spinner fa-spin"></i> Removing...');
        $.post('<?= base_url('vendor/item/delete_video') ?>', { product_id: pid }, function (res) {
            if (res.status) {
                $('#existingVideoWrap').slideUp(200, function () { $(this).remove(); });
            } else {
                alert(res.msg || 'Failed to remove video.');
                $btn.prop('disabled', false).html('<i class="fa fa-trash"></i> Remove Video');
            }
        }, 'json').fail(function () {
            alert('Server error. Please try again.');
            $btn.prop('disabled', false).html('<i class="fa fa-trash"></i> Remove Video');
        });
    });

    // ── Prefill on edit ───────────────────────────────────────────────────
    function prefillProduct() {
        if (!productData || !productData.id) return;

        $('input[name="product_name"]').val(productData.name);
        $('textarea[name="description"]').val(productData.description);
        $('input[name="product_type"][value="' + productData.product_type + '"]').prop('checked', true).trigger('change');

        // Prefill SKU and Stock
        if (productData.sku)   $('#field_sku').val(productData.sku);
        if (productData.stock !== undefined && productData.stock !== null) $('#field_stock').val(productData.stock);

        // Restore categories via API (chained callbacks to handle async loading)
        if (productData.category) {
            loadCategories($('#category'), 0, 'Category', productData.category, function() {
                loadBrandsByCategory(productData.category, productData.brand_id || null);
                loadCategories($('#subCategory'), productData.category, 'Sub Category', productData.sub_category || null, function() {
                    if (productData.sub_category) {
                        loadCategories($('#subSubCategory'), productData.sub_category, 'Sub-Sub Category', productData.sub_sub_category || null);
                    }
                });
            });
        }

        if (productData.product_type === 'variable') {
            variationData.forEach(v => {
                Object.keys(v.attr || {}).forEach(key => {
                    $(`.attr-check[value="${key}"]`).prop('checked', true).trigger('change');
                });
            });
            updateTableHeaders();
            variationData.forEach(v => addVariationRow(v));
        }

        if (productData.product_type === 'simple' && variationData.length) {
            const v = variationData[0];
            $('#simple_variation_id').val(v.id);
            $('#simpleTierContainer').html('');
            v.prices.forEach(p => {
                $('#simpleTierContainer').append(`<div class="tier-row">
                    <input type="number" name="simple_min_qty[]" value="${p.min_qty}" placeholder="Min">
                    <span class="tier-sep">|</span>
                    <input type="number" name="simple_max_qty[]" value="${p.max_qty}" placeholder="Max">
                    <span class="tier-sep">|</span>
                    <input type="number" step="0.01" name="simple_price[]" value="${p.price}" placeholder="Price">
                    <button type="button" class="btn-icon-danger remove-simple-tier"><i class="fa fa-times"></i></button>
                </div>`);
            });
            if (v.images && v.images.length) {
                v.images.forEach(img => {
                    $('#simpleImgPreview').append(`<div class="img-thumb-item">
                        <img src="<?= base_url('uploads/products/') ?>${img.image_path}" alt="">
                        <button type="button" class="del-img delete-img" data-id="${img.id}">×</button>
                    </div>`);
                });
            }
        }
    }

    const useApi = <?= (isset($use_api) && $use_api) ? 'true' : 'false' ?>;
    const isEdit = <?= $is_edit ? 'true' : 'false' ?>;
    const productId = <?= isset($product->id) ? (int)$product->id : 0 ?>;

    if (useApi && isEdit && productId > 0) {
        $.ajax({
            url: API_BASE + '/get_details',
            type: 'POST',
            dataType: 'json',
            data: { product_id: productId },
            headers: API_TOKEN ? { 'Authorization': 'Bearer ' + API_TOKEN } : {},
            success: function(resp) {
                if (resp && resp.status === 'success' && resp.data) {
                    var apiData = resp.data;
                    productData = {
                        id: apiData.product_id,
                        name: apiData.product_name,
                        description: apiData.description,
                        product_type: apiData.product_type,
                        sku: apiData.sku,
                        stock: apiData.stock,
                        category: apiData.category_id,
                        sub_category: apiData.sub_category_id,
                        sub_sub_category: apiData.sub_sub_category_id,
                        brand_id: apiData.brand_id
                    };
                    
                    variationData = [];
                    if (apiData.product_type === 'simple') {
                        var prices_mapped = [];
                        if (apiData.price_tiers) {
                            apiData.price_tiers.forEach(function(p) {
                                prices_mapped.push({
                                    id: p.price_id || 0,
                                    min_qty: p.min_qty,
                                    max_qty: p.max_qty,
                                    price: p.price
                                });
                            });
                        }
                        var images_mapped = [];
                        if (apiData.images) {
                            apiData.images.forEach(function(img) {
                                images_mapped.push({
                                    id: img.id,
                                    image_path: img.image_path
                                });
                            });
                        }
                        variationData.push({
                            id: $('#simple_variation_id').val() || 0,
                            prices: prices_mapped,
                            images: images_mapped
                        });
                    } else if (apiData.variations) {
                        apiData.variations.forEach(function(v) {
                            var prices_mapped = [];
                            if (v.price_tiers) {
                                v.price_tiers.forEach(function(p) {
                                    prices_mapped.push({
                                        id: p.price_id || 0,
                                        min_qty: p.min_qty,
                                        max_qty: p.max_qty,
                                        price: p.price
                                    });
                                });
                            }
                            var images_mapped = [];
                            if (v.images) {
                                v.images.forEach(function(img) {
                                    images_mapped.push({
                                        id: img.id,
                                        image_path: img.image_path
                                    });
                                });
                            }
                            variationData.push({
                                id: v.variation_id,
                                attr: v.attr,
                                prices: prices_mapped,
                                images: images_mapped,
                                stock: v.stock
                            });
                        });
                    }

                    prefillProduct();
                    
                    if ($('.attr-check:checked').length > 0) {
                        $('#variationTable').show();
                        $('#noAttrMsg').hide();
                    }
                } else {
                    prefillProduct();
                    if ($('.attr-check:checked').length > 0) {
                        $('#variationTable').show();
                        $('#noAttrMsg').hide();
                    }
                }
            },
            error: function() {
                prefillProduct();
                if ($('.attr-check:checked').length > 0) {
                    $('#variationTable').show();
                    $('#noAttrMsg').hide();
                }
            }
        });
    } else {
        prefillProduct();
        if ($('.attr-check:checked').length > 0) {
            $('#variationTable').show();
            $('#noAttrMsg').hide();
        }
    }

    // ── Form submit ───────────────────────────────────────────────────────
    $('#productForm').on('submit', function (e) {
        e.preventDefault();
        const $btn = $('#saveBtn');
        $btn.prop('disabled', true).html('<i class="fa fa-spinner fa-spin mr-1"></i> Saving...');

        const useApi = <?= (isset($use_api) && $use_api) ? 'true' : 'false' ?>;
        const productId = parseInt($('input[name="product_id"]').val()) || 0;
        let url;
        if (useApi) {
            if (<?= $is_edit ? 'true' : 'false' ?> && productId > 0) {
                url = '<?= base_url("api/v1/vendor/products/update") ?>';
            } else {
                url = '<?= base_url("api/v1/vendor/products/add") ?>';
            }
        } else {
            url = '<?= base_url("vendor/item/save_product") ?>';
        }
        const headers = useApi 
            ? { 'Authorization': 'Bearer <?= isset($access_token) ? $access_token : "" ?>' } 
            : {};

        $.ajax({
            url: url,
            type: 'POST',
            headers: headers,
            data: new FormData(this),
            processData: false,
            contentType: false,
            dataType: 'json',
            success: function (res) {
                if (res.STATUS || res.status) {
                    // Redirect to product listing on success
                    window.location.href = '<?= base_url("{$TYPE}/product") ?>';
                } else {
                    var errMsg = res.MSG || res.msg || res.message || 'Something went wrong.';
                    if (res.errors && res.errors.length > 0) {
                        errMsg = res.errors[0];
                    }
                    alert(errMsg);
                    $btn.prop('disabled', false).html('<?= $is_edit ? '<i class="fa fa-check mr-1"></i> Update Product' : '<i class="fa fa-check mr-1"></i> Publish Product' ?>');
                }
            },
            error: function (xhr) {
                var errMsg = 'Server error. Please try again.';
                if (xhr.responseText) {
                    try {
                        var res = JSON.parse(xhr.responseText);
                        errMsg = (res.errors && res.errors.length > 0) ? res.errors[0] : (res.message || errMsg);
                    } catch(e) {}
                }
                alert(errMsg);
                $btn.prop('disabled', false).html('<?= $is_edit ? '<i class="fa fa-check mr-1"></i> Update Product' : '<i class="fa fa-check mr-1"></i> Publish Product' ?>');
            }
        });
    });

});
</script>
