        color: var(--dark);
        -webkit-appearance: auto;
        -moz-appearance: auto;
        appearance: auto;
    }

    #variationTable td {
        white-space: nowrap;
    }

    /* Img preview */
    .img-thumb-wrap { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 8px; }
    .img-thumb-item { position: relative; width: 56px; height: 56px; }
    .img-thumb-item img { width: 100%; height: 100%; object-fit: cover; border-radius: 6px; border: 1px solid var(--border-color); }
    .img-thumb-item .del-img { position: absolute; top: -6px; right: -6px; background: #ef4444; color: #fff; border: none; border-radius: 50%; width: 18px; height: 18px; font-size: 10px; cursor: pointer; display: flex; align-items: center; justify-content: center; }

    /* Action buttons */
    .btn-primary-custom {
        background: var(--primary);
        color: #fff;
        border: none;
        border-radius: 8px;
        padding: 10px 28px;
        font-weight: 600;
        font-size: 14px;
        box-shadow: 0 4px 12px rgba(99, 102, 241, 0.3);
        transition: all 0.2s;
        cursor: pointer;
    }
    .btn-primary-custom:hover { background: #4f46e5; transform: translateY(-1px); }

    .btn-outline-custom {
        background: transparent;
        color: var(--primary);
        border: 1.5px solid var(--primary);
        border-radius: 8px;
        padding: 7px 18px;
        font-weight: 600;
        font-size: 13px;
        cursor: pointer;
        transition: all 0.2s;
    }
    .btn-outline-custom:hover { background: var(--primary); color: #fff; }

    .btn-icon-danger {
        background: rgba(239, 68, 68, 0.1);
        color: #ef4444;
        border: none;
        border-radius: 6px;
        padding: 5px 9px;
        font-size: 12px;
        cursor: pointer;
        transition: all 0.2s;
    }
    .btn-icon-danger:hover { background: #ef4444; color: #fff; }

    .section-icon { color: var(--primary); margin-right: 8px; }

    /* Video upload */
    .video-upload-zone {
        border: 2px dashed var(--border-color);
        border-radius: 12px;
        padding: 24px;
        text-align: center;
        background: #fafbff;
        cursor: pointer;
        transition: border-color 0.2s, background 0.2s;
        position: relative;
    }
    .video-upload-zone:hover {
        border-color: var(--primary);
        background: #f5f3ff;
    }
    .video-upload-zone .upload-icon {
        font-size: 36px;
        color: var(--primary);
        margin-bottom: 8px;
    }
    .video-upload-zone p {
        font-size: 13px;
        color: #94a3b8;
        margin: 0;
    }
    .video-upload-zone input[type="file"] {
        position: absolute;
        inset: 0;
        opacity: 0;
        cursor: pointer;
        width: 100%;
        height: 100%;
    }
    #videoPreviewWrap {
        margin-top: 16px;
        display: none;
    }
    #videoPreviewWrap video {
        width: 100%;
        max-height: 300px;
        border-radius: 10px;
        border: 1px solid var(--border-color);
        background: #000;
    }
    .video-badge {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        background: #f0fdf4;
        border: 1px solid #86efac;
        border-radius: 8px;
        padding: 6px 14px;
        font-size: 13px;
        color: #16a34a;
        font-weight: 600;
        margin-bottom: 10px;
    }
    .video-badge i { font-size: 15px; }
</style>

