  <div class="body_content_wrapper position-relative pt30"> 
<script>
// Global variables for cart functionality
var base_url = '<?= base_url(); ?>';
var site_url = '<?= site_url(); ?>';
var csrf_token_name = '<?= $this->security->get_csrf_token_name(); ?>';
var csrf_hash = '<?= $this->security->get_csrf_hash(); ?>';
var currency_symbol = '<?= $symbol ?? '$'; ?>';

window.csrf_token_name = csrf_token_name;
window.csrf_hash = csrf_hash;
window.site_url = site_url;

// Expose currency_symbol to JS
window.currency_symbol = currency_symbol;
window.currentCurrencySymbol = "<?= addslashes(html_entity_decode((string)$symbol)) ?>";
window.currentCurrencyRate   = <?= (float)$rate ?>;
window.currentCurrencyId     = <?= (int)($_hdr_cur ? $_hdr_cur->currency_id : 1) ?>;
window.freeShippingThreshold = 9800;
window.shippingFee           = 50;

window.customer_access_token = '<?= isset($this->session) && is_array($this->session->userdata('customer')) && !empty($this->session->userdata('customer')['access_token']) ? $this->session->userdata('customer')['access_token'] : '' ?>';
window.__cheru_cart_use_api__ = true;

(function(){
    function whenJqueryReady(fn){
        if (window.jQuery) {
            fn(window.jQuery);
            return;
        }
        var attempts = 0;
        var maxAttempts = 50;
        var timer = setInterval(function(){
            attempts++;
            if (window.jQuery) {
                clearInterval(timer);
                fn(window.jQuery);
            } else if (attempts >= maxAttempts) {
                clearInterval(timer);
            }
        }, 100);
    }

    function debounce(fn, wait) {
        var t;
        return function() {
            var ctx = this, args = arguments;
            clearTimeout(t);
            t = setTimeout(function(){ fn.apply(ctx, args); }, wait);
        };
    }

    function renderSuggestions($box, data, selectedCategory, term) {
        var $ul = $box.find('ul');
        if (!$ul.length) return;
        $ul.empty();

        var items = [];
        if (data && data.data) {
            if (data.data.products && data.data.products.length) {
                data.data.products.forEach(function(p){ items.push({type:'product', title:p.name, url:p.url, price:p.price || '', image:p.image_url || ''}); });
            }
        }

        if (!items.length) {
            var msg = selectedCategory ? "No product found in this category." : "No product found.";
            $ul.append('<li style="padding:15px;text-align:center;color:#666;list-style:none;">' + msg + '</li>');
            $box.addClass('show').css('display', 'block');
            return;
        }

        items.forEach(function(it){
            var thumb = it.image ? '<div class="thumb"><img src="' + it.image + '" alt=""></div>' : '<div class="thumb"><img src="' + base_url + 'assets/default_images/product.jpg" alt=""></div>';
            var right = '';
            if (it.type === 'product' && it.price !== '') {
                right = '<div class="price"><span class="sale">' + currency_symbol + it.price + '</span></div>';
            }
            var li = '';
            li += '<li>';
            li += '<a href="' + it.url + '" class="header-search-suggestion" style="display:flex; align-items:center; gap:10px;">';
            li += thumb;
            li += '<div class="info-product">';
            li += '<div class="item_title">' + $('<div/>').text(it.title).html() + '</div>';
            li += right;
            li += '</div>';
            li += '</a>';
            li += '</li>';
            $ul.append(li);
        });

        // "View all results" button
        if (term) {
            var viewAllUrl = base_url + 'shop/' + encodeURIComponent(term);
            if (selectedCategory) { viewAllUrl += '?cat=' + encodeURIComponent(selectedCategory); }
            var viewAllLi = '<li class="search-view-all-li" style="border-top:1px solid #eee;list-style:none;">';
            viewAllLi += '<a href="' + viewAllUrl + '" class="search-view-all-btn" style="display:block;text-align:center;padding:11px 15px;font-size:13px;font-weight:600;color:#6366f1;text-decoration:none;letter-spacing:.2px;">View all results for &ldquo;' + $('<div/>').text(term).html() + '&rdquo; &rarr;</a>';
            viewAllLi += '</li>';
            $ul.append(viewAllLi);
        }

        $box.addClass('show').css('display', 'block');
    }

    function setupHeaderSearch(inputSelector, suggestionsSelector) {
        var $input = $(inputSelector);
        var $suggestions = $(suggestionsSelector);
        if (!$input.length || !$suggestions.length) return;

        function initHeaderCategoryDropdown(){
            var $cat = $('#selectbox_alCategory');
            if(!$cat.length) return;

            var apiUrl = base_url + 'api/v1/homepage/categories';

            $.ajax({
                url: apiUrl,
                type: 'GET',
                dataType: 'json'
            }).done(function(json){
                if (!json || json.status !== 1 || !json.data || !Array.isArray(json.data.categories)) {
                    return;
                }
                var categories = json.data.categories;
                if (!categories.length) {
                    return;
                }
                $cat.find('option').not('[value="AllCategory"]').remove();
                categories.forEach(function(c){
                    if(!c || !c.slug) return;
                    var opt = $('<option/>').attr('value', String(c.slug)).text(String(c.name || c.slug));
                    $cat.append(opt);
                });
                if (typeof $cat.selectpicker === 'function') {
                    $cat.selectpicker('refresh');
                }
            });
        }

        function getSelectedCategorySlug(){
            var $cat = $('#selectbox_alCategory');
            if(!$cat.length) return '';
            var val = ($cat.val() || '').toString();
            if(val === 'AllCategory') return '';
            return val;
        }

        var fetchSuggestions = debounce(function(){
            var term = ($input.val() || '').trim();
            if (term.length < 2) {
                $suggestions.hide();
                return;
            }

            var cat = getSelectedCategorySlug();
            var postData = { term: term, category_slug: cat };
            postData[csrf_token_name] = csrf_hash;

            $.ajax({
                url: base_url + 'api/v1/homepage/smart-search',
                type: 'POST',
                dataType: 'json',
                data: postData
            }).done(function(resp){
                if (resp && resp.csrf_hash) {
                    csrf_hash = resp.csrf_hash;
                }
                renderSuggestions($suggestions, resp, cat, term);
            }).fail(function(){
                $suggestions.removeClass('show').css('display', 'none');
            });
        }, 250);

        $input.on('input', fetchSuggestions);

        $input.on('focus', function(){
            if ($suggestions.find('li').length) $suggestions.addClass('show').css('display', 'block');
        });

        $(document).on('click', function(e){
            if ($(e.target).closest($suggestions).length) return;
            if ($(e.target).closest($input).length) return;
            $suggestions.removeClass('show').css('display', 'none');
        });

        $input.closest('form.header-search-form').on('submit', function(e){
            e.preventDefault();
            var term = ($input.val() || '').trim();
            if (!term) return;
            var cat = getSelectedCategorySlug();

            if(!cat){
                cat = (term || '').toString().toLowerCase().trim().replace(/\s+/g, '-');
            }
            var url = base_url + 'shop/' + encodeURIComponent(term);
            if(cat){
                url += '?cat=' + encodeURIComponent(cat);
            }
            window.location.href = url;
        });

        initHeaderCategoryDropdown();
    }

    whenJqueryReady(function($){
        $(function(){
            setupHeaderSearch('#headerSearchInput', '#headerSearchSuggestions');
            setupHeaderSearch('#mobileHeaderSearchInput', '#mobileHeaderSearchSuggestions');

            $(document).on('click', '.search-btn', function(e){
                e.preventDefault();
                var $scope = $(this).closest('.header_middle_advnc_search');
                var $form = $scope.find('form.header-search-form').first();
                if($form.length){
                    $form.trigger('submit');
                }
            });
        });
    });
})();

function openCartSidebar() {
    $('body').addClass('cart-hidden-sidebar-content');
    $('body').addClass('cart-open');
}

function closeCartSidebar() {
    $('body').removeClass('cart-hidden-sidebar-content');
    $('.cart-hidden-sbar').removeClass('active');
    $('body').removeClass('cart-open');
}

function fmtMoney(n){
    var x = Number(n || 0);
    if (isNaN(x)) x = 0;
    x = x * (parseFloat(window.currentCurrencyRate) || 1.0);
    return (window.currentCurrencySymbol || window.currency_symbol || '$') + x.toFixed(2);
}

function parseMoneyNumber(v){
    if (typeof v === 'number') {
        return isNaN(v) ? 0 : v;
    }
    if (v === null || typeof v === 'undefined') {
        return 0;
    }
    var s = String(v);
    s = s.replace(/[^0-9.\-]/g, '');
    var n = parseFloat(s);
    return isNaN(n) ? 0 : n;
}

function normalizeAttrForPost(attr) {
    if (!attr) return '';
    if (Array.isArray(attr)) return JSON.stringify(attr);
    if (typeof attr === 'string') return attr;
    try { return JSON.stringify(attr); } catch(e) { return ''; }
}

function renderCartSidebar(payload) {
    var items = payload.cart_items || [];
    var summary = payload.cart_summary || {};
    var $list = $('.cart-list-vertical');
    var symbol = (typeof window.currency_symbol !== 'undefined') ? window.currency_symbol : '$';
    var freeShippingThreshold = 9800;

    // Keep header counts in sync with payload
    if (typeof payload.cart_count !== 'undefined') {
        $('[id="cart_count"]').text(payload.cart_count || 0);
    }
    if (typeof payload.cart_qty !== 'undefined') {
        $('[id="cart_qty_count"]').text(payload.cart_qty || 0);
    }

    if (!Array.isArray(items) || items.length === 0) {
        $list.html('<li class="text-center p-5">Your cart is empty</li>');
        $('#cartSidebarFooter').hide();
        $('[id="side_total"]').text(fmtMoney(0));
        $('[id="cart_total"]').text(fmtMoney(0));
        return;
    }

    var html = '';
    items.forEach(function(it){
        var attr = it.attribute_item_id || '';
        var attrKey = normalizeAttrForPost(attr);
        var img = it.image_url || '<?= base_url('assets/customer/images/shop/s1.png'); ?>';
        var qty = Number(it.quantity || 1);
        var unit = Number(it.sale_price || 0);
        var total = Number(it.total || (unit * qty));
        var vid = Number(it.variation_id || 0);
        var attrsText = (it.attributes || '').toString().trim();
        html += `
            <li class="cart-item-row" data-product_id="${it.product_id}" data-variation_id="${vid}">
                <div class="cart-img-wrap">
                    <img src="${img}" onerror="this.src='<?= base_url('assets/customer/images/shop/s1.png'); ?>'" alt="product">
                </div>
                <div class="cart-details">
                    <span class="remove-item btn-delete" data-product_id="${it.product_id}" data-variation_id="${vid}" data-attribute_item_id='${attrKey}'>
                        <i class="flaticon-close"></i>
                    </span>
                    <p>${(it.post_title || '').toString()}</p>
                    ${attrsText ? `<div class="cart-variant-line" style="margin-top:4px;"><span class="cart-variant-label" style="font-weight:700;color:#222;">Selected variant:</span><span class="cart-variant-value" style="display:inline-block;font-weight:700;color:#111;background:#fff3cd;border:1px solid #ffeeba;padding:2px 6px;border-radius:4px;margin-left:6px;">${attrsText}</span></div>` : ``}
                    <div class="qty-price-wrap">
                        <div class="quantity-block numbering">
                            <button class="quantity_update minus" data-product_id="${it.product_id}" data-variation_id="${vid}" data-attribute_item_id='${attrKey}'> - </button>
                            <input class="quantity-num qty_update" type="text" value="${qty}" data-product_id="${it.product_id}" data-variation_id="${vid}" data-attribute_item_id='${attrKey}' readonly>
                            <button class="quantity_update plus" data-product_id="${it.product_id}" data-variation_id="${vid}" data-attribute_item_id='${attrKey}'> + </button>
                        </div>
                        <span class="price item-price" data-unit-price="${unit}" data-total="${total}">${fmtMoney(total)}</span>
                        <span class="unit-price" style="display:none;">${unit}</span>
                    </div>
                </div>
            </li>
        `;
    });

    $list.html(html);
    $('#cartSidebarFooter').show();

    var grand = parseMoneyNumber(summary.grand_total ?? summary.total ?? 0);
    $('[id="side_total"]').text(fmtMoney(grand));
    $('[id="cart_total"]').text(fmtMoney(grand));

    var subtotal = parseMoneyNumber(summary.subtotal ?? summary.total ?? 0);
    var progress = subtotal >= freeShippingThreshold ? 100 : Math.min(100, (subtotal / freeShippingThreshold) * 100);
    $('#cartProgressBar').css('width', progress + '%').attr('aria-valuenow', progress);
    var _rate = parseFloat(window.currentCurrencyRate) || 1.0;
    var _remaining = (freeShippingThreshold - subtotal) * _rate;
    var shippingMsg = subtotal < freeShippingThreshold
        ? 'Buy ' + symbol + _remaining.toFixed(2) + ' more for FREE Shipping'
        : 'You have FREE Shipping!';
    $('#cartShippingMsg').text(shippingMsg);
}

function refreshHeaderAndSidebarCart(opts) {
    opts = opts || {};
    if (!window.jQuery) return;

    // Avoid double fetches when multiple click handlers fire
    if (window.__cheru_cart_refresh_inflight__) {
        return window.__cheru_cart_refresh_inflight__;
    }

    var token = (typeof window.customer_access_token !== 'undefined') ? String(window.customer_access_token || '') : '';
    var forceApi = (typeof window.__cheru_cart_use_api__ !== 'undefined' && window.__cheru_cart_use_api__) || (typeof window.__cheru_cart_api_mode__ !== 'undefined' && window.__cheru_cart_api_mode__);
    if (token || forceApi) {
        var headers = {};
        if (token) {
            headers['Authorization'] = 'Bearer ' + token;
        }
        window.__cheru_cart_refresh_inflight__ = $.ajax({
            url: base_url + 'api/v1/cart',
            type: 'GET',
            dataType: 'json',
            headers: headers,
            success: function(resp){
                if (resp && resp.csrf_hash) {
                    csrf_hash = resp.csrf_hash;
                    window.csrf_hash = resp.csrf_hash;
                }
                if (resp && resp.csrf_token_name) {
                    csrf_token_name = resp.csrf_token_name;
                    window.csrf_token_name = resp.csrf_token_name;
                }
                var STATUS = (typeof resp.STATUS !== 'undefined') ? resp.STATUS : resp.status;
                var apiData = (typeof resp.DATA !== 'undefined') ? resp.DATA : resp.data;
                if (STATUS !== 1 || !apiData) return;

                var items = Array.isArray(apiData.items) ? apiData.items : [];
                var totalQty = 0;
                for (var i = 0; i < items.length; i++) {
                    totalQty += parseInt(items[i].quantity || 0, 10) || 0;
                }
                var grand = parseMoneyNumber(apiData.final_total ?? apiData.grand_total ?? apiData.cart_total ?? 0);
                var sub = parseMoneyNumber(apiData.subtotal ?? apiData.cart_total ?? 0);

                var DATA = {
                    cart_items: items.map(function(it){
                        return {
                            product_id: it.product_id,
                            variation_id: it.variation_id || 0,
                            attribute_item_id: it.attribute_item_id || '',
                            post_title: it.product_name || it.post_title || '',
                            image_url: it.image_url || '',
                            quantity: it.quantity || 1,
                            sale_price: it.price || it.sale_price || 0,
                            total: (parseMoneyNumber(it.price || it.sale_price || 0) * (parseInt(it.quantity || 0, 10) || 0)),
                            attributes: it.attributes || ''
                        };
                    }),
                    cart_summary: {
                        subtotal: sub,
                        shipping: parseMoneyNumber(apiData.shipping ?? 0),
                        grand_total: grand,
                        total: grand
                    },
                    cart_count: items.length,
                    cart_qty: totalQty,
                    cart_total: grand
                };

                renderCartSidebar(DATA);

                if (opts.open === true) {
                    openCartSidebar();
                }
            },
            complete: function(){
                window.__cheru_cart_refresh_inflight__ = null;
            }
        });
        return window.__cheru_cart_refresh_inflight__;
    }

    var postData = {};
    postData[csrf_token_name] = csrf_hash;

    window.__cheru_cart_refresh_inflight__ = $.ajax({
        url: base_url + 'customer/cart/ajax_cart_payload',
        type: 'POST',
        dataType: 'json',
        data: postData,
        success: function(resp){
            try {
                if (resp && resp.csrf_hash) {
                    csrf_hash = resp.csrf_hash;
                    window.csrf_hash = resp.csrf_hash;
                }
                if (resp && resp.csrf_token_name) {
                    csrf_token_name = resp.csrf_token_name;
                    window.csrf_token_name = resp.csrf_token_name;
                }
            } catch (e) {}
            var STATUS = (typeof resp.STATUS !== 'undefined') ? resp.STATUS : resp.status;
            var DATA = (typeof resp.DATA !== 'undefined') ? resp.DATA : resp.data;
            if (STATUS !== 1 || !DATA) return;

            renderCartSidebar(DATA);

            if (typeof DATA.cart_count !== 'undefined') {
                $('[id="cart_count"]').text(DATA.cart_count);
            }
            if (typeof DATA.cart_qty !== 'undefined') {
                $('[id="cart_qty_count"]').text(DATA.cart_qty || 0);
            }
            if (typeof DATA.cart_total !== 'undefined') {
                $('[id="cart_total"]').text(fmtMoney(DATA.cart_total));
                $('[id="side_total"]').text(fmtMoney(DATA.cart_total));
            }

            var freeShippingThreshold = 9800;
            var summary = DATA.cart_summary || {};
            var symbol = (typeof window.currency_symbol !== 'undefined') ? window.currency_symbol : '$';
            var subtotal = parseMoneyNumber(summary.subtotal ?? summary.total ?? 0);
            var progress = subtotal >= freeShippingThreshold ? 100 : Math.min(100, (subtotal / freeShippingThreshold) * 100);
            $('#cartProgressBar').css('width', progress + '%').attr('aria-valuenow', progress);
            var _rate = parseFloat(window.currentCurrencyRate) || 1.0;
            var _remaining = (freeShippingThreshold - subtotal) * _rate;
            var shippingMsg = subtotal < freeShippingThreshold
                ? 'Buy ' + symbol + _remaining.toFixed(2) + ' more for FREE Shipping'
                : 'You have FREE Shipping!';
            $('#cartShippingMsg').text(shippingMsg);

            if (opts.open === true) {
                openCartSidebar();
            }
        },
        complete: function(){
            window.__cheru_cart_refresh_inflight__ = null;
        }
    });
	return window.__cheru_cart_refresh_inflight__;
}

// Backward compatible alias
function refreshSidebar() {
    return refreshHeaderAndSidebarCart({ open: false });
}

function waitForJq(cb){
    if(window.jQuery) return cb();
    setTimeout(function(){ waitForJq(cb); }, 50);
}

waitForJq(function(){
    	// Open/close cart sidebar
	$(document).on('click', '.cart-filter-btn', function(e){
	    e.preventDefault();
	    window.__cheru_cart_sidebar_click_bound__ = true;
	    refreshHeaderAndSidebarCart({ open: true });
	});
	$(document).off('click.cheruHeaderCartSidebarQty', '.cart-hidden-sbar .quantity_update').on('click.cheruHeaderCartSidebarQty', '.cart-hidden-sbar .quantity_update', function(e){
	    e.preventDefault();
	    if (!window.jQuery) return;
	    var $btn = $(this);
	    var action = $btn.hasClass('plus') ? 'increase' : 'decrease';
	    var $input = $btn.closest('.quantity-block').find('input.qty_update').first();
	    var productId = parseInt($btn.data('product_id') || $input.data('product_id') || 0, 10) || 0;
	    var variationId = parseInt($btn.data('variation_id') || $input.data('variation_id') || 0, 10) || 0;
	    var attributeItemId = $btn.data('attribute_item_id') || $input.data('attribute_item_id') || '';
	    var currentQty = parseInt($input.val() || 1, 10) || 1;
	    var nextQty = action === 'increase' ? (currentQty + 1) : Math.max(1, currentQty - 1);
	    var token = (typeof window.customer_access_token !== 'undefined') ? String(window.customer_access_token || '') : '';
	    var forceApi = (typeof window.__cheru_cart_use_api__ !== 'undefined' && window.__cheru_cart_use_api__) || (typeof window.__cheru_cart_api_mode__ !== 'undefined' && window.__cheru_cart_api_mode__);
	    if (token || forceApi) {
	        var payload = {
	            product_id: productId,
	            variation_id: variationId,
	            attribute_item: attributeItemId,
	            quantity: nextQty
	        };
	        if (!token && typeof window.csrf_token_name !== 'undefined' && typeof window.csrf_hash !== 'undefined') {
	            payload[window.csrf_token_name] = window.csrf_hash;
	        }
	        $.ajax({
	            url: base_url + 'api/v1/cart/update',
	            type: 'POST',
	            dataType: 'json',
	            headers: token ? { 'Authorization': 'Bearer ' + token } : {},
	            contentType: 'application/json; charset=utf-8',
	            data: JSON.stringify(payload),
	            success: function(resp){
	                if (resp && resp.csrf_hash) { window.csrf_hash = resp.csrf_hash; csrf_hash = resp.csrf_hash; }
	                if (resp && resp.csrf_token_name) { window.csrf_token_name = resp.csrf_token_name; csrf_token_name = resp.csrf_token_name; }
	                refreshHeaderAndSidebarCart({ open: true });
	                if ($('.shopping_cart_table').length > 0 && typeof window.refreshCartDetail === 'function') {
	                    window.refreshCartDetail();
	                }
	            }
	        });
	        return;
	    }
	});
	$(document).off('click.cheruHeaderCartSidebarRemove', '.cart-hidden-sbar .btn-delete').on('click.cheruHeaderCartSidebarRemove', '.cart-hidden-sbar .btn-delete', function(e){
	    e.preventDefault();
	    if (!window.jQuery) return;
	    var $btn = $(this);
	    var productId = parseInt($btn.data('product_id') || 0, 10) || 0;
	    var variationId = parseInt($btn.data('variation_id') || 0, 10) || 0;
	    var attributeItemId = $btn.data('attribute_item_id') || '';
	    var token = (typeof window.customer_access_token !== 'undefined') ? String(window.customer_access_token || '') : '';
	    var forceApi = (typeof window.__cheru_cart_use_api__ !== 'undefined' && window.__cheru_cart_use_api__) || (typeof window.__cheru_cart_api_mode__ !== 'undefined' && window.__cheru_cart_api_mode__);
	    if (token || forceApi) {
	        var payload = {
	            product_id: productId,
	            variation_id: variationId,
	            attribute_item: attributeItemId
	        };
	        if (!token && typeof window.csrf_token_name !== 'undefined' && typeof window.csrf_hash !== 'undefined') {
	            payload[window.csrf_token_name] = window.csrf_hash;
	        }
	        $.ajax({
	            url: base_url + 'api/v1/cart/remove',
	            type: 'POST',
	            dataType: 'json',
	            headers: token ? { 'Authorization': 'Bearer ' + token } : {},
	            data: payload,
	            success: function(resp){
	                if (resp && resp.csrf_hash) { window.csrf_hash = resp.csrf_hash; csrf_hash = resp.csrf_hash; }
	                if (resp && resp.csrf_token_name) { window.csrf_token_name = resp.csrf_token_name; csrf_token_name = resp.csrf_token_name; }
	                refreshHeaderAndSidebarCart({ open: true });
	                if ($('.shopping_cart_table').length > 0 && typeof window.refreshCartDetail === 'function') {
	                    window.refreshCartDetail();
	                }
	            }
	        });
	        return;
	    }
	});
    $(document).on('click', '.sidebar-close-icon, .hiddenbar-body-ovelay, .cart-overlay', function(){
        closeCartSidebar();
    });

    // Auto-refresh cart count badge + sidebar on every page load
    // so the cart is always up-to-date without needing a click first.
    if (!window.__cheru_cart_autoloaded__) {
        window.__cheru_cart_autoloaded__ = true;
        refreshHeaderAndSidebarCart();
    }

});

if (typeof window.refreshCheckoutSummary === 'undefined') {
    window.refreshCheckoutSummary = function(){
        if (typeof window.loadCheckoutSummary === 'function') {
            window.loadCheckoutSummary();
        }
    };
}

// Browse Categories: parent categories are rendered server-side for now
</script>

<script>
  (function () {
      var apiBase = "<?= base_url('api/v1/homepage/categories'); ?>";
      var dropdown = document.getElementById('bcDropdown');
      var menu = document.getElementById('bcMenu');
      var panel = document.getElementById('bcRightPanel');
      var panel2 = document.getElementById('bcRightPanel2');
      if (!menu) {
          return;
      }

      function safeText(v) {
          return (v === null || v === undefined) ? '' : String(v);
      }

      function categoryUrl(slug) {
          return "<?= base_url('products/category/'); ?>" + encodeURIComponent(safeText(slug));
      }

      function fetchCategories(parentId) {
          var url = apiBase;
          if (parentId !== null && parentId !== undefined) {
              url += '?parent_id=' + encodeURIComponent(parentId);
          }
          return fetch(url, { credentials: 'same-origin' })
              .then(function (r) { return r.json(); })
              .then(function (json) {
                  if (!json || json.status !== 1 || !json.data || !json.data.categories) {
                      return [];
                  }
                  return json.data.categories;
              })
              .catch(function () { return []; });
      }

      function renderParents(parents) {
          if (!parents || !parents.length) {
              return;
          }
          while (menu.firstChild) {
              menu.removeChild(menu.firstChild);
          }
          for (var i = 0; i < parents.length; i++) {
              var c = parents[i] || {};
              var li = document.createElement('li');
              var a = document.createElement('a');
              a.className = 'dropdown';
              a.href = categoryUrl(c.slug);
              a.setAttribute('data-bc-id', safeText(c.id));
              a.setAttribute('data-bc-slug', safeText(c.slug));
              a.setAttribute('data-bc-has-children', c.has_children ? '1' : '0');
              var icn = document.createElement('span');
              icn.className = 'menu-icn flaticon-diamond';
              var title = document.createElement('span');
              title.className = 'menu-title';
              title.textContent = safeText(c.name);
              a.appendChild(icn);
              a.appendChild(title);
              li.appendChild(a);
              menu.appendChild(li);
          }
      }

      function hidePanel() {
          if (panel) {
              panel.style.display = 'none';
              panel.innerHTML = '';
          }
          if (panel2) {
              panel2.style.display = 'none';
              panel2.innerHTML = '';
          }
      }

      function hidePanel2() {
          if (panel2) {
              panel2.style.display = 'none';
              panel2.innerHTML = '';
          }
      }

      function positionPanelTo(targetPanel, sourceEl, clampToViewportBottom) {
          if (!targetPanel || !sourceEl || !targetPanel.parentNode) {
              return;
          }
          try {
              var parentRect = targetPanel.parentNode.getBoundingClientRect();
              var srcRect = sourceEl.getBoundingClientRect();
              var ph = targetPanel.offsetHeight || 0;
              var top;
              // Prefer offset-based math (more stable when sourceEl is inside absolute panels)
              if (menu && menu.contains(sourceEl)) {
                  top = sourceEl.offsetTop;
              } else if (panel && panel.contains(sourceEl)) {
                  top = (panel.offsetTop || 0) + (sourceEl.offsetTop || 0);
              } else if (panel2 && panel2.contains(sourceEl)) {
                  top = (panel2.offsetTop || 0) + (sourceEl.offsetTop || 0);
              } else {
                  top = (srcRect.top - parentRect.top);
              }
              if (top < 0) {
                  top = 0;
              }

              if (clampToViewportBottom) {
                  // Clamp to viewport bottom so level-2 doesn't overflow.
                  // NOTE: we do NOT use this for level-3 because it can make it "snap" to the top.
                  var viewportH = (document.documentElement && document.documentElement.clientHeight) ? document.documentElement.clientHeight : window.innerHeight;
                  var parentTopInViewport = parentRect.top;
                  var panelTopInViewport = parentTopInViewport + top;
                  var maxPanelTopInViewport = Math.max(0, viewportH - ph - 10);
                  if (panelTopInViewport > maxPanelTopInViewport) {
                      panelTopInViewport = maxPanelTopInViewport;
                      top = panelTopInViewport - parentTopInViewport;
                  }
                  if (top < 0) {
                      top = 0;
                  }
              }

              targetPanel.style.top = top + 'px';
          } catch (e) {
              // no-op
          }
      }

      function showChildren(targetPanel, titleText, parentId, children, sourceEl) {
          if (!targetPanel) {
              return;
          }
          clearHoverTimer();
          // For stable positioning, align to the LI row if available
          var posEl = sourceEl;
          while (posEl && posEl.tagName && posEl.tagName !== 'LI') {
              posEl = posEl.parentNode;
          }
          posEl = posEl || sourceEl;
          targetPanel.innerHTML = '';

          var title = document.createElement('div');
          title.style.fontWeight = '600';
          title.style.marginBottom = '8px';
          title.textContent = safeText(titleText);
          targetPanel.appendChild(title);

          var ul = document.createElement('ul');
          ul.style.listStyle = 'none';
          ul.style.padding = '0';
          ul.style.margin = '0';

          for (var i = 0; i < children.length; i++) {
              (function (c) {
                  var li = document.createElement('li');
                  li.style.margin = '0';
                  var a = document.createElement('a');
                  a.href = categoryUrl(c.slug);
                  a.style.display = 'block';
                  a.style.padding = '6px 8px';
                  a.style.color = '#222';
                  a.style.textDecoration = 'none';
                  a.setAttribute('data-bc-id', safeText(c.id));
                  a.setAttribute('data-bc-slug', safeText(c.slug));
                  a.setAttribute('data-bc-name', safeText(c.name));
                  a.setAttribute('data-bc-has-children', c.has_children ? '1' : '0');
                  var icn = document.createElement('span');
                  icn.className = 'menu-icn flaticon-diamond';
                  icn.style.cssText = 'margin-right:8px;';
                  a.appendChild(icn);
                  a.appendChild(document.createTextNode(safeText(c.name)));
                  if (c.has_children) {
                      var arrow = document.createElement('span');
                      arrow.textContent = '›';
                      arrow.style.cssText = 'float:right;opacity:.7;font-size:16px;line-height:1;';
                      a.appendChild(arrow);
                  }
                  li.appendChild(a);
                  ul.appendChild(li);
              })(children[i] || {});
          }
          targetPanel.appendChild(ul);
          targetPanel.style.display = 'block';
          positionPanelTo(targetPanel, posEl, targetPanel === panel);
      }

      var hoverTimer = null;
      var panelHovered = false;
      var panel2Hovered = false;
      function clearHoverTimer() {
          if (hoverTimer) {
              clearTimeout(hoverTimer);
              hoverTimer = null;
          }
      }

      function handleHoverOpen(linkEl) {
          var idRaw = linkEl.getAttribute('data-bc-id');
          var hasChildren = linkEl.getAttribute('data-bc-has-children') === '1';
          if (!idRaw || !hasChildren) {
              hidePanel();
              return;
          }
          var id = parseInt(idRaw, 10);
          if (!id) {
              hidePanel();
              return;
          }
          var name = linkEl.textContent || '';
          fetchCategories(id).then(function (children) {
              if (children && children.length) {
                  hidePanel2();
                  showChildren(panel, name, id, children, linkEl);
                  return;
              }
              hidePanel();
          });
      }

      menu.addEventListener('mouseover', function (e) {
          var target = e.target;
          while (target && target !== menu && target.tagName !== 'A') {
              target = target.parentNode;
          }
          if (!target || target === menu || target.tagName !== 'A') {
              return;
          }
          clearHoverTimer();
          hoverTimer = setTimeout(function () {
              handleHoverOpen(target);
          }, 80);
      });

      menu.addEventListener('mouseleave', function () {
          clearHoverTimer();
          hoverTimer = setTimeout(function () {
              if (panelHovered) {
                  return;
              }
              hidePanel();
          }, 120);
      });

      function handlePanelHoverOpen(linkEl) {
          var idRaw = linkEl.getAttribute('data-bc-id');
          var hasChildren = linkEl.getAttribute('data-bc-has-children') === '1';
          if (!idRaw || !hasChildren) {
              hidePanel2();
              return;
          }
          var id = parseInt(idRaw, 10);
          if (!id) {
              return;
          }
          var name = linkEl.getAttribute('data-bc-name') || linkEl.textContent || '';
          fetchCategories(id).then(function (children) {
              if (children && children.length) {
                  showChildren(panel2, name, id, children, linkEl);
              }
          });
      }

      if (panel) {
          panel.addEventListener('mouseenter', function () {
              panelHovered = true;
              clearHoverTimer();
          });
          panel.addEventListener('mouseover', function (e) {
              var target = e.target;
              while (target && target !== panel && target.tagName !== 'A') {
                  target = target.parentNode;
              }
              if (!target || target === panel || target.tagName !== 'A') {
                  return;
              }
              clearHoverTimer();
              hoverTimer = setTimeout(function () {
                  handlePanelHoverOpen(target);
              }, 80);
          });
          panel.addEventListener('mouseleave', function () {
              panelHovered = false;
              clearHoverTimer();
              hoverTimer = setTimeout(function () {
                  if (panel2Hovered) {
                      return;
                  }
                  hidePanel();
              }, 120);
          });
      }

      if (panel2) {
          panel2.addEventListener('mouseenter', function () {
              panel2Hovered = true;
              clearHoverTimer();
          });
          panel2.addEventListener('mouseleave', function () {
              panel2Hovered = false;
              clearHoverTimer();
              hoverTimer = setTimeout(function () {
                  hidePanel2();
              }, 120);
          });
      }

      if (dropdown) {
          dropdown.addEventListener('mouseleave', function () {
              clearHoverTimer();
              hoverTimer = setTimeout(function () {
                  hidePanel();
              }, 50);
          });
      }

      menu.addEventListener('click', function (e) {
          var target = e.target;
          while (target && target !== menu && target.tagName !== 'A') {
              target = target.parentNode;
          }
          if (!target || target === menu || target.tagName !== 'A') {
              return;
          }
          var hasChildren = target.getAttribute('data-bc-has-children') === '1';
          if (hasChildren) {
              e.preventDefault();
          }
      });

      if (panel) {
          panel.addEventListener('click', function (e) {
              var target = e.target;
              while (target && target !== panel && target.tagName !== 'A') {
                  target = target.parentNode;
              }
              if (!target || target === panel || target.tagName !== 'A') {
                  return;
              }
              var hasChildren = target.getAttribute('data-bc-has-children') === '1';
              var idRaw = target.getAttribute('data-bc-id');
              var slug = target.getAttribute('data-bc-slug') || '';
              var name = target.getAttribute('data-bc-name') || target.textContent || '';
              var id = parseInt(idRaw, 10);
              if (!hasChildren || !id) {
                  return;
              }
              e.preventDefault();
              fetchCategories(id).then(function (children) {
                  if (children && children.length) {
                      showChildren(panel2, name, id, children, target);
                      return;
                  }
                  window.location.href = categoryUrl(slug);
              });
          });
      }

      document.addEventListener('click', function (e) {
          if ((!panel || panel.style.display === 'none') && (!panel2 || panel2.style.display === 'none')) {
              return;
          }
          if ((panel && panel.contains(e.target)) || (panel2 && panel2.contains(e.target)) || menu.contains(e.target)) {
              return;
          }
          hidePanel();
      });

      fetchCategories(null).then(renderParents);
  })();
</script>