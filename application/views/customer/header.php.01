// Fallback if global data fails
if (!isset($cart_items) || empty($cart_items)) {
    $CI =& get_instance();
    $CI->load->model('Cart_model');
    $cart_info = $CI->Cart_model->cart_items();
    $cart_items = $cart_info['cart_items'];
    $cart_summary = $cart_info['cart_summary'];
}

// Shipping Math
$free_shipping_goal = 9800 * (isset($rate) ? (float)$rate : 1.0); 
$total_amt = isset($cart_summary->total) ? $cart_summary->total : 0;
$percentage = ($total_amt / $free_shipping_goal) * 100;
$percentage = ($percentage > 100) ? 100 : $percentage;
$remaining = $free_shipping_goal - $total_amt;
$symbol = isset($symbol) ? $symbol : '$';
?>


<style>
html.cart-open,
body.cart-open {
    overflow: hidden !important;
    height: 100% !important;
}

.cart-hidden-sbar {
    width: 400px;
