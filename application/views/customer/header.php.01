<?php
defined('BASEPATH') OR exit('No direct script access allowed');

/* ================= SESSION CHECK ================= */
$logged_in = false;
$customer  = $this->session->userdata('customer');
if (!is_array($customer)) {
    $customer = [];
}

if (!empty($customer) && !empty($customer['logged_in'])) {
    $logged_in = true;
}

$profile_img = $customer['profile_img'] ?? 'assets/images/default-profile-pic.png';
$user_name   = $customer['name'] ?? 'User';

/* ================= CURRENCY CHECK ================= */
$_CI_hdr =& get_instance();
$_hdr_currencies = $_CI_hdr->db
    ->select('currency_id, name, iso_code, symbol, rate, basic')
    ->from('ec_currency')
    ->where('status', '1')
    ->order_by('basic', 'desc')
    ->order_by('name', 'asc')
    ->get()->result();
$_hdr_cur_id = isset($_SESSION['cur']) ? (int)$_SESSION['cur'] : 0;
$_hdr_cur = null;
foreach ($_hdr_currencies as $_fc) {
    if ((int)$_fc->currency_id === $_hdr_cur_id) {
        $_hdr_cur = $_fc;
        break;
    }
}
if (!$_hdr_cur && !empty($_hdr_currencies)) {
    foreach ($_hdr_currencies as $_fc) {
        if ($_fc->basic == 1) { $_hdr_cur = $_fc; break; }
    }
    if (!$_hdr_cur) $_hdr_cur = $_hdr_currencies[0];
}
$symbol = $_hdr_cur ? $_hdr_cur->symbol : '$';
$rate = $_hdr_cur ? (float)$_hdr_cur->rate : 1.0;

// Load Header Language File
$page_lang = get_page_language_data('header_page_lang');
?>

