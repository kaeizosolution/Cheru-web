                  </div>
                  <script>
                  (function(){
                    function esc(s){
                      return String(s === undefined || s === null ? '' : s)
                        .replace(/&/g,'&amp;')
                        .replace(/</g,'&lt;')
                        .replace(/>/g,'&gt;')
                        .replace(/"/g,'&quot;')
                        .replace(/'/g,'&#39;');
                    }
                    function fmtPrice(n){
                      // API already returns converted prices — do NOT multiply by rate again
                      var v = parseFloat(n || 0);
                      if (isNaN(v)) v = 0;
                      return (window.currentCurrencySymbol || '$') + v.toFixed(2);
                    }
                    function render($row, items){
                      if (!$row || !$row.length) return;
                      if (!Array.isArray(items) || !items.length) return;
                      var html = '';
                      for (var i=0;i<items.length;i++){
                        var p = items[i] || {};
                        var id = parseInt(p.id || 0, 10);
                        if (!id) continue;
                        var name = p.name || '';
                        var url = p.url || ("<?= base_url('product/details/'); ?>" + id);
                        url = String(url || '');
                        url = url.replace(/\/product\/detail\/(\d+)$/i, '/product/details/$1');
                        var img = p.image_url || "<?= base_url('assets/default_images/product.jpg'); ?>";
                        var price = fmtPrice(p.display_price);
                        html += '<div class="col-lg-4 col-sm-6 mb-3 px-2 fadeInUp wow d-flex align-items-stretch" data-wow-duration="0.3s">'
                          + '<div class="align-items-center d-flex shop_item tiny_style w-100">'
                          +   '<div class="flex-shrink-0" style="width: 90px; height: 90px; display: flex; align-items: center; justify-content: center; overflow: hidden; background: #fff; border-radius: 6px; border: 1px solid #f0f0f0;"><img alt="Hot New Arrival Product" src="' + esc(img) + '" style="max-width: 100%; max-height: 100%; object-fit: contain;"></div>'
                          +   '<div class="flex-grow-1 ms-3">'
                          +     '<div class="mb-2 title" style="margin-bottom: 5px !important;"><a href="' + esc(url) + '" style="font-weight: 600; font-size: 14px; line-height: 1.4; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; height: 38px; color: #041e42;">' + esc(name) + '</a></div>'
                          +     '<div class="para text-thm1" style="font-size: 15px; font-weight: 700; color: #ff5a5f;">' + esc(price) + '</div>'
                          +   '</div>'
                          + '</div>'
                          + '</div>';
                      }
                      if (html) $row.html(html);
                    }
                    function boot(){
                      var $row = window.jQuery ? window.jQuery('#hot-new-arrivals-items') : null;
                      if (!$row || !$row.length) return;
                      window.jQuery.ajax({
                        url: "<?= base_url('api/v1/homepage/hot-new-arrivals'); ?>",
                        type: 'POST',
                        contentType: 'application/json; charset=utf-8',
                        data: JSON.stringify({limit: 12}),
                        dataType: 'json'
                      }).done(function(resp){
                        if (!resp || parseInt(resp.status, 10) !== 1 || !resp.data || !resp.data.hot_new_arrivals) return;
                        render($row, resp.data.hot_new_arrivals);
                      });
                    }
                    if (document.readyState === 'complete') {
                      boot();
                    } else {
                      window.addEventListener('load', boot);
                    }
                  })();
                  </script>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>
    
    <script>
(function(){
    function isLoggedIn(){
        return Boolean(<?= !empty($this->session->userdata('customer')) ? 'true' : 'false'; ?>);
    }

    function setHeartActive($el, active){
        if(!$el || !$el.length) return;
        $el.toggleClass('active', !!active);
        var $icon = $el.find('i.fa-heart');
        if($icon.length){
            if(active){
                $icon.removeClass('far').addClass('fas').css('color', '#dc3545');
            } else {
                $icon.removeClass('fas').addClass('far').css('color', '');
            }
        }
    }

    function loadWishlistIds(){
        if(!isLoggedIn()) return;
        if(!window.jQuery) return;
        $.ajax({
            url: '<?= base_url("customer/wishlist/ids"); ?>',
            type: 'POST',
            dataType: 'json',
            data: (typeof window.csrf_token_name !== 'undefined' && typeof window.csrf_hash !== 'undefined')
                ? { [window.csrf_token_name]: window.csrf_hash }
                : {},
            success: function(resp){
                var STATUS = (typeof resp.STATUS !== 'undefined') ? resp.STATUS : resp.status;
                var DATA = (typeof resp.DATA !== 'undefined') ? resp.DATA : resp.data;
                if(STATUS !== 1 || !Array.isArray(DATA)) return;
                var map = {};
                DATA.forEach(function(id){ map[String(id)] = true; });
                window.__wishlistIdsMap = map;
                window.__applyWishlistToDom = function(){
                    if(!window.jQuery || !window.__wishlistIdsMap) return;
                    $('.wishlist-toggle').each(function(){
                        var pid = String($(this).data('product-id') || '');
                        setHeartActive($(this), !!window.__wishlistIdsMap[pid]);
                    });
                };
                window.__applyWishlistToDom();
            }
        });
    }

    function toggleWishlist($btn){
        if(!isLoggedIn()){
            window.location.href = '<?= base_url("login"); ?>';
            return;
        }
        var productId = $btn.data('product-id');
        if(!productId) return;
        var postData = { product_id: productId };
        if (typeof window.csrf_token_name !== 'undefined' && typeof window.csrf_hash !== 'undefined') {
            postData[window.csrf_token_name] = window.csrf_hash;
        }
        $.ajax({
            url: '<?= base_url("customer/wishlist/toggle"); ?>',
            type: 'POST',
            dataType: 'json',
            data: postData,
            success: function(resp){
                var STATUS = (typeof resp.STATUS !== 'undefined') ? resp.STATUS : resp.status;
                var DATA = (typeof resp.DATA !== 'undefined') ? resp.DATA : resp.data;
                if(STATUS === 1 && DATA && typeof DATA.in_wishlist !== 'undefined'){
                    var active = Number(DATA.in_wishlist) === 1;
                    setHeartActive($btn, active);
                    if (typeof window.__wishlistIdsMap === 'object' && window.__wishlistIdsMap !== null) {
                        var key = String(productId);
                        if (active) {
                            window.__wishlistIdsMap[key] = true;
                        } else {
                            try { delete window.__wishlistIdsMap[key]; } catch(e) { window.__wishlistIdsMap[key] = false; }
                        }
                    }
                }
            }
        });
    }

    function waitForJq(cb){
        if(window.jQuery) return cb();
        setTimeout(function(){ waitForJq(cb); }, 50);
    }

    waitForJq(function(){
        loadWishlistIds();
        $(document).on('click', '.wishlist-toggle', function(e){
            e.preventDefault();
            toggleWishlist($(this));
        });
    });
})();
</script>
    <script></script>