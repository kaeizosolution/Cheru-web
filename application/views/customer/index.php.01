    <script>
    (function(){
        function whenReady(fn){
            if (document.readyState === 'complete') {
                fn();
            } else {
                window.addEventListener('load', fn);
            }
        }

        function waitForJqAndOwl(cb){
            var tries = 0;
            var maxTries = 60; // ~6 seconds
            var t = setInterval(function(){
                tries++;
                if (window.jQuery && window.jQuery.fn && typeof window.jQuery.fn.owlCarousel === 'function') {
                    clearInterval(t);
                    cb(window.jQuery);
                    return;
                }
                if (tries >= maxTries) {
                    clearInterval(t);
                }
            }, 100);
        }

        whenReady(function(){
            waitForJqAndOwl(function($){
                var $carousel = $('.banner-style-one');
                if (!$carousel.length) return;

        function escapeHtml(s){
            return String(s || '').replace(/[&<>"']/g, function(c){
                return ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;','\'':'&#39;'}[c]) || c;
            });
        }

        function initCarousel(slideCount){
            if (!$carousel.length || typeof $carousel.owlCarousel !== 'function') return;
            if ($carousel.hasClass('owl-loaded')) {
                $carousel.trigger('destroy.owl.carousel');
                $carousel.removeClass('owl-loaded');
                $carousel.find('.owl-stage-outer').children().unwrap();
            }
            var count = parseInt(slideCount, 10);
            if (!count || count < 1) count = 1;
            $carousel.owlCarousel({
                loop: count > 1,
                items: 1,
                margin: 0,
                dots: count > 1,
                nav: count > 1,
                animateOut: 'slideOutDown',
                animateIn: 'fadeIn',
                active: true,
                smartSpeed: 1000,
                autoplay: false
            });
        }

        function renderSlides(banners){
            if (!Array.isArray(banners) || !banners.length) {
                banners = [{}];
            }
            var html = '';
            var slideCount = 0;
            for (var i=0;i<banners.length;i++) {
                var b = banners[i] || {};
                var img = b.image_large_url || b.image_url || b.image_thumb_url || '';
                if (!img) {
                    img = "<?= base_url('assets/customer/images/home/1.jpg'); ?>";
                }
                // Avoid mixed-content blocks if the site runs on https but API returned http URLs
                if (typeof img === 'string' && img.indexOf('//') > -1) {
                    img = img.replace(/^https?:\/\//i, window.location.protocol + '//');
                }
                var tag = b.tag ? escapeHtml(b.tag) : '';
                var desc = b.description ? escapeHtml(b.description) : '';
                var title = b.title ? String(b.title) : '';
                var url = b.url ? String(b.url) : '#';
                if (typeof url === 'string' && url.indexOf('//') > -1) {
                    url = url.replace(/^https?:\/\//i, window.location.protocol + '//');
                }

                slideCount++;
                html += '<div class="slide slide-one" style="background-image:url(' + escapeHtml(img) + ');background-size:contain!important;background-repeat:no-repeat!important;background-position:right center!important;height:568px!important;min-height:568px;max-height:568px">'
                    + '<div class="container">'
                    +   '<div class="row home-content">'
                    +     '<div class="col-lg-6 offset-lg-1 col-xl-5">'
                    +       (tag ? ('<span class="tag">' + tag + '</span>') : '')
                    +       '<h3 class="banner-title">' + title + '</h3>'
                    +       (desc ? ('<p>' + desc + '</p>') : '')
                    +       '<a href="' + escapeHtml(url) + '" class="btn banner-btn btn-thm">Shop Now</a>'
                    +     '</div>'
                    +   '</div>'
                    + '</div>'
                    + '</div>';
            }
            if (!html) return;
            $carousel.html(html);
            $carousel.css('display', 'block');
            initCarousel(slideCount);
        }

                $.ajax({
                    url: "<?= base_url('api/v1/homepage/banners'); ?>",
                    type: 'POST',
                    contentType: 'application/json; charset=utf-8',
                    data: JSON.stringify({type: 1}),
                    dataType: 'json'
                }).done(function(resp){
                    if (!resp || parseInt(resp.status, 10) !== 1 || !resp.data || !resp.data.banners) {
                        renderSlides([]);
                        return;
                    }
                    renderSlides(resp.data.banners);
                }).fail(function(){
                    renderSlides([]);
                });
            });
        });
    })();
    </script>
