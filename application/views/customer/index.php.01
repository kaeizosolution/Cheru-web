		<?php if(isset($shop_categories) && $shop_categories){ ?>
		  <div class="row ovh mb20 g-3" id="shop-by-category-items">
			<?php foreach($shop_categories as $c){ ?>
			  <div class="col-6 col-sm-4 col-md-3 col-lg-2 wow fadeInUp" data-wow-duration=".7s">
