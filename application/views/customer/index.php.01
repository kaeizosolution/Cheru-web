		<script>
		(function(){
		  function esc(s){
			return String(s === undefined || s === null ? '' : s)
			  .replace(/&/g,'&amp;')
			  .replace(/</g,'&lt;')
			  .replace(/>/g,'&gt;')
			  .replace(/"/g,'&quot;')
			  .replace(/'/g,'&#39;');
		  }
		  function render($row, cats){
			if (!$row || !$row.length) return;
			if (!Array.isArray(cats) || !cats.length) return;
			var html = '';
			for (var i=0;i<cats.length;i++){
			  var c = cats[i] || {};
			  var url = c.url || '#';
			  var img = c.thumbnail_url || "<?= base_url('assets/default_images/product.jpg'); ?>";
			  var name = c.name || '';
			  html += '<div class="col-6 col-sm-4 col-md-3 col-lg-2 wow fadeInUp" data-wow-duration=".7s">'
				+ '<a href="' + esc(url) + '">'
				+   '<div class="iconbox">'
				+     '<div class="icon">'
				+       '<img src="' + esc(img) + '" alt="Category">'
				+     '</div>'
				+     '<div class="details">'
				+       '<h5 class="title">' + esc(name) + '</h5>'
				+     '</div>'
				+   '</div>'
				+ '</a>'
				+ '</div>';
			}
			if (html) {
			  $row.html(html);
			}
		  }
		  function boot(){
			var $row = window.jQuery ? window.jQuery('#shop-by-category-items') : null;
			if (!$row || !$row.length) return;
			window.jQuery.ajax({
			  url: "<?= base_url('api/v1/homepage/shop-by-category'); ?>",
			  type: 'POST',
			  contentType: 'application/json; charset=utf-8',
			  data: JSON.stringify({limit: 12}),
			  dataType: 'json'
			}).done(function(resp){
			  if (!resp || parseInt(resp.status, 10) !== 1 || !resp.data || !resp.data.categories) return;
			  render($row, resp.data.categories);
			});
		  }
		  if (document.readyState === 'complete') {
			boot();
		  } else {
			window.addEventListener('load', boot);
		  }
		})();
		</script>
