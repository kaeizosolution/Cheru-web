                  <script>
                  (function(){
                    function esc(s){
                      return String(s === undefined || s === null ? '' : s)
                        .replace(/&/g,'&amp;')
                        .replace(/</g,'&lt;')
                        .replace(/>/g,'&gt;')
                        .replace(/"/g,'&quot;')
                        .replace(/'/g,'&#39;');
                    }
                    function priceText(prices){
                      try {
                        // API already returns converted prices — do NOT multiply by rate again
                        var sym  = window.currentCurrencySymbol || '$';
                        if (!Array.isArray(prices) || !prices.length) return sym + '0.00';
                        var p = prices[0] || {};
                        var v = (p.regular_price !== undefined ? p.regular_price : (p.sale_price !== undefined ? p.sale_price : (p.sales_price !== undefined ? p.sales_price : 0)));
                        return sym + parseFloat(v || 0).toFixed(2);
                      } catch(e){
                        return (window.currentCurrencySymbol || '$') + '0.00';
                      }
                    }
                    function render($owl, items){
                      if (!$owl || !$owl.length) return;
                      if (!Array.isArray(items) || !items.length) return;
                      var html = '';
                      for (var i=0;i<items.length;i++){
                        var it = items[i] || {};
                        var id = parseInt(it.id || 0, 10);
                        if (!id) continue;
                        var name = it.name || '';
                        var url = it.url || ("<?= base_url('product/details/'); ?>" + id);
                        url = String(url || '');
                        url = url.replace(/\/product\/detail\/(\d+)$/i, '/product/details/$1');
                        var img = it.image_url || "<?= base_url('assets/default_images/product.jpg'); ?>";
                        var price = priceText(it.prices);
                        html += '<div class="item ovh">'
                          + '<div class="shop_item bdrtrb1 px-2 px-sm-3 wow fadeIn" data-wow-duration="1.1s">'
                          +   '<div class="thumb pb30">'
                          +     '<a href="' + esc(url) + '">' + '<img src="' + esc(img) + '" alt="Best Seller Item">' + '</a>'
                          +     '<div class="thumb_info">'
                          +       '<ul class="mb0">'
                          +         '<li><a href="javascript:void(0);" class="wishlist-toggle" data-product-id="' + id + '"><i class="far fa-heart"></i></a></li>'
                          +         '<li><a href="' + esc(url) + '"><span class="flaticon-show"></span></a></li>'
                          +       '</ul>'
                          +     '</div>'
                          +     '<div class="shop_item_cart_btn d-grid"> <button type="button" class="btn btn-thm add-to-cart-btn" data-product_id="' + id + '" data-product_type="' + esc(it.product_type || 'simple') + '" data-vendor_id="0" data-quantity="1">Add to Cart</button> </div>'
                          +   '</div>'
                          +   '<div class="details">'
                          +     '<div class="sub_title"></div>'
                          +     '<div class="title"><a href="' + esc(url) + '">' + esc(name) + '</a></div>'
                          +     '<div class="review d-flex db-500 mb-2">'
                          +       '<ul class="mb0 me-2">'
                          +         '<li class="list-inline-item"><i class="' + (1 <= (parseFloat(it.rating||it.avg_rating)||0) ? 'fas' : 'far') + ' fa-star" style="color:#f5a623; font-size:12px;"></i></li>'
                          +         '<li class="list-inline-item"><i class="' + (2 <= (parseFloat(it.rating||it.avg_rating)||0) ? 'fas' : 'far') + ' fa-star" style="color:#f5a623; font-size:12px;"></i></li>'
                          +         '<li class="list-inline-item"><i class="' + (3 <= (parseFloat(it.rating||it.avg_rating)||0) ? 'fas' : 'far') + ' fa-star" style="color:#f5a623; font-size:12px;"></i></li>'
                          +         '<li class="list-inline-item"><i class="' + (4 <= (parseFloat(it.rating||it.avg_rating)||0) ? 'fas' : 'far') + ' fa-star" style="color:#f5a623; font-size:12px;"></i></li>'
                          +         '<li class="list-inline-item"><i class="' + (5 <= (parseFloat(it.rating||it.avg_rating)||0) ? 'fas' : 'far') + ' fa-star" style="color:#f5a623; font-size:12px;"></i></li>'
                          +       '</ul>'
                          +       '<div class="review_count" style="font-size:12px;">' + (parseInt(it.review||it.review_count)||0) + ' review' + ((parseInt(it.review||it.review_count)||0)!==1?'s':'') + '</div>'
                          +     '</div>'
                          +     '<div class="si_footer"><div class="price">' + esc(price) + '</div></div>'
                          +   '</div>'
                          + '</div>'
                          + '</div>';
                      }
                      if (!html) return;
                      var wasOwl = $owl.hasClass('owl-loaded');
                      if (wasOwl) {
                        try {
                          $owl.trigger('replace.owl.carousel', [html]).trigger('refresh.owl.carousel');
                          return;
                        } catch(e) {}
                      }
                      $owl.html(html);
                    }
                    function boot(){
                      var $owl = window.jQuery ? window.jQuery('#best-sellers-last-month-items') : null;
                      if (!$owl || !$owl.length) return;
                      window.jQuery.ajax({
                        url: "<?= base_url('api/v1/homepage/best-sellers'); ?>",
                        type: 'POST',
                        contentType: 'application/json; charset=utf-8',
                        data: JSON.stringify({limit: 20}),
                        dataType: 'json'
                      }).done(function(resp){
                        if (!resp || parseInt(resp.status, 10) !== 1 || !resp.data || !resp.data.best_sellers) return;
                        render($owl, resp.data.best_sellers);
                      });
                    }
                    if (document.readyState === 'complete') {
                      boot();
                    } else {
                      window.addEventListener('load', boot);
                    }
                  })();
                  </script>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>
    
