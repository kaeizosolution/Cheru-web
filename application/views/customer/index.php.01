		(function(){
		  function esc(s){
			return String(s === undefined || s === null ? '' : s)
			  .replace(/&/g,'&amp;')
			  .replace(/</g,'&lt;')
			  .replace(/>/g,'&gt;')
			  .replace(/"/g,'&quot;')
			  .replace(/'/g,'&#39;');
		  }
		  function render($row, ads){
			if (!$row || !$row.length) return;
			if (!Array.isArray(ads) || !ads.length) return;
			var colors = ['color1','color2','color3'];
			var html = '';
			for (var i=0;i<ads.length;i++){
			  var ad = ads[i] || {};
			  var title = ad.title || '';
			  var tag = ad.tag || '';
			  var link = ad.link || '';
			  var img = ad.image_url || "<?= base_url('assets/default_images/product.jpg'); ?>";
			  var color = colors[i % colors.length];
			  html += '<div class="col-lg-6 col-xl-4 wow fadeInUp" data-wow-duration=".7s">'
				+ '<div class="banner_one home1_style ' + esc(color) + ' mb30">'
				+   '<div class="thumb style1"><img class="float-end" src="' + esc(img) + '" alt="Advertisement" style="max-height: 170px; width: auto; object-fit: contain;"></div>'
				+   '<div class="details">'
				+     (tag ? ('<p class="para color-light-blue">' + esc(tag) + '</p>') : '')
				+     '<h3 class="title">' + esc(title) + '</h3>'
				+     (link ? ('<a href="' + esc(link) + '" class="shop_btn" target="_blank" rel="noopener">Shop Now</a>') : '')
				+   '</div>'
				+ '</div>'
				+ '</div>';
			}
			if (html) {
			  $row.html(html);
			}
		  }
		  function boot(){
			var $row = window.jQuery ? window.jQuery('#homepage-advertisements-items') : null;
			if (!$row || !$row.length) return;
			window.jQuery.ajax({
			  url: "<?= base_url('api/v1/homepage/advertisements'); ?>",
			  type: 'POST',
			  contentType: 'application/json; charset=utf-8',
			  data: JSON.stringify({limit: 3}),
			  dataType: 'json'
			}).done(function(resp){
			  if (!resp || parseInt(resp.status, 10) !== 1 || !resp.data || !resp.data.advertisements) return;
			  render($row, resp.data.advertisements);
			});
		  }
		  if (document.readyState === 'complete') {
			boot();
		  } else {
			window.addEventListener('load', boot);
		  }
		})();
		</script>
		<?php } ?>
