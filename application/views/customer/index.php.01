			<script>
			(function(){
			  function esc(s){
				return String(s === undefined || s === null ? '' : s)
				  .replace(/&/g,'&amp;')
				  .replace(/</g,'&lt;')
				  .replace(/>/g,'&gt;')
				  .replace(/"/g,'&quot;')
				  .replace(/'/g,'&#39;');
			  }
			  function fmtPrice(n){
				// API already returns converted prices — do NOT multiply by rate again
				var v = parseFloat(n || 0);
				if (isNaN(v)) v = 0;
				return (window.currentCurrencySymbol || '$') + v.toFixed(2);
			  }
			  function render($grid, items){
				if (!$grid || !$grid.length) return;
				if (!Array.isArray(items) || !items.length) return;
				var html = '';
				for (var i=0;i<items.length;i++){
				  var p = items[i] || {};
				  var id = parseInt(p.id || 0, 10);
				  if (!id) continue;
				  var name = p.name || '';
				  var url = p.url || ("<?= base_url('product/details/'); ?>" + id);
				  url = String(url || '');
				  url = url.replace(/\/product\/detail\/(\d+)$/i, '/product/details/$1');
				  var img = p.image_url || "<?= base_url('assets/default_images/product.jpg'); ?>";
				  var price = fmtPrice(p.display_price);
				  html += '<div class="random-products-item">'
					+ '<div class="shop_item bdrtrb1 px-2 px-sm-3 wow fadeIn" data-wow-duration="1.1s">'
					+   '<div class="thumb pb30">'
					+     '<a href="' + esc(url) + '"><img src="' + esc(img) + '" alt="Product"></a>'
					+     '<div class="thumb_info">'
					+       '<ul class="mb0">'
					+         '<li><a href="javascript:void(0);" class="wishlist-toggle" data-product-id="' + id + '"><i class="far fa-heart"></i></a></li>'
					+         '<li><a href="' + esc(url) + '"><span class="flaticon-show"></span></a></li>'
					+       '</ul>'
					+     '</div>'
					+     '<div class="shop_item_cart_btn d-grid"> <button type="button" class="btn btn-thm add-to-cart-btn" data-product_id="' + id + '" data-product_type="' + esc(p.product_type || 'simple') + '" data-vendor_id="0" data-quantity="1">Add to Cart</button> </div>'
					+   '</div>'
					+   '<div class="details">'
					+     '<div class="sub_title"></div>'
					+     '<div class="title"><a href="' + esc(url) + '">' + esc(name) + '</a></div>'
					+     '<div class="review d-flex db-500 mb-2">'
					+       '<ul class="mb0 me-2">'
					+         '<li class="list-inline-item"><i class="' + (1 <= (parseFloat(p.rating||p.avg_rating)||0) ? 'fas' : 'far') + ' fa-star" style="color:#f5a623; font-size:12px;"></i></li>'
					+         '<li class="list-inline-item"><i class="' + (2 <= (parseFloat(p.rating||p.avg_rating)||0) ? 'fas' : 'far') + ' fa-star" style="color:#f5a623; font-size:12px;"></i></li>'
					+         '<li class="list-inline-item"><i class="' + (3 <= (parseFloat(p.rating||p.avg_rating)||0) ? 'fas' : 'far') + ' fa-star" style="color:#f5a623; font-size:12px;"></i></li>'
					+         '<li class="list-inline-item"><i class="' + (4 <= (parseFloat(p.rating||p.avg_rating)||0) ? 'fas' : 'far') + ' fa-star" style="color:#f5a623; font-size:12px;"></i></li>'
					+         '<li class="list-inline-item"><i class="' + (5 <= (parseFloat(p.rating||p.avg_rating)||0) ? 'fas' : 'far') + ' fa-star" style="color:#f5a623; font-size:12px;"></i></li>'
					+       '</ul>'
					+       '<div class="review_count" style="font-size:12px;">' + (parseInt(p.review||p.review_count)||0) + ' review' + ((parseInt(p.review||p.review_count)||0)!==1?'s':'') + '</div>'
					+     '</div>'
					+     '<div class="si_footer"><div class="price">' + esc(price) + '</div></div>'
					+   '</div>'
					+ '</div>'
					+ '</div>';
				}
				if (html) $grid.html(html);
				if (typeof window.__applyWishlistToDom === 'function') {
				  window.__applyWishlistToDom();
				}
			  }
			  function boot(){
				var $grid = window.jQuery ? window.jQuery('#homepage-random-products-items') : null;
				if (!$grid || !$grid.length) return;
				var $sel = window.jQuery ? window.jQuery('#trendingLimitSelect') : null;
				var limit = <?= (int)($homepage_trending_limit ?? 12); ?>;
				try {
					var saved = window.localStorage ? window.localStorage.getItem('homepage_trending_limit') : null;
					if (saved !== null && saved !== '') {
						var sv = parseInt(saved, 10);
						if (!isNaN(sv) && sv > 0) limit = sv;
					}
				} catch(e) {}
				if ($sel && $sel.length) {
					var cur = parseInt($sel.val(), 10);
					if (!isNaN(cur) && cur > 0) limit = cur;
					try { $sel.val(String(limit)); } catch(e) {}
				}
				if (limit > 50) limit = 50;
				window.jQuery.ajax({
				  url: "<?= base_url('api/v1/homepage/products'); ?>",
				  type: 'POST',
				  contentType: 'application/json; charset=utf-8',
				  data: JSON.stringify({limit: limit}),
				  dataType: 'json'
				}).done(function(resp){
				  if (!resp || parseInt(resp.status, 10) !== 1 || !resp.data || !resp.data.products) return;
				  render($grid, resp.data.products);
				});
			  }
			  function bindLimit(){
				var $sel = window.jQuery ? window.jQuery('#trendingLimitSelect') : null;
				if (!$sel || !$sel.length) return;
				$sel.off('change.homeTrending').on('change.homeTrending', function(){
					var v = parseInt(window.jQuery(this).val(), 10);
					if (isNaN(v) || v <= 0) return;
					if (v > 50) v = 50;
					try { if (window.localStorage) window.localStorage.setItem('homepage_trending_limit', String(v)); } catch(e) {}
					boot();
				});
			  }
			  if (document.readyState === 'complete') {
				bindLimit();
				boot();
			  } else {
				window.addEventListener('load', function(){ bindLimit(); boot(); });
			  }
			})();
			</script>
          </div>
        </div>
      </div>
    </section>
    
 
    
