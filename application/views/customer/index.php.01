    <?php
    // One-time currency setup for PHP-rendered homepage prices
    if (!isset($_hp_cur_id)) {
        // Use session currency so PHP-rendered prices match selected currency
        $_hp_cur_sess_id = isset($_SESSION['cur']) ? (int)$_SESSION['cur'] : 0;
        $_hp_cur_id  = $_hp_cur_sess_id > 0 ? $_hp_cur_sess_id : (function_exists('default_currency') ? default_currency() : null);
        $_hp_cur_obj = ($_hp_cur_id && function_exists('get_currency')) ? get_currency($_hp_cur_id) : null;
        $_hp_cur_symbol = $_hp_cur_obj ? html_entity_decode((string)$_hp_cur_obj->symbol) : '$';
        // Rate is 1.0 here because API already returns converted prices; PHP fallback prices also use converted data
        $_hp_cur_rate   = 1.0;
    }
