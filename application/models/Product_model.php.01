    public function top_rated($length = NULL)
    {
        if (!$length)
            $length = 6;

        // FIX: join on id
        $this->slave->select('a.product_id,count(*) CNT');
        $this->slave->from('ec_order_items a');
        $this->slave->join('products b', 'a.product_id = b.id');
        $this->slave->join('ec_vendor v_check', 'v_check.vendor_id = b.vendor_id', 'left');
        $this->slave->where('b.status', '1');
        $this->slave->group_start()
            ->where('b.vendor_id', 0)
            ->or_where('b.vendor_id IS NULL', null, false)
            ->or_where("CAST(v_check.status AS CHAR) IN ('1', 'approved', 'Approved')", null, false)
        ->group_end();
        $this->slave->group_by('a.product_id');
        $this->slave->order_by('CNT', 'desc');
        $this->slave->limit($length);
        $obj = $this->slave->get()->result();
        $product_ids = array();
        if ($obj) {
            foreach ($obj as $r) {
                $product_ids[] = $r->product_id;
            }
        }

        if (count($product_ids) < $length) {
            $length = $length - count($product_ids);
            $this->slave->select('products.*');
            $this->slave->from('products');
            $this->slave->join('ec_vendor v_check', 'v_check.vendor_id = products.vendor_id', 'left');
            if ($product_ids) {
                $this->slave->where_not_in('products.id', $product_ids);
            }
            $this->slave->where('products.status', '1');
            $this->slave->group_start()
                ->where('products.vendor_id', 0)
                ->or_where('products.vendor_id IS NULL', null, false)
                ->or_where("CAST(v_check.status AS CHAR) IN ('1', 'approved', 'Approved')", null, false)
            ->group_end();
            $this->slave->order_by('products.id', 'desc');
            $this->slave->limit($length);
            $result = $this->slave->get()->result();
            if ($result) {
                foreach ($result as $r) {
                    $product_ids[] = $r->id;
                }
            }
        }
        if ($product_ids) {
            $this->slave->select('*');
            $this->slave->from('products');
            $this->slave->where_in('id', $product_ids);
            $obj = $this->slave->get()->result();
        } else {
            $obj = [];
        }

        if ($obj) {
            foreach ($obj as $product_obj) {
                $this->get_product_info(array('product_obj' => $product_obj));
            }
        }
        return $obj;
    }

    public function related_product($product_id = null)
    {
        $category = $this->category($product_id);
        $category_id = isset($category->category_id) ? $category->category_id : '';
        $obj = array();
        if ($category_id && isset($category_id)) {
            // FIX: enabled->status, product_id->id
            $sql = "select a.* from products a 
                left join ec_vendor v_check on v_check.vendor_id = a.vendor_id
                inner join ec_product_categories b on a.id = b.post_id
                where b.category_id IN($category_id) 
                  and b.post_id !=$product_id 
                  and a.id = b.post_id 
                  and a.status = '1' 
                  and (a.vendor_id = 0 or a.vendor_id is null or v_check.status = 1 or v_check.status = '1' or v_check.status = 'approved' or v_check.status = 'Approved')
                group by a.id 
                ORDER BY a.id DESC limit 10";

            $query = $this->slave->query($sql);
            $obj = $query->result();
            foreach ($obj as $product_obj) {
                $this->get_product_info(array('product_obj' => $product_obj));
            }
        }
        return $obj;
    }

    public function get_product_by_category($category_id, $product_ids = null, $vendor_cat_array = null)
    {
        if ($vendor_cat_array && count($vendor_cat_array)) {
            $vendor_cat_join = implode(',', $vendor_cat_array);
            $sql = "SELECT distinct pc.post_id AS product_id FROM ec_product_categories pc
                    JOIN products p ON p.id = pc.post_id
                    LEFT JOIN ec_vendor v ON v.vendor_id = p.vendor_id
                    WHERE pc.category_id in ($vendor_cat_join)
                      AND p.status = '1'
                      AND (p.vendor_id = 0 OR p.vendor_id IS NULL OR CAST(v.status AS CHAR) IN ('1', 'approved', 'Approved'))";
        } else if (is_numeric($category_id)) {
            $sub_cat_obj = $this->get_all_subcat($category_id);
            $sub_cat_array = array();
            $sub_cat_array[] = $category_id;
            if ($sub_cat_obj) {
                foreach ($sub_cat_obj as $r) {
                    $sub_cat_array[] = $r->category_id;
                }
            }
            $sub_cat_str = implode(',', $sub_cat_array);
            $sql = "SELECT distinct pc.post_id AS product_id FROM ec_product_categories pc
                    JOIN products p ON p.id = pc.post_id
                    LEFT JOIN ec_vendor v ON v.vendor_id = p.vendor_id
                    WHERE pc.category_id in ($sub_cat_str)
                      AND p.status = '1'
                      AND (p.vendor_id = 0 OR p.vendor_id IS NULL OR CAST(v.status AS CHAR) IN ('1', 'approved', 'Approved'))";
            if ($product_ids) {
                $sql .= " and pc.post_id in ($product_ids)";
            }
        } else {
            $cat_synonym = cat_synonym();
            $category_id = isset($cat_synonym[$category_id]) ? $cat_synonym[$category_id] : $category_id;

            $sql = "SELECT distinct pc.post_id AS product_id FROM ec_product_categories pc
                    JOIN products p ON p.id = pc.post_id
                    LEFT JOIN ec_vendor v ON v.vendor_id = p.vendor_id
                    JOIN ec_categories_prod b ON pc.category_id = b.id
                    WHERE UPPER(b.name) = UPPER('$category_id')
                      AND p.status = '1'
                      AND (p.vendor_id = 0 OR p.vendor_id IS NULL OR CAST(v.status AS CHAR) IN ('1', 'approved', 'Approved'))";
        }
        $query = $this->slave->query($sql);
        $data = $query->result();
        return $data;
    }

    public function get_search_result($args)
    {
        $synonym = synonym();
        $fts = isset($synonym[$args['fts']]) ? $synonym[$args['fts']] : $args['fts'];
        $fts = isset($fts) ? urldecode($fts) : '';
        $fts = preg_replace('/-/', ' ', $fts);

        $fts = trim((string) $fts);
        if ($fts === '') {
            return array();
        }

        		// New products first
		$this->slave
			->select('DISTINCT p.id AS product_id', false)
			->from('products p')
			->join('ec_vendor v_check', 'v_check.vendor_id = p.vendor_id', 'left')
			->group_start()
				->where('p.status', 1)
				->or_where('p.status', '1')
				->or_where('p.status', 'active')
				->or_where('p.status', 'Active')
            ->group_end()
			->group_start()
				->where('p.vendor_id', 0)
				->or_where('p.vendor_id IS NULL', null, false)
				->or_where("CAST(v_check.status AS CHAR) IN ('1', 'approved', 'Approved')", null, false)
			->group_end()
            ->like('p.name', $fts);
        $data = $this->slave->get()->result();
        if ($data && count($data) > 0) {
            return $data;
        }

        		// Fallback legacy (pointing to products table now)
		$this->slave
			->select('DISTINCT ep.id AS product_id', false)
			->from('products ep')
			->join('ec_vendor v_check', 'v_check.vendor_id = ep.vendor_id', 'left')
			->where('ep.status', '1')
			->group_start()
				->where('ep.vendor_id', 0)
				->or_where('ep.vendor_id IS NULL', null, false)
				->or_where("CAST(v_check.status AS CHAR) IN ('1', 'approved', 'Approved')", null, false)
			->group_end()
			->like('ep.name', $fts);
		return $this->slave->get()->result();
	}

    public function category($product_id = null)
    {
        $sql = "select group_concat(category_id) category_id from ec_product_categories where post_id=$product_id group by post_id";
        $query = $this->slave->query($sql);
        $data = $query->row();
        return $data;
    }

    public function get_order_data($customer_id = NULL, $orderStatus = NULL)
    {
        $this->slave->select('eop.*, eos.id as order_id, eos.shipping_address_id, eos.order_uid, eos.num_items_sold, eos.total_amount as order_total, eos.payment_mode');
        $this->slave->from('ec_orders as eos');
        $this->slave->join('ec_order_items as eop', 'eop.order_id =eos.id');
        $this->slave->where('eos.customer_id', $customer_id);

        if ($orderStatus !== null) {
            $filter = strtolower(trim((string)$orderStatus));
            if ($filter === 'active' || $filter === 'process') {
                // Safe combined condition:
                // Match by status enum OR by order_status integer,
                // but NEVER show delivered/cancelled in active.
                $this->slave->group_start()
                    ->where_in('eos.status', ['pending', 'confirmed', 'shipped'])
                    ->or_group_start()
                        ->where_in('eos.order_status', [1, 2, 3])
                        ->where_not_in('eos.status', ['delivered', 'cancelled'])
                    ->group_end()
                ->group_end();
            } elseif ($filter === 'completed') {
                // Completed = delivered only
                $this->slave->where('eos.status', 'delivered');
            } elseif ($filter === 'cancelled' || $filter === 'cancel') {
                // Cancelled = cancelled only (returned orders keep status 'delivered')
                $this->slave->where('eos.status', 'cancelled');
            }
            // Other/unknown filter: no extra WHERE → returns all
        }

        $this->slave->order_by('eop.date_added  DESC');
        $obj = $this->slave->get()->result();
        return $obj;
    }


