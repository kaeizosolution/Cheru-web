    public function get_all_subcat($parent_id = null)
    {
        $sql = "SELECT T1.id as category_id FROM ec_categories_prod AS T1 INNER JOIN (SELECT id FROM ec_categories_prod WHERE parent_id = $parent_id) AS T2  ON T2.id = T1.parent_id OR T1.parent_id = $parent_id GROUP BY T1.id";
        $query = $this->slave->query($sql);
        $data = $query->result();
        return $data;
    }

    public function get_all_parent($category_id = null)
    {
        $sql = "SELECT T2.id as category_id, T2.name FROM (SELECT @r AS _id, (SELECT @r := parent_id FROM ec_categories_prod WHERE id = _id) AS parent_id, @l := @l + 1 AS lvl FROM (SELECT @r := $category_id, @l := 0) vars, ec_categories_prod h WHERE @r <> 0) T1 JOIN ec_categories_prod T2 ON T1._id = T2.id ORDER BY T1.lvl DESC";
        $query = $this->slave->query($sql);
        $data = $query->result();
        return $data;
    }

    public function get_all_childs($category_ids = null)
    {
        $sql = "SELECT T1.id,T1.parent_id,T1.name,T1.slug  FROM ec_categories_prod AS T1  INNER JOIN (SELECT id FROM ec_categories_prod WHERE status='1' and parent_id in ($category_ids)) AS T2  ON T2.id = T1.parent_id OR T1.parent_id in($category_ids)  or T1.id in ($category_ids) GROUP BY T1.id";
        $query = $this->slave->query($sql);
        $data = $query->result();
        return $data;
    }

    public function get_root_parent($category_id = null)
    {
        $sql = "SELECT T2.id as category_id, T2.name, T2.slug FROM (SELECT @r AS _id, (SELECT @r := parent_id FROM ec_categories_prod WHERE id = _id) AS parent_id, @l := @l + 1 AS lvl FROM (SELECT @r := $category_id, @l := 0) vars, ec_categories_prod h WHERE @r <> 0) T1 JOIN ec_categories_prod T2 ON T1._id = T2.id ORDER BY T1.lvl DESC";
        $query = $this->slave->query($sql);
        $data = $query->result();
        return $data;
    }

    public function get_name_by_id($all_cates)
    {
        $this->slave->select('*');
        $this->slave->from('ec_categories_prod');
        $this->slave->where_in('id', $all_cates);
        $result = $this->slave->get()->result();
    }

    public function product_by_single_category($cat_id = null)
    {
        $sql = "SELECT distinct pc.post_id AS product_id FROM ec_product_categories pc
                JOIN products p ON p.id = pc.post_id
                LEFT JOIN ec_vendor v ON v.vendor_id = p.vendor_id
                WHERE pc.category_id = $cat_id
                  AND p.status = '1'
                  AND (p.vendor_id = 0 OR p.vendor_id IS NULL OR CAST(v.status AS CHAR) IN ('1', 'approved', 'Approved'))
                limit 10";
        $query = $this->slave->query($sql);
        $data = $query->result();
        return $data;
    }

    public function categories_all_strip()
    {
        $data = array();
        $catdata = $this->Query_model->get_data('ec_categories_prod', array('parent_id' => '0', 'status' => '1'));
        $cnt = 0;
        foreach ($catdata as $catdata_list) {
            $cnt++;
            $catdata_list->thumbnail = isset($catdata_list->thumbnail) ? base_url() . 'assets/categories/' . $catdata_list->thumbnail : base_url() . 'assets/images/no-image.png';
            $catdata_list->banner_image = isset($catdata_list->banner_image) ? base_url() . 'assets/categories/' . $catdata_list->banner_image : base_url() . 'assets/images/no-image.png';
            $data['all_cat'][] = $catdata_list;
            if ($cnt <= 6) {
                $data['five_cat'][] = $catdata_list;
            } else if ($cnt > 6 || $cnt <= 13) {
                $data['five_greater'][] = $catdata_list;
            }

        }
        return $data;
    }

    public function get_vendor_list($table_name, $condition = NULL, $order = NULL, $limit = NULL)
    {
        // Removed supplier_id select as it likely doesn't exist
        $this->slave->select('*');
        $this->slave->from($table_name);
        if ($condition) {
            foreach ($condition as $column => $value) {
                if (is_array($value)) {
                    $this->slave->where_in($column, $value);
                } else {
                    $this->slave->where($column, $value);
                }
            }
        }
        if ($order) {
            foreach ($order as $column => $value) {
                $this->slave->order_by($column, $value);
            }
        }
        if ($limit) {
            if (isset($limit['start'])) {
                $this->slave->limit($limit['length'], $limit['start']);
            } else {
                $this->slave->limit($limit['length']);
            }
        }

        $obj = $this->slave->get()->result();
        return $obj;
    }

    // --- LEGACY DATATABLES (PRIVATE) ---
    private $table = 'products';
    private $column_order = ['id', 'name', 'status'];
    private $column_searchp = ['name'];
    private $order = ['id' => 'desc'];

    private function _get_datatables_query()
    {
        $this->slave->from($this->table);

        // ── Built-in DataTables global search ──────────────────────────────
        $dt_search = !empty($_POST['search']['value']) ? trim($_POST['search']['value']) : '';
        $i = 0;
        foreach ($this->column_searchp as $item) {
            if ($dt_search !== '') {
                if ($i === 0) {
                    $this->slave->group_start();
                    $this->slave->like($item, $dt_search);
                } else {
                    $this->slave->or_like($item, $dt_search);
                }
                if (count($this->column_searchp) - 1 === $i) {
                    $this->slave->group_end();
                }
            }
            $i++;
        }

        // ── Quick-search bar: #searchName sends d.name ──────────────────────
        $name_search = isset($_POST['name']) ? trim($_POST['name']) : '';
        if ($name_search !== '' && strlen($name_search) >= 2) {
            $this->slave->like('name', $name_search);
        }

        // ── Filter modal: #product_name sends d.post_title ──────────────────
        // Only apply when quick search is not already filtering the same column.
        $post_title_search = isset($_POST['post_title']) ? trim($_POST['post_title']) : '';
        if ($post_title_search !== '' && $name_search === '') {
            $this->slave->like('name', $post_title_search);
        }

        // ── Status filter: #enabled sends d.enabled ─────────────────────────
        $enabled = isset($_POST['enabled']) ? trim($_POST['enabled']) : '';
        if ($enabled !== '') {
            $this->slave->where('status', $enabled);
        }

        // ── Date filter: #date sends d.modified ─────────────────────────────
        $modified = isset($_POST['modified']) ? trim($_POST['modified']) : '';
        if ($modified !== '') {
            $this->slave->like('date_added', $modified);
        }

        // ── Ordering ─────────────────────────────────────────────────────────
        if (isset($_POST['order'])) {
            $col_index = (int)$_POST['order']['0']['column'];
            $col_dir   = in_array(strtolower($_POST['order']['0']['dir']), ['asc','desc']) ? $_POST['order']['0']['dir'] : 'desc';
            if (isset($this->column_order[$col_index])) {
                $this->slave->order_by($this->column_order[$col_index], $col_dir);
            }
        } elseif ($this->order) {
            $this->slave->order_by(key($this->order), $this->order[key($this->order)]);
        }
    }

    public function get_datatables()
    {
        $this->_get_datatables_query();
        if ($_POST['length'] !== -1)
            $this->slave->limit($_POST['length'], $_POST['start']);

        return $this->slave->get()->result();
    }

    public function count_filteredp()
    {
        $this->_get_datatables_query();
        return $this->slave->get()->num_rows();
    }

    public function count_allp()
    {
        $this->slave->from($this->table);
        return $this->slave->count_all_results();
    }
}