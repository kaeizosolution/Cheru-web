<?php if (!defined('BASEPATH'))
    exit('No direct script access allowed');

class Product_model extends MY_Model
{

    // FIX: Updated to match your DB
    var $column_search = array('name', 'date_added', 'status');
    var $column_alias = array();

    function __construct()
    {
        parent::__construct();

        $type = $this->session->userdata('type');
        $session_data = $this->session->userdata($type);

        if ($type == 'vendor') {
            // Logic for Vendor Panel
            $this->login_id = isset($session_data['login_id']) ? (int) $session_data['login_id'] : (isset($session_data['vendor_id']) ? (int) $session_data['vendor_id'] : 0);
        } else {
            // Logic for Customer Panel (Keeping original key)
            $this->login_id = isset($session_data['login_id']) ? $session_data['login_id'] : 0;
        }
    }

    public function insertProduct($data)
    {
        $insert_id = $this->Query_model->insert_data('products', $data);
        return $insert_id;
    }

    public function updateProduct($id, $data)
    {
        $status = $this->Query_model->update_data('products', $data, ['id' => $id]);
        return $id;
    }

    public function get_new_product($id)
    {
        $id = (int) $id;
        if ($id <= 0) {
            return null;
        }
        $this->slave->select('p.*');
        $this->slave->from('products p');
        $this->slave->join('ec_vendor v_check', 'v_check.vendor_id = p.vendor_id', 'left');
        $this->slave->where('p.id', $id);
        $this->slave->group_start()
            ->where('p.status', '1')
            ->or_where('p.status', 'active')
            ->or_where('p.status', 'Active')
        ->group_end();
        $this->slave->group_start()
            ->where('p.vendor_id', 0)
            ->or_where('p.vendor_id IS NULL', null, false)
            ->or_where("CAST(v_check.status AS CHAR) IN ('1', 'approved', 'Approved')", null, false)
        ->group_end();
        $this->slave->limit(1);
        $row = $this->slave->get()->row();
        return $row ? $row : null;
    }

    public function get_new_products_page($page = 1, $per_page = 12, $q = '', $category_ctx = null, $sorting = null, $brand_ids = null, $price_from = null, $price_to = null, $vendor_id = null)
    {
        $page = (int) $page;
        $per_page = (int) $per_page;
        if ($page < 1) {
            $page = 1;
        }
        if ($per_page < 1) {
            $per_page = 12;
        }
        if ($per_page > 100) {
            $per_page = 100;
        }

        $q = trim((string) $q);

        $pf = ($price_from !== null && $price_from !== '') ? (float)$price_from : null;
        $pt = ($price_to !== null && $price_to !== '') ? (float)$price_to : null;
        if ($pf !== null && $pt !== null && $pt > 0 && $pf > $pt) {
            $tmp = $pf;
            $pf = $pt;
            $pt = $tmp;
        }

        // Base price per variation: choose row with smallest min_qty
        $price_sql = "SELECT pp.variation_id, pp.price
            FROM product_variation_price pp
            JOIN (
                SELECT variation_id, MIN(COALESCE(min_qty,0)) AS min_qty
                FROM product_variation_price
                GROUP BY variation_id
            ) x ON x.variation_id = pp.variation_id AND COALESCE(pp.min_qty,0) = x.min_qty";

        $rating_sql = "SELECT product_id, AVG(rating) AS avg_rating, COUNT(review_rating_id) AS review_count
            FROM ec_review_rating
            WHERE status = '1'
            GROUP BY product_id";

        $this->slave->select('p.id, p.name, p.slug, p.description, p.product_type, p.category, p.sub_category, p.sub_sub_category, p.stock, p.video_path, p.vendor_id');
        $this->slave->select('MIN(img.id) AS first_image_id, SUBSTRING_INDEX(GROUP_CONCAT(img.image_path ORDER BY img.id ASC SEPARATOR ","), ",", 1) AS first_image_path', false);
        $this->slave->select('MIN(pr.price) AS min_price', false);
        $this->slave->select('MAX(pr.price) AS max_price', false);
        $this->slave->select('COALESCE(rt.avg_rating, 0) AS avg_rating, COALESCE(rt.review_count, 0) AS review_count', false);
        $this->slave->from('products p');
        $this->slave->join('ec_vendor v_check', 'v_check.vendor_id = p.vendor_id', 'left');
        $this->slave
            ->group_start()
                ->where('p.status', '1')
                ->or_where('p.status', 'active')
                ->or_where('p.status', 'Active')
            ->group_end();
        $this->slave->group_start()
            ->where('p.vendor_id', 0)
            ->or_where('p.vendor_id IS NULL', null, false)
            ->or_where("CAST(v_check.status AS CHAR) IN ('1', 'approved', 'Approved')", null, false)
        ->group_end();
        $vendor_id_int = ($vendor_id !== null && $vendor_id !== '') ? (int)$vendor_id : 0;
        if ($vendor_id_int > 0) {
            $this->slave->where('p.vendor_id', $vendor_id_int);
        }
        if ($brand_ids !== null) {
            $vals = is_array($brand_ids) ? $brand_ids : [$brand_ids];
            $vals = array_values(array_unique(array_filter(array_map(function($v){ return (int)$v; }, $vals), function($v){ return $v > 0; })));
            if ($vals) {
                $this->slave->where_in('p.brand_id', $vals);
            }
        }
        if ($q !== '') {
            $this->slave->like('p.name', $q);
        }
		if ($category_ctx !== null) {
			$vals = is_array($category_ctx) ? $category_ctx : [$category_ctx];
			$vals = array_values(array_unique(array_filter(array_map(function($v){ return (string)$v; }, $vals), function($v){ return $v !== ''; })));
			if ($vals) {
				$this->slave->group_start();
				foreach($vals as $v){
					if (is_numeric($v)) {
						$this->slave->or_where('p.category', $v);
						$this->slave->or_where('p.sub_category', $v);
						$this->slave->or_where('p.sub_sub_category', $v);
					} else {
						$this->slave->or_like('p.category', $v);
						$this->slave->or_like('p.sub_category', $v);
						$this->slave->or_like('p.sub_sub_category', $v);
					}
				}
				$this->slave->group_end();
			}
		}
        $this->slave->join('product_variations v', 'v.product_id = p.id', 'left');
        $this->slave->join('product_variation_images img', 'img.variation_id = v.id', 'left');
        $this->slave->join("($price_sql) pr", 'pr.variation_id = v.id', 'left', false);
        $this->slave->join("($rating_sql) rt", 'rt.product_id = p.id', 'left', false);
        $this->slave->group_by('p.id');

        if ($pf !== null) {
            $this->slave->having('MIN(pr.price) >= '.$this->slave->escape($pf), null, false);
            if ($pt !== null && $pt > 0) {
                $this->slave->having('MIN(pr.price) <= '.$this->slave->escape($pt), null, false);
            }
        } elseif ($pt !== null && $pt > 0) {
            $this->slave->having('MIN(pr.price) <= '.$this->slave->escape($pt), null, false);
        }

		$sorting_val = $sorting;
		if ($sorting_val === null || $sorting_val === '') {
			$sorting_val = 1;
		}
		$sorting_val = is_numeric($sorting_val) ? (int)$sorting_val : (string)$sorting_val;
		if ($sorting_val === 2 || $sorting_val === '2' || $sorting_val === 'low_to_high') {
			$this->slave->order_by('min_price', 'ASC', false);
			$this->slave->order_by('p.id', 'DESC');
		} elseif ($sorting_val === 3 || $sorting_val === '3' || $sorting_val === 'high_to_low') {
			$this->slave->order_by('min_price', 'DESC', false);
			$this->slave->order_by('p.id', 'DESC');
		} else {
			$this->slave->order_by('p.id', 'DESC');
		}
        		// Total: if price filter active, count grouped rows with the same HAVING
        if ($pf !== null || ($pt !== null && $pt > 0)) {
            $count_db = $this->slave->db; // keep same connection
            $sql = $this->slave->get_compiled_select('', false);
            $cnt_q = $count_db->query('SELECT COUNT(*) AS cnt FROM ('.$sql.') x');
            $cnt_row = $cnt_q ? $cnt_q->row() : null;
            $total = $cnt_row && isset($cnt_row->cnt) ? (int)$cnt_row->cnt : 0;
        } else {
            // Fast path: no price filter, use simple count
            $this->slave->reset_query();
            $this->slave->from('products p');
            $this->slave->join('ec_vendor v_check', 'v_check.vendor_id = p.vendor_id', 'left');
            $this->slave
                ->group_start()
                    ->where('p.status', '1')
                    ->or_where('p.status', 'active')
                    ->or_where('p.status', 'Active')
                ->group_end();
            $this->slave->group_start()
                ->where('p.vendor_id', 0)
                ->or_where('p.vendor_id IS NULL', null, false)
                ->or_where("CAST(v_check.status AS CHAR) IN ('1', 'approved', 'Approved')", null, false)
            ->group_end();
			if ($vendor_id_int > 0) {
				$this->slave->where('p.vendor_id', $vendor_id_int);
			}
            if ($brand_ids !== null) {
                $vals = is_array($brand_ids) ? $brand_ids : [$brand_ids];
                $vals = array_values(array_unique(array_filter(array_map(function($v){ return (int)$v; }, $vals), function($v){ return $v > 0; })));
                if ($vals) {
                    $this->slave->where_in('p.brand_id', $vals);
                }
            }
            if ($q !== '') {
                $this->slave->like('p.name', $q);
            }
			if ($category_ctx !== null) {
				$vals = is_array($category_ctx) ? $category_ctx : [$category_ctx];
				$vals = array_values(array_unique(array_filter(array_map(function($v){ return (string)$v; }, $vals), function($v){ return $v !== ''; })));
				if ($vals) {
					$this->slave->group_start();
					foreach($vals as $v){
						if (is_numeric($v)) {
							$this->slave->or_where('p.category', $v);
							$this->slave->or_where('p.sub_category', $v);
							$this->slave->or_where('p.sub_sub_category', $v);
						} else {
							$this->slave->or_like('p.category', $v);
							$this->slave->or_like('p.sub_category', $v);
							$this->slave->or_like('p.sub_sub_category', $v);
						}
					}
					$this->slave->group_end();
				}
			}
            $total = (int) $this->slave->count_all_results();

            // Rebuild items query after reset
            $this->slave->select('p.id, p.name, p.description, p.product_type, p.category, p.sub_category, p.sub_sub_category, p.stock, p.video_path, p.vendor_id');
            $this->slave->select('MIN(img.id) AS first_image_id, SUBSTRING_INDEX(GROUP_CONCAT(img.image_path ORDER BY img.id ASC SEPARATOR ","), ",", 1) AS first_image_path', false);
            $this->slave->select('MIN(pr.price) AS min_price', false);
            $this->slave->select('MAX(pr.price) AS max_price', false);
            $this->slave->select('COALESCE(rt.avg_rating, 0) AS avg_rating, COALESCE(rt.review_count, 0) AS review_count', false);
            $this->slave->from('products p');
            $this->slave->join('ec_vendor v_check', 'v_check.vendor_id = p.vendor_id', 'left');
            $this->slave
                ->group_start()
                    ->where('p.status', '1')
                    ->or_where('p.status', 'active')
                    ->or_where('p.status', 'Active')
                ->group_end();
            $this->slave->group_start()
                ->where('p.vendor_id', 0)
                ->or_where('p.vendor_id IS NULL', null, false)
                ->or_where("CAST(v_check.status AS CHAR) IN ('1', 'approved', 'Approved')", null, false)
            ->group_end();
			if ($vendor_id_int > 0) {
				$this->slave->where('p.vendor_id', $vendor_id_int);
			}
            if ($brand_ids !== null) {
                $vals = is_array($brand_ids) ? $brand_ids : [$brand_ids];
                $vals = array_values(array_unique(array_filter(array_map(function($v){ return (int)$v; }, $vals), function($v){ return $v > 0; })));
                if ($vals) {
                    $this->slave->where_in('p.brand_id', $vals);
                }
            }
            if ($q !== '') {
                $this->slave->like('p.name', $q);
            }
			if ($category_ctx !== null) {
				$vals = is_array($category_ctx) ? $category_ctx : [$category_ctx];
				$vals = array_values(array_unique(array_filter(array_map(function($v){ return (string)$v; }, $vals), function($v){ return $v !== ''; })));
				if ($vals) {
					$this->slave->group_start();
					foreach($vals as $v){
						if (is_numeric($v)) {
							$this->slave->or_where('p.category', $v);
							$this->slave->or_where('p.sub_category', $v);
							$this->slave->or_where('p.sub_sub_category', $v);
						} else {
							$this->slave->or_like('p.category', $v);
							$this->slave->or_like('p.sub_category', $v);
							$this->slave->or_like('p.sub_sub_category', $v);
						}
					}
					$this->slave->group_end();
				}
			}
            $this->slave->join('product_variations v', 'v.product_id = p.id', 'left');
            $this->slave->join('product_variation_images img', 'img.variation_id = v.id', 'left');
            $this->slave->join("($price_sql) pr", 'pr.variation_id = v.id', 'left', false);
            $this->slave->join("($rating_sql) rt", 'rt.product_id = p.id', 'left', false);
            $this->slave->group_by('p.id');

			// Re-apply sorting after reset_query() + rebuild
			if ($sorting_val === 2 || $sorting_val === '2' || $sorting_val === 'low_to_high') {
				$this->slave->order_by('min_price', 'ASC', false);
				$this->slave->order_by('p.id', 'DESC');
			} elseif ($sorting_val === 3 || $sorting_val === '3' || $sorting_val === 'high_to_low') {
				$this->slave->order_by('min_price', 'DESC', false);
				$this->slave->order_by('p.id', 'DESC');
			} else {
				$this->slave->order_by('p.id', 'DESC');
			}
        }

        $this->slave->limit($per_page, ($page - 1) * $per_page);
        $items = $this->slave->get()->result();

        return [
            'total' => $total,
            'items' => $items ? $items : [],
            'page' => $page,
            'per_page' => $per_page,
        ];
    }

    public function get_variation_price_tiers($variation_ids)
    {
        if (!is_array($variation_ids) || !$variation_ids) {
            return [];
        }
        $ids = [];
        foreach ($variation_ids as $vid) {
            $vid = (int) $vid;
            if ($vid > 0) {
                $ids[] = $vid;
            }
        }
        $ids = array_values(array_unique($ids));
        if (!$ids) {
            return [];
        }

        $rows = $this->slave
            ->select('variation_id, min_qty, max_qty, price')
            ->from('product_variation_price')
            ->where_in('variation_id', $ids)
            ->order_by('variation_id', 'ASC')
            ->order_by('COALESCE(min_qty,0)', 'ASC', false)
            ->get()->result();

        $out = [];
        if ($rows) {
            foreach ($rows as $r) {
                $vid = isset($r->variation_id) ? (int) $r->variation_id : 0;
                if ($vid <= 0) {
                    continue;
                }
                if (!isset($out[$vid])) {
                    $out[$vid] = [];
                }
                $out[$vid][] = [
                    'min_qty' => isset($r->min_qty) ? (int) $r->min_qty : null,
                    'max_qty' => isset($r->max_qty) ? (int) $r->max_qty : null,
                    'price' => isset($r->price) && $r->price !== null ? number_format((float) $r->price, 2, '.', '') : null,
                ];
            }
        }
        return $out;
    }

    function category_item_exist()
    {
        $this->slave->select('cp.*');
        $this->slave->from('ec_categories_prod as cp');
        // FIX: product_id -> id
        $this->slave->join('products as p', 'p.category_id = cp.id', 'inner');
        $this->slave->where('cp.parent_id', '0');
        $this->slave->where('cp.status', '1');
        $this->slave->group_by('cp.id');

        return $this->slave->get()->result();
    }

    // --- EXPORT FUNCTION ---
    public function get_export($supplier_id = NULL)
    {
        $this->slave->select('*');
        $this->slave->from('products');
        // FIX: product_id -> id
        $this->slave->order_by('id', 'desc');
        if ($this->session->userdata('type') === 'vendor' && $this->login_id) {
            $this->slave->where('login_id', $this->login_id);
        }

        $result = $this->slave->get()->result();
        $i = 0;
        $data_arr = array();
        foreach ($result as $data) {
            // FIX: Safe mapping to your DB columns
            $data_arr[$i]['product_id'] = $data->id;
            $data_arr[$i]['product_uid'] = isset($data->product_uid) ? $data->product_uid : '';
            $data_arr[$i]['post_title'] = $data->name;

            // Safe checks
            $data_arr[$i]['post_title_es'] = '';
            $data_arr[$i]['post_content'] = isset($data->description) ? $data->description : '';
            $data_arr[$i]['sale_price'] = isset($data->price) ? $data->price : 0;
            $data_arr[$i]['sku'] = isset($data->sku) ? $data->sku : '';
            $data_arr[$i]['stock'] = isset($data->stock) ? $data->stock : 0;
            $data_arr[$i]['created'] = $data->date_added;

            $i++;
        }
        return $data_arr;
    }

    // --- DATATABLES ---
    public function get_datatable($login_id = NULL)
    {
        $this->slave->select('*');
        $this->slave->from('products');
        if ($this->session->userdata('type') === 'vendor') {
            $vid = $login_id !== NULL ? (int) $login_id : (int) $this->login_id;
            if ($vid) {
                $this->slave->where('vendor_id', $vid);
            }
        }

        $this->get_datatables_query();
        // FIX: product_id -> id
        $this->slave->order_by('id', 'desc');

        if (isset($_POST['length']) && $_POST['length'] != -1)
            $this->slave->limit($_POST['length'], $_POST['start']);

        $user = $this->slave->get()->result();
        return $user;
    }

    public function get_datatables_query()
    {
        if (isset($_POST['filter'])) {
            $this->slave->group_start();
            foreach ($_POST['filter'] as $col_name => $col_value) {
                if (in_array($col_name, $this->column_search) && (is_array($col_value) || $col_value != '')) {
                    $column_name_alias = $col_name;
                    if (isset($this->column_alias[$col_name])) {
                        $column_name_alias = $this->column_alias[$col_name] . "." . $col_name;
                    }
                    if (is_array($col_value)) {
                        $this->slave->where_in($column_name_alias, $col_value);
                    } else {
                        $this->slave->like($column_name_alias, $col_value);
                    }
                }
            }
            $this->slave->group_end();
        }
    }

    public function count_filtered($login_id = NULL)
    {
        $this->slave->select('COUNT(*) CNT');
        $this->slave->from('products');
        if ($this->session->userdata('type') === 'vendor') {
            $vid = $login_id !== NULL ? (int) $login_id : (int) $this->login_id;
            if ($vid) {
                $this->slave->where('vendor_id', $vid);
            }
        }
        $this->get_datatables_query();
        $query = $this->slave->get()->row();
        return $query->CNT;
    }

    public function count_all($login_id = NULL)
    {
        $this->slave->select('COUNT(*) CNT');
        $this->slave->from('products');
        if ($this->session->userdata('type') === 'vendor') {
            $vid = $login_id !== NULL ? (int) $login_id : (int) $this->login_id;
            if ($vid) {
                $this->slave->where('vendor_id', $vid);
            }
        }
        $query = $this->slave->get()->row();
        return $query->CNT;
    }

    public function edit($product_id)
    {
        $this->slave->select('*');
        $this->slave->from('products');
        // FIX: product_id -> id
        $this->slave->where("id='" . $product_id . "'");
        $postArray = $this->slave->get()->row();
        return $postArray;
    }

    public function delete_post($product_id)
    {
        // FIX: product_id -> id
        $this->master->where('id', $product_id);
        $status = $this->master->delete('products');
        return ($this->master->affected_rows() > 0) ? TRUE : FALSE;
    }

    public function delete_image($id, $product_id)
    {
        $this->master->where('id', $id);
        $this->master->where('product_id', $product_id);
        $status = $this->master->delete('ec_gallery');
        return ($this->master->affected_rows() > 0) ? TRUE : FALSE;
    }

    public function delete_image_variation($id, $product_id)
    {
        $this->master->where('variation_id', $id);
        $this->master->where('product_id', $product_id);
        $status = $this->master->delete('ec_product_variation');
        return ($this->master->affected_rows() > 0) ? TRUE : FALSE;
    }

    public function delete_variation_post($attr_item_id, $product_id)
    {
        $this->master->where('attribute_item_id', $attr_item_id);
        $this->master->where('product_id', $product_id);
        $status = $this->master->delete('ec_product_variation');
        return ($this->master->affected_rows() > 0) ? TRUE : FALSE;
    }

    function delete_cart($id)
    {
        // Fixed table name ec_orders
        $this->master->delete('ec_orders', array('id' => $id));
        // Fixed table name ec_order_items
        $this->master->delete('ec_order_items', array('id' => $id));
        return ($this->master->affected_rows() > 0) ? TRUE : FALSE;
    }

    public function get_attr_item($product_id = null)
    {
        $sql = "select a.*,b.attribute_id, c.name as attribute_name, b.name 
            from ec_product_attribute a,ec_attribute_item b,ec_attribute c 
            where a.attribute_item_id = b.attribute_item_id and c.attribute_id=b.attribute_id and a.product_id=$product_id";
        $query = $this->slave->query($sql);
        $data = $query->result();
        return $data;
    }

    public function get_variation_bundle($product_id)
    {
        $product_id = (int) $product_id;
        if ($product_id <= 0) {
            return [];
        }

        // Base price per variation: choose the row with the smallest min_qty (fallback to 0)
        $price_sql = "SELECT pp.variation_id, pp.price
            FROM product_variation_price pp
            JOIN (
                SELECT variation_id, MIN(COALESCE(min_qty,0)) AS min_qty
                FROM product_variation_price
                GROUP BY variation_id
            ) x ON x.variation_id = pp.variation_id AND COALESCE(pp.min_qty,0) = x.min_qty";

        $sql = "SELECT v.id AS variation_id,
                       v.product_id,
                       v.attr_json,
                       v.stock,
                       pr.price,
                       GROUP_CONCAT(img.image_path ORDER BY img.id ASC SEPARATOR ',') AS images
                FROM product_variations v
                LEFT JOIN ($price_sql) pr ON pr.variation_id = v.id
                LEFT JOIN product_variation_images img ON img.variation_id = v.id
                WHERE v.product_id = ?
                GROUP BY v.id
                ORDER BY v.id ASC";

        $q = $this->slave->query($sql, [$product_id]);
        $rows = $q ? $q->result() : [];
        return $rows ? $rows : [];
    }

    public function taglist($product_id = null)
    {
