    public function get_data_by_termid($termid = null)
    {
        $sql = "SELECT products.* FROM products
            LEFT JOIN ec_vendor v_check ON v_check.vendor_id = products.vendor_id
            LEFT JOIN ec_product_categories
            ON ec_product_categories.post_id = products.id
            WHERE ec_product_categories.category_id=$termid
              AND (products.status = '1' OR products.status = 'active' OR products.status = 'Active')
              AND (products.vendor_id = 0 OR products.vendor_id IS NULL OR v_check.status = 1 OR v_check.status = '1' OR v_check.status = 'approved' OR v_check.status = 'Approved')";
        $query = $this->slave->query($sql);
        $data = $query->result();
        return $data;
    }

    public function get_data_by_tagid($tagid = null)
    {
        $sql = "SELECT products.* FROM ec_product_tags
            LEFT JOIN products
            ON ec_product_tags.post_id = products.id
            LEFT JOIN ec_vendor v_check ON v_check.vendor_id = products.vendor_id
            WHERE ec_product_tags.tag_id=$tagid
              AND (products.status = '1' OR products.status = 'active' OR products.status = 'Active')
              AND (products.vendor_id = 0 OR products.vendor_id IS NULL OR v_check.status = 1 OR v_check.status = '1' OR v_check.status = 'approved' OR v_check.status = 'Approved')";
        $query = $this->slave->query($sql);
        $data = $query->result();
        return $data;
    }

    public function Does_email_exists($email)
