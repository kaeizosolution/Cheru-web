    // --- FRONTEND / EXTRA FUNCTIONS ---

    public function get_product_info($args)
    {
        $product_obj = $args['product_obj'];
        $cur = current_currency();
        $currency = get_currency($cur);
        $rate = $currency->rate;
        $symbol = $currency->symbol;

        $product_obj->symbol = $symbol;
        $product_obj->iso_code = $currency->iso_code;

        // FIX: Map 'name' to 'post_title' for compatibility
        $product_obj->post_title = $product_obj->name;
        // Fix: content
        $product_obj->post_content = isset($product_obj->description) ? $product_obj->description : '';

        // FIX: product_id -> id
        $product_id_val = $product_obj->id;

        // Ensure type exists, default to simple
        $type = isset($product_obj->type) ? $product_obj->type : 'simple';

        if ($type == 'simple') {
            $product_gallery = $this->Query_model->get_data_obj('ec_gallery', array('product_id' => $product_id_val), array(), array('length' => 1));
            if ($product_gallery) {
                $productimg = base_url() . 'assets/uploads/files/' . $product_gallery->file_name;
            } else {
                $productimg = base_url() . 'assets/default_images/product.jpg';
            }
        } else {
            $variation_obj = $this->Query_model->get_data_obj('ec_product_variation', array('product_id' => $product_id_val), array(), array('length' => 1));
            if ($variation_obj) {
                $productimg = base_url() . 'assets/uploads/' . $variation_obj->_thumbnail_id;
                $product_obj->sale_price = $variation_obj->_sale_price;
                $product_obj->regular_price = $variation_obj->_regular_price;
            } else {
                $productimg = base_url() . 'assets/default_images/product.jpg';
            }
        }

        $regular = null;
        $sale = null;
        if (isset($product_obj->prices) && $product_obj->prices) {
            $prices = json_decode($product_obj->prices, true);
            if (is_array($prices) && isset($prices[0]) && is_array($prices[0])) {
                $p0 = $prices[0];
                if (isset($p0['regular_price']) && $p0['regular_price'] !== '') {
                    $regular = (float)$p0['regular_price'];
                }
                if (isset($p0['sales_price']) && $p0['sales_price'] !== '') {
                    $sale = (float)$p0['sales_price'];
                }
            }
        }
        if ($regular === null && isset($product_obj->regular_price)) {
            $regular = (float)$product_obj->regular_price;
        }
        if ($sale === null && isset($product_obj->sale_price)) {
            $sale = (float)$product_obj->sale_price;
        }
        if ($regular === null) {
            $regular = 0;
        }
        if ($sale === null || $sale <= 0) {
            $sale = $regular;
        }
        $prod_currency_id = isset($product_obj->currency_id) && $product_obj->currency_id !== '' ? (int)$product_obj->currency_id : 1;
        $product_obj->regular_price = sprintf('%.02f', convert_price($regular, $prod_currency_id, $cur));
        $product_obj->sale_price = sprintf('%.02f', convert_price($sale, $prod_currency_id, $cur));

        $product_obj->url = detail_page_url($product_obj);
        $product_obj->featured_image = $productimg;

        // Pass ID as product_id for compatibility
        $product_obj->product_id = $product_id_val;

        return $product_obj;
    }

    public function get_category($product_id)
    {
        $product_id = (int) $product_id;
        if (!$product_id) {
            return array();
        }

        $product = $this->Query_model->get_data_obj('products', array('id' => $product_id), array(), array('length' => 1));
        if (!$product) {
            return array();
        }

        $cat_ids = array();
        if (isset($product->category_id) && $product->category_id) {
            $cat_ids[] = (int) $product->category_id;
        }
        if (isset($product->sub_cat_id) && $product->sub_cat_id) {
            $cat_ids[] = (int) $product->sub_cat_id;
        }
        $cat_ids = array_values(array_unique(array_filter($cat_ids)));
        if (!$cat_ids) {
            return array();
        }

        $cats = $this->Query_model->get_data('ec_categories_prod', array('id' => $cat_ids), array('parent_id' => 'ASC', 'id' => 'ASC'));
        return $cats ? $cats : array();
    }

    public function featured_product($length = NULL)
    {
        if (!$length)
            $length = 6;
        $this->slave->select('products.*');
        $this->slave->from('products');
        $this->slave->join('ec_vendor v_check', 'v_check.vendor_id = products.vendor_id', 'left');
        $this->slave->where('products.status', '1');
        $this->slave->group_start()
            ->where('products.vendor_id', 0)
            ->or_where('products.vendor_id IS NULL', null, false)
            ->or_where("CAST(v_check.status AS CHAR) IN ('1', 'approved', 'Approved')", null, false)
        ->group_end();
        $this->slave->order_by('products.id', 'desc');
        $this->slave->limit($length);
        $obj = $this->slave->get()->result();

        if ($obj) {
            foreach ($obj as $product_obj) {
                $this->get_product_info(array('product_obj' => $product_obj));
            }
        }
        return $obj;
    }

    public function new_arrivals($length = NULL)
    {
        if (!$length)
            $length = 6;

        $res = $this->get_new_products_page(1, (int)$length, '');
        $rows = $res['items'] ?? [];
        $out = [];
        if ($rows) {
            foreach ($rows as $r) {
                if (!is_object($r)) {
                    continue;
                }
                $img_path = isset($r->first_image_path) ? trim((string)$r->first_image_path) : '';
                $imgs = $img_path !== '' ? json_encode([basename($img_path)]) : '';
                $min_price = isset($r->min_price) && $r->min_price !== null ? (float)$r->min_price : 0;
                $prices = json_encode([
                    ['regular_price' => $min_price, 'sale_price' => $min_price, 'sales_price' => $min_price]
                ]);
                $out[] = (object)[
                    'id' => (int)($r->id ?? 0),
                    'name' => (string)($r->name ?? ''),
                    'images' => $imgs,
                    'prices' => $prices,
                    'status' => '1',
                ];
            }
        }
        return $out;
    }

