$('.detect_my_loc').click(function(){
	get_geoloc();
});

function get_geoloc()
{
	if(navigator.geolocation)
	{
        navigator.geolocation.getCurrentPosition(showLocation);
    }
	else
	{ 
        //$('#location').html('Geolocation is not supported by this browser.');
    }
}

function showLocation(position){
	$('.detect_my_loc_wait').show(); $('.detect_my_loc').hide();
	var postData = {};
	postData[csrf.name] 	= csrf.hash;
	postData['latitude'] 	= position.coords.latitude;
	postData['longitude']	= position.coords.longitude;
	postData['place_id']	= position.coords.place_id;

	var request = $.ajax({
      url: "/welcome/getLocation",
      type: "POST",
      data: postData,
      dataType: "json"
    });

	request.done(function(resp) {
		$('.detect_my_loc_wait').hide(); $('.detect_my_loc').show();
		if(resp.STATUS)
		{
			$('.is_loc_filled').html(resp.DATA.display_address);
			$('.delivery_loc').html(resp.DATA.display_address);
			$('.dropdown_loc').hide();
			window.location.reload();	
				
		}
	});

	request.fail(function(jqXHR, textStatus) {
		$('.detect_my_loc_wait').hide(); $('.detect_my_loc').show();
    });

}

function search_loc_func() {

$('#search_loc').typeahead(
{
	autoSelect:false,
	source: function(query, process) {
            return $.ajax({
                url: '/welcome/search_loc',
                type: 'get',
                data: {query: query},
                dataType: 'json',
				beforeSend: function(){
        			$('.search_loading').show();
    			},
    			complete: function(){
        			$('.search_loading').hide();
    			},
                success: function(json) {
				$('.search_loading').hide();			
				return typeof json == 'undefined' ? false : process(json);
                }
            });
        },
        highlight: true,
        minLength: 3,
        afterSelect: function(item){
		get_add(item);
        }
    }
);

}


function get_add(item)
{
	var argsData = {};
    var place_id = item.place_id ? item.place_id : '';
	argsData['coords'] = {'latitude':item.lat, 'longitude':item.long, 'place_id':place_id};
	
	showLocation(argsData);
	$('#search_loc').val('');
}



