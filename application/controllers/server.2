function make_url()
{
    var url = ftsStr = ftsStr = lmyStr = '';
    ftsStr = $('#fts').val();
    $('#fts_hidden').val(ftsStr);
    localStorage.setItem('fts',ftsStr);
    ftsStr = ftsStr.replace(/\bin\b/g, '');
    ftsStr  = ftsStr.replace(/\W/g, '-');
    ftsStr = ftsStr.replace(/(-)+/g, '-');
    ftsStr = ftsStr.replace(/^-|-$/g, '');
    ftsStr = ftsStr.toLowerCase();
    if(ftsStr)
    {
        url = '/shop/'+ftsStr+"";
    }
    return url;
}



