	public function ajax_shipping_address()
	{
		$data = array();
        $condition = array('customer_id' => $this->LOGIN_ID);
        $addresslist = $this->Query_model->get_data('ec_shipping_address', $condition);
        foreach ($addresslist as $addresslistdata) 
        {
            $row = array();
            $lock_type 					= location_type();
            $row['shipping_address_id'] = $addresslistdata->shipping_address_id;
            $row['customer_id']         = $addresslistdata->customer_id;
            $row['fullname']            = isset($addresslistdata->fullname) ? $addresslistdata->fullname : 'Hi';
            $row['mobile']              = $addresslistdata->mobile;
            $row['full_address']        = $addresslistdata->address_1.', '.$addresslistdata->city.', '.$addresslistdata->street;
            $row['postcode']            = isset($addresslistdata->postcode) ? $addresslistdata->postcode :'';
            $row['address_type']	    = isset($addresslistdata->loc_type) ? ucfirst($lock_type[$addresslistdata->loc_type]) : 'N/A';
            $row['defaultaddress']      = $addresslistdata->default_address;
            $data[] = $row;
        }

        $response = array(
                'status'    => '1',
                'message'   => 'success',
                'data'      => $data
                );

        $this->output
            ->set_content_type('application/json')
            ->set_output(json_encode($response));
	}


	public function ajax_get_address_byid()
	{
		$shippaddress_id	=	$this->input->post('id');
		$condition			=	array('shipping_address_id' => $shippaddress_id);
		$data_obj 			= $this->Query_model->get_data_obj('ec_shipping_address', $condition);
		if(is_api())
		{
			api_response(array('status' => 1, 'msg' => 'Success', 'data' => [$data_obj]));
		}else
		{
			$response = array(
                'status'    => '1',
                'message'   => 'success',
                'data'      => $data_obj
                );

			$this->output
            ->set_content_type('application/json')
            ->set_output(json_encode($response));
		}
	}


	public function ajax_update_address()
	{
		$data = array();
		$customer_id = $this->LOGIN_ID;
		$this->address_validation();
	
		if($this->form_validation->run() == FALSE)
		{
			api_response(array('status'=>0, 'msg'=>'All field is mandatory', 'data'=>array()));
		}

		$shipping_address_id = $this->input->post('shipping_address_id');
		$fullname   	=  $this->input->post('name');    
		$mobile     	=  $this->input->post('mobile');         
		$address_1  	=  $this->input->post('address_1');            
		$city       	=  $this->input->post('city');     
		$postcode   	=  $this->input->post('postcode');         
		$how_to_reach	=  $this->input->post('how_to_reach');
		$loc_type		=  $this->input->post('loc_type');
		$latitude		=  $this->input->post('latitude');
		$longitude		=  $this->input->post('longitude');
		$place_id		=  $this->input->post('place_id');
    
        #if(empty($place_id))
        if(0)
        {
          api_response(array('status' => '1', 'msg' => 'Address is not valid', 'data' => array())); 
          exit; 
        }

		if($shipping_address_id){
			 $addressdata =   array('fullname'      =>  $fullname,     
                    				'mobile'        =>  $mobile,           
				                    'address_1'     =>  $address_1,            
                				    'city'          =>  $city,     
				                    'postcode'      =>  $postcode,         
				                    'loc_type'      =>  $loc_type,         
                				    'how_to_reach'  => $how_to_reach,        
                				    'latitude'      => $latitude,       
                				    'longitude'     => $longitude,        
                				    'place_id'      => $place_id       
                    				); 
 
			$condition1 = array('shipping_address_id' => $shipping_address_id);
			$address   = $this->Query_model->update_data('ec_shipping_address', $addressdata, $condition1);
			
			if($address)
			{

                api_response(array('status' => '1', 'msg' => 'Address Updated Successfully', 'data' => $address));
			}else{

                 api_response(array('status' => '0', 'msg' => 'Data not Updated Successfully', 'data' => $address));
			}
	
		}else{
		
			$addressdata =   array('fullname'       =>  $fullname,
                                    'mobile'        =>  $mobile,
                                    'address_1'     =>  $address_1,
                                    'city'          =>  $city,
                                    'postcode'      =>  $postcode,
                                    'how_to_reach'  => $how_to_reach,
                                    'loc_type'	    => $loc_type,
									'customer_id'   => $customer_id,
                                    'latitude'      => $latitude, 
                                    'longitude'     => $longitude,
                                    'place_id'      => $place_id
                                    );
			
			$data	=	$this->Query_model->insert_data('ec_shipping_address', $addressdata);
            $condition = array('shipping_address_id'=>$data, 'customer_id'=>$customer_id);
            $condition1 = array('customer_id'=>$customer_id);
            $update =   $this->Query_model->update_data('ec_shipping_address', array('default_address'=>'0'),$condition1);
            $update =   $this->Query_model->update_data('ec_shipping_address', array('default_address'=>'1'),$condition);
            
			if($data)
			{
                api_response(array('status' => '1', 'msg' => 'Address Added Successfully', 'data' => $data));
			}
		}
	
	}


