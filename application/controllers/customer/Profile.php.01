	public function ajax_get_customer_order()
    {
        $data = array();
        $data['TYPE'] = $this->TYPE;
        $data['csrf'] = csrf_token();
        $customer_id = $this->LOGIN_ID;
        $orderStatus = $this->input->post('filter') ?: ($this->input->post('orderStatus') ?: null);
        $orderlist = $this->Product_model->get_order_data($customer_id, $orderStatus);
        $data = array();

        $order_id_arr = array();
        $order_id_arr_web = array();
        if($customer_id){
            foreach ($orderlist as $row) {

                // Prefer new products table
                $product_obj = $this->Query_model->get_data_obj('products', array('id' => $row->product_id));
                if (!$product_obj) {
                    $product_obj = $this->Query_model->get_data_obj('ec_product', array('product_id' => $row->product_id));
                }
                $shipping_obj = $this->Query_model->get_data_obj('ec_shipping_address', array('shipping_address_id' => $row->shipping_address_id));
                $currency_obj = current_currency($row->currency_id);

                if($product_obj){
                    $attribute_item = array();
                    $variation_id = 0;
                    if (isset($row->options) && $row->options) {
                        $opt = json_decode((string)$row->options, true);
                        if (is_array($opt) && isset($opt['variation_id'])) {
                            $variation_id = (int)$opt['variation_id'];
                        }
                    }

                    // Determine image (new products vs legacy)
                    if (isset($product_obj->product_type)) {
                        // New products table
                        $productimg = base_url().'assets/default_images/product.jpg';
                        if ($variation_id > 0) {
                            $img = $this->db->get_where('product_variation_images', ['variation_id' => $variation_id], 1)->row();
                            if ($img && !empty($img->image_path)) {
                                $productimg = base_url().'uploads/products/'.(string)$img->image_path;
                            }
                        }
                        if ((string)$product_obj->product_type === 'variable') {
                            $attr_csv = (string)($row->attribute_item_id ?? '');
                            $attr_ids = array_filter(array_map('trim', explode(',', $attr_csv)));
                            $attr_ids = array_values(array_filter(array_map(function ($v) {
                                if (ctype_digit((string)$v)) return (int)$v;
                                return null;
                            }, $attr_ids), function ($v) { return $v !== null; }));
                            sort($attr_ids);

                            if (!empty($attr_ids)) {
                                $vars = $this->db
                                    ->select('id, attr_json')
                                    ->from('product_variations')
                                    ->where('product_id', (int)$row->product_id)
                                    ->get()->result_array();
                                $vid = 0;
                                foreach ($vars as $vr) {
                                    $vals = json_decode((string)($vr['attr_json'] ?? ''), true);
                                    if (!is_array($vals)) {
                                        continue;
                                    }
                                    $vals = array_values(array_filter(array_map(function ($x) {
                                        if (is_int($x)) return $x;
                                        if (is_string($x) && ctype_digit(trim($x))) return (int)trim($x);
                                        return null;
                                    }, $vals), function ($x) { return $x !== null; }));
                                    sort($vals);
                                    if (json_encode($vals) === json_encode($attr_ids)) {
                                        $vid = (int)($vr['id'] ?? 0);
                                        break;
                                    }
                                }
                                if ($vid > 0) {
                                    $img = $this->db->get_where('product_variation_images', ['variation_id' => $vid], 1)->row();
                                    if ($img && !empty($img->image_path)) {
                                        $productimg = base_url().'uploads/products/'.(string)$img->image_path;
                                    }
                                }
                            }
                        }
                    } else {
                        // Legacy ec_product
                        if($product_obj->type == 'simple'){
                            $product_gallery = $this->Query_model->get_data_obj('ec_gallery',array('product_id' => $row->product_id), array(), array('length' => 1));
                            if($product_gallery){
                                $productimg = base_url().'assets/uploads/files/'.$product_gallery->file_name;
                            }else{
                                $productimg = base_url().'assets/default_images/product.jpg';
                            }
                        }else{
                            $product_gallery = $this->Query_model->get_data('ec_product_variation',array('product_id' => $row->product_id, 'attribute_item_id' => $row->attribute_item_id));
                            if(isset($product_gallery[0]->_thumbnail_id)){
                                $productimg = base_url().'assets/uploads/'.$product_gallery[0]->_thumbnail_id;
                            }else{
                                $productimg = base_url().'assets/default_images/product.jpg';
                            }
                        }
                    }

                    // Attribute labels (legacy attributes table)
                    if($row->attribute_item_id){
                        $get_attribute = get_attribute();
                        $att_array = explode(',',$row->attribute_item_id);
                        if($att_array){
                            $attribute_item_obj = $this->Query_model->get_data('ec_attribute_item',array('attribute_item_id' => $att_array));
                            if($attribute_item_obj){
                                foreach($attribute_item_obj as $at){
                                    $attribute_item[$get_attribute[$at->attribute_id]][] = $at->name;
                                }
                            }
                        }
                    }

                    $rating_obj = array();
                    if($row->status == '10'){ 
                        $rating_obj = $this->Query_model->get_data('ec_review_rating', array('product_id' => $row->product_id,  'customer_id' => $customer_id));
                    //print_r($rating_obj);
                   }

                    $supplier_obj = $this->Query_model->get_data_obj('ec_admin', array('admin_id' => $row->supplier_id));

                    $unit_price = ($row->subtotal / $row->quantity);
                    $unit_price = sprintf('%.02f',$unit_price);

                    $unit_gross_price = $row->subtotal;
                    if(is_numeric($row->tax)){
                        $unit_gross_price+= $row->tax;
                    }
                    if(is_numeric($row->shipping)){
                        $unit_gross_price+=$row->shipping;
                    }
                    if(isset($row->coupon_amount) && $row->coupon_amount)
                    {
                        $unit_gross_price = $unit_gross_price - $row->coupon_amount;
                    }

                    $orderstatus        = order_status($row->status);
                    $row->iso_code      = $currency_obj->iso_code;                   
                    $row->symbol        =  htmlspecialchars_decode($currency_obj->symbol);                    
                    $row->order_id      = $row->order_id;
                    $row->order_uid     = $row->order_uid;
                    $row->product_id    = $row->product_id;
                    $row->order_item_uid= $row->order_item_uid;
                    $row->cancel_order_reason = isset($row->cancel_order_reason) ? $row->cancel_order_reason : '';
                    $row->comment       = isset($row->comment) ? $row->comment : '';
                    $row->num_items     = $row->num_items_sold;
                    if (isset($product_obj->product_type)) {
                        $row->productname = isset($product_obj->name) ? $product_obj->name : '';
                    } else {
                        $row->productname = $product_obj->post_title;
                    }
                    $row->url           = detail_page_url($product_obj);
                    $row->quantity      = $row->quantity;
                    $row->supplier      = ($supplier_obj) ? $supplier_obj->store_name : '';
                    $row->coupon_id     = isset($row->coupon_id) ? $row->coupon_id : '';
                    $row->coupon_amount = isset($row->coupon_amount) ? $row->coupon_amount :0;
                    $row->totalprice    = $row->order_total > 0  ? $row->order_total : 0;
                    $row->proprice      = $row->subtotal;
                    $row->unit_net_price= $row->subtotal;
                    $row->unit_tax      = $row->tax;
                    $row->unit_shipping = $row->shipping;
                    $row->unit_gross_price = sprintf('%.02f',$unit_gross_price);
                    $row->attribute_item_id = $row->attribute_item_id;
                    $row->attribute_item = $attribute_item;
                    $row->image         = $productimg;
                    $row->shipping_name = isset($shipping_obj->fullname) ? $shipping_obj->fullname :'';
                    $row->shipping_mobile = isset($shipping_obj->mobile) ? $shipping_obj->mobile : '';
                    $row->shipping_city = isset($shipping_obj->city) ? $shipping_obj->city : '';
                    $row->shipping_street= isset($shipping_obj->street) ? $shipping_obj->street : '';
                    $row->shipping_postcode = isset($shipping_obj->postcode) ? $shipping_obj->postcode : '';
                    //$row->shipping_country = get_country($shipping_obj->country)->name;
                    $row->orderstatus   = $orderstatus;
                    $row->rating_obj    = $rating_obj;
                    $row->delivery_date = date("d-M-Y", strtotime($row->date_created."+7 day"));
                    $row->order_date    = date("d-M-Y", strtotime($row->date_created));
                    $row->product_link  = $product_obj->post_slug;
                    $row->cancel_order_reason   = $row->cancel_order_reason;
                    $row->comment               = $row->comment;
                    $order_id_arr[]     = $row;
                    $order_id_arr_web[$row->order_id][] = $row;
                }
            }
        }

        $all_ord = [];
        foreach($order_id_arr_web as $key => $value)
        {
            $date_created = array_column($value, 'order_date');
            array_multisort($date_created, SORT_DESC, $value);
            $all_ord[$key] = $value;
        }

        #print_r($order_id_arr_web);
        if(is_api()){
        	api_response(array('status' => 1, 'msg' => 'success', 'data' => $order_id_arr));
        }else{
        	$response = array('status' => 1, 'msg' => 'success', 'data' => $order_id_arr_web);
        }
        $this->output
            ->set_content_type('application/json')
            ->set_output(json_encode($response));
    }

	public function ajax_get_wishlist_product()
    {
		$data_out = array();
		$customer_id  =  $this->LOGIN_ID;
		$condition = array('customer_id' => $customer_id, 'status' => array('0','1'));
		$productlist = $this->Query_model->get_data('ec_wishlist', $condition);

		$current_currency = current_currency();
		$currency = get_currency($current_currency);
		$rate = $currency->rate;
		$symbol = $currency->symbol;
		$ln = current_language();

		if($customer_id){
			foreach ($productlist as $wl_row) {
				$product_id = (int)$wl_row->product_id;
				$attribute_item_id = $wl_row->attribute_item_id;

				$product_obj = $this->Query_model->get_data_obj('products', array('id' => $product_id, 'status' => '1'));
				if(!$product_obj){
					continue;
				}

				$productimg = base_url().'assets/default_images/product.jpg';
				$sale_price = 0;
				$regular_price = 0;
				$discount = 0;

				$variation = $this->Query_model->get_data_obj('product_variations', array('product_id' => $product_id), array('id' => 'ASC'), array('length' => 1));
				if ($variation && isset($variation->id)) {
					$img = $this->Query_model->get_data_obj('product_variation_images', array('variation_id' => (int)$variation->id), array('id' => 'ASC'), array('length' => 1));
					if ($img && !empty($img->image_path)) {
						$productimg = base_url().'uploads/products/'.$img->image_path;
					}

					$price_row = $this->Query_model->get_data_obj('product_variation_price', array('variation_id' => (int)$variation->id), array('COALESCE(min_qty,0)' => 'ASC'), array('length' => 1));
					if ($price_row && isset($price_row->price) && $price_row->price !== null) {
						$sale_price = (float)$price_row->price;
						$regular_price = (float)$price_row->price;
					}
				}

				$row = array();
				$row['wishlist_id']       =  $wl_row->wishlist_id;
				$row['customer_id']       =  $wl_row->customer_id;
				$row['productimg']        =  $productimg;
				$row['url']               =  base_url('product/details/'.$product_id);
				$row['discount']          =  $discount;
				$row['attribute_item_id'] =  ($attribute_item_id) ? explode(',',$attribute_item_id) : array();
				$row['attribute_items']   =  array();
				$row['productname']       =  $product_obj->name;
				$row['price']             =  sprintf('%.02f',$rate*$sale_price);
				$row['sale_price']        =  sprintf('%.02f',$rate*$sale_price);
				$row['regular_price']     =  sprintf('%.02f',$rate*$regular_price);
				$row['post_content']      =  isset($product_obj->description) ? $product_obj->description : '';
				$row['symbol']            =  $symbol;
				$row['iso_code']          =  $currency->iso_code;
				$row['product_id']        =  $product_id;
				$row['date_added']        =  $wl_row->date_added;

				$data_out[] = $row;
			}
		}

		if(is_api()){
				api_response(array('status' => 1, 'msg' => 'success', 'data' => $data_out));		
		}else{

				$response = array(
								'status'    => '1',
								'message'   => 'success',
								'data'      => $data_out
						);

				$this->output
						->set_content_type('application/json')
						->set_output(json_encode($response));

		}

    }



   public function ajax_remove_wishlist_product()
   {
       $wishlist_id = $this->input->post('wishlist_id');
       $condition   = array('customer_id'=> $this->LOGIN_ID, 'wishlist_id' => $wishlist_id);
       $status      = $this->Query_model->delete_query('ec_wishlist', $condition);

       if(is_api()){
    		   api_response(array('status' => 1, 'msg' => 'Product removed successfully', 'data' => (array)$status));			
       }else{	
    		   $response = array(
    				   'status'    => '1',
    				   'message'   => 'Wishlist product removed successfully',
    				   'data'      => (array)$status
    				   );

    		   echo json_encode($response);
    		   die();
       }
   }



	public function ajax_get_track_package()
    {
        wfile($_POST);
        $data = array();
        $data['TYPE']   = $this->TYPE;
        $data['csrf']   = csrf_token();
        $customer_id    = $this->LOGIN_ID;
        $order_item_uid = $this->input->post('order_item_uid');
        $order_uid      = $this->input->post('order_uid');

		$orderstatus = array();
        $orderlistdata = $this->Product_model->get_order_item($order_uid, $order_item_uid);
        //print_r($orderlistdata); exit;
		$orderstatus['status'] = $orderlistdata->status;
		$orderstatus['orderstatus'] = order_status($orderlistdata->status);
	
		if(is_api())
		{
			$api_order_track = $this->api_order_track(array('order_status'=>$orderlistdata->status));
			api_response(array('status' => 1, 'msg' => 'success', 'data' => [$api_order_track]));
		}
		else
		{
				$response = array('status' => 1, 'msg' => 'success', 'data' => $orderstatus);
				$this->output
						->set_content_type('application/json')
						->set_output(json_encode($response));
		}

    }

	public function api_order_track($args)
	{
		$arr_name = array('Ordered' => array('title'=>'Ordered', 'status'=>0),'In Process' => array('title'=>'In Process', 'status'=>0),'Shipped' => array('title'=>'Shipped', 'status'=>0),'Out For Delivery' => array('title'=>'Out For Delivery', 'status'=>0),'Delivered'=> array('title'=>'Delivered', 'status'=>0));

		$order_item_status = order_item_status();
		$status = $args['order_status'];
		$cnt = 0;
		$arr_indx = array();
		foreach($order_item_status as $key =>$value)
		{
				$arr_indx[] = $value;
				if($key == $status)
				{
						$cnt;
						break;		
				}

				$cnt++;
		}

		for($i=0; $i<=$cnt; $i++)
		{
				$arr_name[$arr_indx[$i]]['status'] = 1;
		}
		$arr_values = [];
		foreach($arr_name as $key => $value)
		{
			$arr_values[] = $value;
		}
		return $arr_values;
	}

    public function ajax_cancel_product()
    {
        $data['csrf'] = csrf_token();
        $data['error'] = false;
        $data['type'] = '';
        $data['message']['error'] = ''; 
        $data = array();
        
        $this->load->library('form_validation');
        $this->form_validation->set_rules('order_uid', 'Order UID', 'trim|required');
        $this->form_validation->set_rules('order_item_uid', 'Order Item UID', 'trim|required');
        $this->form_validation->set_rules('cancel_order_reason', 'Cancel order reason', 'trim|required');

        if($this->form_validation->run() == false) {
            $response = array(
                'status'  => '0',
                'message' => remove_extra_for_api(validation_errors()),
                'data'    => (array)$data,
            );

            }

        $order_uid      = $this->input->post('order_uid');
        $order_item_uid = $this->input->post('order_item_uid');
        if($order_uid && $order_uid){
            $item_obj = $this->Product_model->get_order_item($order_uid,$order_item_uid);
        }
        
        if($_POST) {
            $data['status']               = 5;
            $data['cancel_order_reason']  = $this->input->post('cancel_order_reason');
            $data['comment']              = $this->input->post('comment');
        }

        if (!isset($this->LOGIN_ID) || !isset($item_obj) || $this->form_validation->run() == FALSE){
            if(!isset($this->LOGIN_ID)){
                $response = array(
                    'status' => 0,
                    'message' => 'Please login first.',
                );
            }elseif(!isset($requirement_obj)){
                $response = array(
                    'status' => 0,
                    'message' => 'Invalid Request.',
                );
            }else{
                $response = array(
                    'status' => 0,
                    'message' => validation_errors(),
                );
            }
        }else{
            $post_data = array(        
                    'status'             => $data['status'],  
                    'cancel_order_reason'=> $data['cancel_order_reason'],    
                    'comment'            => $data['comment'],
                    );

            $tax = $item_obj->tax;
            $shipping = $item_obj->shipping;
            $subtotal = $item_obj->subtotal;
            $total    = $subtotal + $tax + $shipping;
            if(isset($item_obj->coupon_amount) && $item_obj->coupon_amount)
            {
                $total = $total - $item_obj->coupon_amount;
            }
            $quantity = $item_obj->quantity;
            $attribute_item_id = $item_obj->attribute_item_id;
            $product_id = $item_obj->product_id;
            $args = array(
                    'tax'                   => $tax,
                    'shipping'              => $shipping,
                    'subtotal'              => $subtotal,
                    'coupon_amount'         => isset($item_obj->coupon_amount) && $item_obj->coupon_amount ? $item_obj->coupon_amount : 0,
                    'total'                 => $total,
                    'quantity'              => $quantity,
                    'attribute_item_id'     => $attribute_item_id,
                    'product_id'            => $product_id,
                    'order_id'              => $item_obj->order_id,
                    'order_item_id'         => $item_obj->order_item_id,
                    'type'                  => 'simple',
                    'status'                => $post_data['status'],
                    'cancel_order_reason'   => $post_data['cancel_order_reason'],
                    'comment'               => $post_data['comment'],
                );

            $product_obj = $this->Query_model->get_data_obj('ec_product',array('product_id' => $product_id));
            if($product_obj){
                if($attribute_item_id){
                    $variation_obj = $this->Query_model->get_data_obj('ec_product_variation',array('attribute_item_id' => $attribute_item_id));
                    if($variation_obj){
                        $args['type'] = 'variable';
                    }
                }
                $status = $this->Checkout_model->cancel_order($args);
                $this->session->set_flashdata('message', 'Order Cancel sucessfully.');
                $response = array(
                    'status'  => '1',
                    'message' => "Order Cancel sucessfully.",
                    'data'    => (array)$status,
                );
            }else{
                $response = array(
                    'status'  => '0',
                    'message' => "Invalid Request.",
                );
            }
        }

        if(!isset($response['data'])){
            $response['data'] = array();
        }
        $this->output
            ->set_content_type('application/json')
            ->set_output(json_encode($response));

    }


	public function ajax_add_to_review_rating()
    {
		$data = array();
        $data['TYPE'] = $this->TYPE;
        $data['csrf'] = csrf_token();
        $customer_id  = $this->LOGIN_ID;

        $this->load->library('form_validation');
        $this->form_validation->set_error_delimiters('<div class="error">', '</div>');
        $this->form_validation->set_rules('product_id', 'Product Name', 'trim|required');
		$this->form_validation->set_rules('rating', 'Rating', 'trim|required');
        $this->form_validation->set_rules('review', 'Review', 'trim|required');
        $this->form_validation->set_rules('title', 'Title', 'trim|required');

        if (!isset($this->LOGIN_ID) || $this->form_validation->run() == FALSE)
        {
            if(!isset($this->LOGIN_ID)){
				
				api_response(array('status' => '0','msg' => 'Please login first to submit the request.', 'data'=> array()));

            }else{

				api_response(array('status' => '0','msg' => remove_extra_for_api(validation_errors()), 'data'=> array()));
            }
        }else{
			
            $attribute_item     = $this->input->post('attribute_item');
            $attribute_item_id  = NULL; 
            $attribute_items = array();
            if($attribute_item){
                $attribute_items = json_decode($attribute_item);
                if($attribute_items){
                    sort($attribute_items);
                }
                $attribute_item_id = implode(',',$attribute_items);
            }

            $data['customer_id']         = $this->LOGIN_ID;
            $data['product_id']          = $this->input->post('product_id');
            $data['attribute_item_id']   = $attribute_item_id;
            $data['review']              = $this->input->post('review');
            $data['rating']              = $this->input->post('rating'); 
            $data['title']              = $this->input->post('title'); 
            $post_data = array(
                            'customer_id'       => $this->LOGIN_ID,
                            'product_id'        => $data['product_id'],
                            'attribute_item_id' => $data['attribute_item_id'],
                            'review'            => $data['review'],
                            'title'             => $data['title'],
                            'rating'            => $data['rating'],
                            );

            $get_rating = $this->Query_model->get_data_obj('ec_review_rating', array('product_id' => $post_data['product_id'], 'customer_id' => $this->LOGIN_ID));
            if($get_rating){
                $condition = array('customer_id' => $this->LOGIN_ID, 'product_id' => $post_data['product_id']);
                $lats_id = $this->Query_model->update_data('ec_review_rating', $post_data, $condition);
            }else{
								
                $lats_id = $this->Query_model->insert_data('ec_review_rating', $post_data);
            }

			api_response(array('status' => '1','msg' => 'Review and rating add sucessfully', 'data'=> array()));

        }
        
        if(!isset($response['data'])){
            $response['data'] = array();
        } 
        $this->output
            ->set_content_type('application/json')
            ->set_output(json_encode($response));

    }

