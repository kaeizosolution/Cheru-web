                $msg  = 'Successfully Update.';
                $data = array($data);
	            
				api_response(array('status' => '1', 'msg' => $msg, 'data' => $data));

				}
		
            }
    }


    public function update_detail($args)
    {
        $update_data = $args['DATA'];
        unset($update_data['id']); unset($update_data['api']);

        if(isset($update_data['password']) && $update_data['password']){
                $update_data['password'] = md5($update_data['password']);
         }
         else
        {
            unset($update_data['password']);
        }

        $condition = array('customer_id' => $this->LOGIN_ID);
        $status    =  $this->Query_model->update_data('ec_customer',$update_data,$condition);
        $user_id   = $this->LOGIN_ID;
        $this->profile_img($user_id); 
        return $status;
    }


    public function validation($data_obj)
    {
        $this->load->library('form_validation');
        $this->form_validation->set_error_delimiters('<div class="error">', '</div>');
        $this->form_validation->set_rules('fname', 'First Name', 'trim|required|min_length[2]|max_length[50]');
        if($data_obj->email != $this->input->post('email'))
        {
            $this->form_validation->set_rules('email', 'Email', 'trim|required|valid_email|is_unique[ec_customer.email]');
        }
    }


    public function profile_img($user_id)
    {
        $this->config->load('custom_config');
        $USER_IMG = $this->config->item('USER_IMG');
        if(isset($_FILES["user_img"]["name"]) && $_FILES["user_img"]["name"] != '' ){
            $path_parts     = pathinfo($_FILES["user_img"]["name"]);
            $user_img  = $user_id.'.'.$path_parts['extension'];
            $user_img  = trim($user_img);
            $config['upload_path']      = $USER_IMG;
            $config['allowed_types']    = 'gif|jpg|png|jpeg';
            //$config['max_size']       = 5048;
            //$config['max_width']      = 940;
            //$config['max_height']     = 336;
            $config['overwrite']        = TRUE;
            $config['file_name']        = $user_img;
            $this->load->library('upload', $config);
            $this->upload->initialize($config);
            if ($this->upload->do_upload('user_img'))
            {
                $post_data = array('user_img' => $user_img);
                $condition = array('customer_id'  => $user_id);
                $this->Query_model->update_data('ec_customer',$post_data, $condition);
            }
        }
    }


	public function ajax_user_image_upload()
	{
		$data	 =	array();
		$user_id = $this->input->post('customer_id');
		//print_r($_FILES['profileimg']); exit;


		$this->config->load('custom_config');
        $USER_IMG = $this->config->item('USER_IMG');
        if(isset($_FILES["profileimg"]["name"]) && $_FILES["profileimg"]["name"] != '' ){
            $path_parts     = pathinfo($_FILES["profileimg"]["name"]);
            $user_img  = rand(1,1000).$user_id.'.'.$path_parts['extension'];
            $user_img  = trim($user_img); 
            $config['upload_path']      = $USER_IMG;
            $config['allowed_types']    = 'gif|jpg|png|jpeg|webp';
            //$config['max_size']       = 5048;
            //$config['max_width']      = 940;
            //$config['max_height']     = 336;
            $config['overwrite']        = TRUE;
            $config['file_name']        = $user_img;
            $this->load->library('upload', $config);
            $this->upload->initialize($config);
            if ($this->upload->do_upload('profileimg'))
            {   
                $post_data = array('user_img' => $user_img);
                $condition = array('customer_id'  => $user_id);
                $data  = $this->Query_model->update_data('ec_customer',$post_data, $condition);
					
				if($data)
				{
						$userimg = base_url().'assets/user_profile/'.$user_img;
						$response = array(
										'status'    => '1',
										'message'   => 'success',
										'data'      => $userimg
										);

						$this->output
								->set_content_type('application/json')
								->set_output(json_encode($response));
				}
				else{

					 $response = array(
                                        'status'    => '0',
                                        'message'   => 'Fail',
                                        'data'      => array()
                                        );

                        $this->output
                                ->set_content_type('application/json')
                                ->set_output(json_encode($response));

				}
			
            }
            else
            {
                $error = $this->upload->display_errors();
                $response = array(
                                        'status'    => '0',
                                        'message'   => $error,
                                        'data'      => []
                                        );
                $this->output
                        ->set_content_type('application/json')
                        ->set_output(json_encode($response));
            }
        }

	}



  public function user_card_list()
  {
	 $data = array();
	 $customer_id = $this->LOGIN_ID;
	 $condition = array('customer_id' => $customer_id);
	 $card_detail = $this->Query_model->get_data('ec_card_detail', $condition); 
			
	if($card_detail)
	{
        foreach($card_detail as $row_wise)
        {
            $row_wise_valid_year = date('y/m', strtotime($row_wise->valid));
            $row_wise->valid_modify = $row_wise_valid_year; 
        }
		api_response(array('status' => 1, 'msg' => 'Success', 'data' => $card_detail));
	}
	else
	{
		api_response(array('status' => 1, 'msg' => 'No data found', 'data' => array()));
	}	

  }


