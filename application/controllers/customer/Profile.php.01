<?php 
defined('BASEPATH') OR exit('No direct script access allowed');
 
class Profile extends MY_Controller {

	function __construct() 
    {
        parent::__construct();
        $this->load->model('Query_model');
        $this->load->model('Product_model');
        $this->load->model('Checkout_model');
        $this->load->model('Order_model');
		$this->config->load('custom_config');
		$this->load->helper('api');
        $this->load->helper('text');	
		$this->load->library('ImageUploadService');	
		$this->TYPE = $this->session->userdata('type');
        $this->LOGIN_ID = ($this->session->userdata($this->TYPE)) ? $this->session->userdata($this->TYPE)['login_id'] : 0;
	}

	private function _get_customer_access_token()
	{
		$customer = $this->session->userdata('customer');
		if (is_array($customer) && !empty($customer['access_token'])) {
			return (string)$customer['access_token'];
		}
		if (!empty($_SESSION['token'])) {
			return (string)$_SESSION['token'];
		}
		return '';
	}

	private function _build_api_headers()
	{
		$token = $this->_get_customer_access_token();
		if ($token === '') {
			return [];
		}
		return ['Authorization' => 'Bearer ' . $token];
	}


	public function index()
{
    $customer = $this->session->userdata('customer');
    $customer_id0 = (int)($customer['login_id'] ?? ($customer['customer_id'] ?? 0));
    if ($customer_id0 <= 0) {
        redirect(base_url());
    }

    $tab = $this->input->get('tab') ?? 'dashboard';
	if ($tab === 'wallet' || $tab === 'wallet_transactions') {
		$this->load->model('Wallet_model');
	}

    $customer = $this->session->userdata('customer');
    $customer_id = (int)($customer['login_id'] ?? ($customer['customer_id'] ?? 0));

    $data['active_tab'] = $tab;
    $data['customer'] = $customer;
	if ($tab === 'wallet') {
		$customer_id2 = $customer['customer_id'] ?? $customer['login_id'];
		$customer_id2 = (int)$customer_id2;
		if ($customer_id2 > 0) {
			$this->Wallet_model->ensure_wallet($customer_id2);
			$data['wallet_balance'] = $this->Wallet_model->get_balance($customer_id2);
			$data['wallet_transactions'] = $this->Wallet_model->get_transactions($customer_id2, 10);
			$data['wallet_has_bank'] = $this->Wallet_model->has_bank_details($customer_id2) ? 1 : 0;
		}
	}
	if ($tab === 'wallet_transactions') {
		$customer_id2 = $customer['customer_id'] ?? $customer['login_id'];
		$customer_id2 = (int)$customer_id2;
		if ($customer_id2 > 0) {
			$this->Wallet_model->ensure_wallet($customer_id2);
			$data['wallet_balance'] = $this->Wallet_model->get_balance($customer_id2);
			$data['wallet_transactions'] = $this->Wallet_model->get_transactions($customer_id2, null);
			$data['wallet_has_bank'] = $this->Wallet_model->has_bank_details($customer_id2) ? 1 : 0;
		}
	}

	$use_api = (bool)$this->config->item('use_api');
	$headers = $this->_build_api_headers();
	if ($use_api && !empty($headers)) {
		$api_prof = call_api('GET', 'profile', null, $headers);
		if ($api_prof['response'] !== null && (int)($api_prof['response']['status'] ?? 0) === 1 && is_array($api_prof['response']['data'] ?? null)) {
			$api_data = $api_prof['response']['data'];
			$stats = is_array($api_data['stats'] ?? null) ? $api_data['stats'] : [];
			$data['total_orders'] = (int)($stats['total_orders'] ?? 0);
			$data['orders_in_progress'] = (int)($stats['orders_in_progress'] ?? 0);
			$data['orders_delivered'] = (int)($stats['orders_delivered'] ?? 0);
			$data['total_wishlist'] = (int)($stats['total_wishlist'] ?? 0);
			return $this->load->template('customer/profile', $data);
		}
	}

	$data['total_orders'] = $this->db
		->where('user_id', $customer_id)
		->count_all_results('ec_orders');

	$data['orders_in_progress'] = $this->db
		->where('user_id', $customer_id)
		->where_in('status', ['pending', 'confirmed', 'shipped'])
		->count_all_results('ec_orders');

	$data['orders_delivered'] = $this->db
		->where('user_id', $customer_id)
		->where('status', 'delivered')
		->count_all_results('ec_orders');

	$data['total_wishlist'] = $this->db
		->where('customer_id', $customer_id)
		->count_all_results('ec_wishlist');

    $this->load->template('customer/profile', $data);
}


  

	function get_profile()
	{
		$user_obj = $this->Query_model->get_data_obj('ec_customer', array('customer_id' => $this->LOGIN_ID));
		$user_obj->name = $user_obj->fname;
		$user_obj->user_image = $user_obj->user_img &&$user_obj->user_img != 'NULL' ? base_url('/uploads/profile_image/').$user_obj->user_img : base_url('/assets/images/default-profile-pic.png');
		api_response(['status'=>1, 'msg'=>'Profile Detail', 'data'=>$user_obj]);
	}

public function update_profile() {
    $customer_session = $this->session->userdata('customer');
    $customer_id = $customer_session['customer_id'] ?? $customer_session['login_id'];
    
    // Ensure these keys match your DB column names exactly
    $update_data = [
        'fname'  => $this->input->post('fname'),
        'mobile' => $this->input->post('mobile') 
    ];

    // Image Upload Logic
    if (!empty($_FILES['uploadPhoto']['name'])) {
        $config['upload_path']   = './assets/uploads/';
        $config['allowed_types'] = 'jpg|jpeg|png|webp';
        $config['file_name']     = 'user_' . $customer_id . '_' . time();

        $this->load->library('upload', $config);

        if ($this->upload->do_upload('uploadPhoto')) {
            $fileData = $this->upload->data();
            // Store the full URL in 'user_img'
            $update_data['user_img'] = base_url('assets/uploads/' . $fileData['file_name']);
        }
    }

    $this->db->where('customer_id', $customer_id); 
    if ($this->db->update('ec_customer', $update_data)) {
        
        // Update the session so the image and mobile show up on refresh
        $customer_session['fname'] = $update_data['fname'];
        $customer_session['mobile'] = $update_data['mobile'];
        if(isset($update_data['user_img'])) {
            $customer_session['user_img'] = $update_data['user_img'];
            $customer_session['profile_img'] = $update_data['user_img'];
        }
        
        $this->session->set_userdata('customer', $customer_session);
        echo json_encode(['STATUS' => 1, 'MSG' => 'Updated successfully']);
    } else {
        echo json_encode(['STATUS' => 0, 'MSG' => 'DB Update Failed']);
    }
    exit;
}

	public function change_password()
	{
		$customer_session = $this->session->userdata('customer');
		$customer_id = $customer_session['customer_id'] ?? ($customer_session['login_id'] ?? 0);
		if(!$customer_id){
			echo json_encode(['STATUS' => 0, 'MSG' => 'Please login first']);
			exit;
		}

		$new_password = (string)$this->input->post('new_password');
		$confirm_password = (string)$this->input->post('confirm_password');

		if($new_password === '' || strlen($new_password) < 6){
			echo json_encode(['STATUS' => 0, 'MSG' => 'New password must be at least 6 characters']);
			exit;
		}
		if($new_password !== $confirm_password){
			echo json_encode(['STATUS' => 0, 'MSG' => 'Password confirmation does not match']);
			exit;
		}

		$user = $this->db->select('customer_id,password')->from('ec_customer')->where('customer_id', (int)$customer_id)->limit(1)->get()->row();
		if(!$user){
			echo json_encode(['STATUS' => 0, 'MSG' => 'User not found']);
			exit;
		}

		$hashed = password_hash($new_password, PASSWORD_BCRYPT);
		$ok = $this->db->where('customer_id', (int)$customer_id)->update('ec_customer', ['password' => $hashed]);
		if($ok){
			echo json_encode(['STATUS' => 1, 'MSG' => 'Password updated successfully']);
		} else {
			echo json_encode(['STATUS' => 0, 'MSG' => 'Failed to update password']);
		}
		exit;
	}
	function addresses()
	{
		$post_data = $this->input->post();
		$where = [];
		$where['customer_id'] = $this->LOGIN_ID;
		$where['status'] ='1';
		
		if($this->input->post('address_id'))
		$where['shipping_address_id'] =$this->input->post('address_id');

		if($this->input->post('default'))
		$where['default_address'] ='1';

		$address_obj = $this->Query_model->get_data('ec_shipping_address', $where);	
		if($address_obj)
		api_response(['status'=>1, 'msg'=>'Addresses.', 'data'=>$address_obj]);
		else
		api_response(['status'=>0, 'msg'=>'There is no address.', 'data'=>[]]);
	
	}

	function get_addresses()
	{
		$customer = $this->session->userdata('customer');
		$customer_id = $this->LOGIN_ID;
		if (!$customer_id) {
			$customer_id = $customer['customer_id'] ?? ($customer['login_id'] ?? 0);
		}
		if (!$customer_id) {
			api_response(['status'=>0, 'msg'=>'Invalid customer session.', 'data'=>[]]);
			return;
		}

		$address_obj = $this->Query_model->get_data('ec_shipping_address', ['customer_id'=>$customer_id, 'status'=>'1']);	
		if($address_obj){
		$indexed = array_column($address_obj, null, 'shipping_address_id');
		api_response(['status'=>1, 'msg'=>'Addresses.', 'data'=>$indexed]);
		} else {
		api_response(['status'=>0, 'msg'=>'There is no address.', 'data'=>[]]);
		}
	
	}
	
	public function set_default_address()
	{
		$post_data = $this->input->post();
		$address_id = $post_data['address_id'];
		$this->Query_model->update_data('ec_shipping_address', ['default_address'=>'0'], ['customer_id'=>$this->LOGIN_ID]);
		$update_sts = $this->Query_model->update_data('ec_shipping_address', ['default_address'=>'1'], ['customer_id'=>$this->LOGIN_ID, 'shipping_address_id'=>$address_id]);
		if($update_sts)
		api_response(['status'=>1, 'msg'=>'Default Address Set.', 'data'=>[]]);
		else
		api_response(['status'=>0, 'msg'=>'Some Thing went wrong.', 'data'=>[]]);
		
	}

	

    public function add_address() {
    $customer = $this->session->userdata('customer');
    if (!$customer) {
        api_response(['status' => 0, 'msg' => 'Please login to add address.', 'data' => []]);
        return;
    }

    $customer_id = $this->LOGIN_ID;
    if (!$customer_id) {
        $customer_id = $customer['customer_id'] ?? ($customer['login_id'] ?? 0);
    }
    if (!$customer_id) {
        api_response(['status' => 0, 'msg' => 'Invalid customer session.', 'data' => []]);
        return;
    }

    $this->load->library('form_validation');

    $this->form_validation->set_rules('fullname', 'Full Name', 'required|trim');
    $this->form_validation->set_rules('address_1', 'Street Address', 'required|trim');
    $this->form_validation->set_rules('city', 'City', 'required|trim');
    $this->form_validation->set_rules('state', 'State', 'required|trim');
    $this->form_validation->set_rules('mobile', 'Mobile', 'required|regex_match[/^[0-9]{10}$/]');
    $this->form_validation->set_rules('postcode', 'ZIP Code', 'required|numeric');
    $this->form_validation->set_rules('address_type', 'Address Type', 'required|trim');

    if ($this->form_validation->run() == FALSE) {
        api_response(['status' => 0, 'msg' => strip_tags(validation_errors()), 'data' => []]);
        return;
    }

    $data = [
        'customer_id'  => $customer_id,
        'fullname'     => $this->input->post('fullname'),
        'address_1'    => $this->input->post('address_1'),
        'address_2'    => $this->input->post('address_2'),
        'city'         => $this->input->post('city'),
        'state'        => $this->input->post('state'),
        'mobile'       => $this->input->post('mobile'),
        'postcode'     => $this->input->post('postcode'),
        'address_type' => $this->input->post('address_type'),
        'status'       => '1'
    ];

    $address_obj = $this->Query_model->get_data('ec_shipping_address', ['customer_id' => $customer_id]);
    if (empty($address_obj)) {
        $data['default_address'] = '1';
    }

    $insert_id = '';
    $msg = '';
    if ($this->input->post('id')) {
        $id = $this->input->post('id');
        $this->Query_model->update_data('ec_shipping_address', $data, ['shipping_address_id' => $id]);
        $insert_id = $id;
        $msg = 'Updated';
    } else {
        $insert_id = $this->Query_model->insert_data('ec_shipping_address', $data);
        $msg = 'Added';
    }

    $data['shipping_address_id'] = $insert_id;
    api_response(['status' => 1, 'msg' => "Address $msg successfully", 'data' => $data]);
}


