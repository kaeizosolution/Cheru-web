	}


	public function user_address_list()
	{
		$data	=	array();
		$customer_id = $this->LOGIN_ID;
		$condition = array('customer_id' => $customer_id);
		$addressdata	=	$this->Query_model->get_data('ec_shipping_address', $condition);	

		if(is_api() && $this->input->post('request_type') == 'get')
        {
			if($addressdata)
			{
				$loc_type = location_type();
				foreach($addressdata as $row_wise)
				{
					$row_wise->loc_type_modify = isset($loc_type[$row_wise->loc_type]) ? $loc_type[$row_wise->loc_type] : '';
				}
            	api_response(array('status' => 1, 'msg' => 'success', 'data' => $addressdata));
			}
			else
			{
				api_response(array('status' => 1, 'msg' => 'No data found', 'data' => array()));
			}
        }

		if($_POST)
		{
				$data['latitude']       = $this->input->post('latitude');
				$data['longitude']      = $this->input->post('longitude');
				$data['how_to_reach']   = $this->input->post('how_to_reach');
				$data['loc_type']       = $this->input->post('loc_type');
				$data['place_id']       = $this->input->post('place_id');

				if($data['latitude'] !='' && $data['longitude'] !='')
				{
						#this function use for set location in session
						$ret_data = [];
						$ret_data['lat']    = $data['latitude'];
						$ret_data['long']   = $data['longitude'];
						$this->session->set_userdata('set_lat_long', $ret_data);
						$getdata = getLocation($data);

						$insert_data = array('customer_id'  => $customer_id,
										'city'         => $getdata['city'],
										'street'       => $getdata['area'],
										'address_1'    => $getdata['address'],
										'latitude'     => $data['latitude'],
										'longitude'    => $data['longitude'],
										'how_to_reach' => $data['how_to_reach'],
										'loc_type'     => $data['loc_type'],
										'place_id'     => $data['place_id']
												
										);

						#this Query use for the check address in database and then update the data
						$condition = array('customer_id' => $customer_id, 'latitude' => $data['latitude'], 'longitude' => $data['longitude']);
						$address_obj = $this->Query_model->get_data_obj('ec_shipping_address', $condition);
						//print_r($address_obj); exit;

						if($address_obj)
						{
								$condition1 = array('shipping_address_id' => $address_obj->shipping_address_id, 'customer_id' => $customer_id);
								$address   = $this->Query_model->update_data('ec_shipping_address', $insert_data, $condition1);
								api_response(array('status' => 1, 'msg' => 'Your Address added successfully', 'data' => array()));
						}
						else
						{
								$shipping_address_id = $this->Query_model->insert_data('ec_shipping_address', $insert_data);
                                $condition = array('shipping_address_id'=>$shipping_address_id, 'customer_id'=>$customer_id);
                                $condition1 = array('customer_id'=>$customer_id);
                                $update =   $this->Query_model->update_data('ec_shipping_address', array('default_address'=>'0'),$condition1);
                                $update =   $this->Query_model->update_data('ec_shipping_address', array('default_address'=>'1'),$condition);
								if($shipping_address_id)
								{
										api_response(array('status' => 1, 'msg' => 'Your Address added successfully', 'data' => $shipping_address_id));			
								}
								else
								{
										api_response(array('status' => 0, 'msg' => 'Fail', 'data' => array()));
								}
						}

				}
			else
			{
				api_response(array('status' => 1, 'msg' => 'Please select your location', 'data' => array()));
			}
		}

	}


	public function delete_my_address()
	{
		$data		 =	array();
		$customer_id = $this->LOGIN_ID;
		$address_id  = $this->input->post('shipping_address_id');
			
		$this->delete_address_validation();
        if($this->form_validation->run() == FALSE)
        {
            api_response(array('status' => 0, 'msg' => remove_extra_for_api(validation_errors()), 'data' => array()));
			return;
        }
	
		if($_POST)
		{
			$condition = array('customer_id' => $customer_id, 'shipping_address_id' => $address_id);
			$shipping_address = $this->Query_model->delete_query('ec_shipping_address', $condition);

			// Ensure at least one default address remains for the customer
			$remaining = $this->db
				->from('ec_shipping_address')
				->where('customer_id', $customer_id)
				->where('status', '1')
				->count_all_results();

			if ((int)$remaining > 0) {
				$has_default = $this->db
					->from('ec_shipping_address')
					->where('customer_id', $customer_id)
					->where('status', '1')
					->where('default_address', '1')
					->count_all_results();

				if ((int)$has_default === 0) {
					$next_default = $this->db
						->select('shipping_address_id')
						->from('ec_shipping_address')
						->where('customer_id', $customer_id)
						->where('status', '1')
						->order_by('shipping_address_id', 'ASC')
						->limit(1)
						->get()
						->row();

					if (!empty($next_default) && !empty($next_default->shipping_address_id)) {
						$this->Query_model->update_data('ec_shipping_address', array('default_address' => '0'), array('customer_id' => $customer_id));
						$this->Query_model->update_data('ec_shipping_address', array('default_address' => '1'), array('shipping_address_id' => $next_default->shipping_address_id));
					}
				}
			}

			if(is_api()){

					if($shipping_address)
					{
							api_response(array('status' => 1, 'msg' => 'Remove a address successfully', 'data' => array()));
					}
					else
					{
							api_response(array('status' => 0, 'msg' => 'Fail', 'data' => array()));
					}
			}else
			{
				$response = array(
                'status'    => 1,
                'message'   => 'Remove a address successfully',
                'data'      => $shipping_address
                );
                
                $this->output
                ->set_content_type('application/json')
                ->set_output(json_encode($response));
			}
		}
		
	}

	public function delete_address_validation()
	{
        $this->load->library('form_validation');
        $this->form_validation->set_error_delimiters('<div class="error">', '</div>');
        $this->form_validation->set_rules('shipping_address_id', 'Select Address', 'trim|required', array('required' => 'Please the select address'));
	}



	public function update_user_address()
	{
		$data	=	array();
		$customer_id	=	$this->LOGIN_ID;
		$shipping_address_id = $this->input->post('shipping_address_id');			

		$this->delete_address_validation(); 
        if($this->form_validation->run() == FALSE)
        {
            api_response(array('status' => 0, 'msg' => remove_extra_for_api(validation_errors()), 'data' => array()));
			return;
        }		
	
		if(is_api() && $this->input->post('request_type') == 'get')
		{
			$condition = array('shipping_address_id' => $shipping_address_id, 'customer_id'=> $customer_id);
			$address_obj = $this->Query_model->get_data_obj('ec_shipping_address', $condition);
			
			if($address_obj)
			{
				api_response(array('status' => 1, 'msg' => 'Successfull', 'data' => $address_obj));
			}			
		}	

		if($shipping_address_id)
		{
			$com_address	=	$this->input->post('complete_address');
			$how_to_reach	=	$this->input->post('how_to_reach');
			$address_obj = $this->Query_model->get_data_obj('ec_shipping_address', array('shipping_address_id'=> $shipping_address_id));
			$data	=	array('customer_id' => $customer_id,
							  'address_1' 	=> $com_address,
							  'how_to_reach'=> $how_to_reach,
							  'latitude'    => $address_obj->latitude,
							  'longitude'   => $address_obj->longitude,
							  'city'		=> $address_obj->city,
							  'street'		=> $address_obj->street);

		   $condition = array('shipping_address_id' => $shipping_address_id);
		   $update	=	$this->Query_model->update_data('ec_shipping_address', $data, $condition);
			
			if($update)
			{
				api_response(array('status' => 1, 'msg' => 'Address updated successfully', 'data' => array()));
			}

		}

	}


