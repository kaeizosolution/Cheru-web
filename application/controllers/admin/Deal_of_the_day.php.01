<?php if ( ! defined('BASEPATH')) exit('No direct script access allowed');

class Deal_of_the_day extends MY_Controller {

    function __construct()
    {
        parent::__construct();
        $this->load->model('Query_model');
        $this->TYPE = $this->session->userdata('type');
    }

    public function index()
    {
        if(!logged_in()) redirect("$this->TYPE/auth/login");

        $page_lang = get_page_language_data('admin_page_lang');
        $crumbs = array($page_lang->home => "/$this->TYPE/dashboard", 'Deal of the Day' => "");
        $breadcrumbs = $this->breadcrumbs->show($crumbs);
        $data['breadcrumbs'] = $breadcrumbs;

        $data['csrf'] = csrf_token();
        $data['TYPE'] = $this->TYPE;
        $data['page_count'] = page_count();

        $this->load->template("$this->TYPE/deal_of_the_day/index", $data);
    }

    public function ajax_list()
    {
        if(!logged_in()) redirect("$this->TYPE/auth/login");

        $start = (int)$this->input->post('start');
        $length = (int)$this->input->post('length');
        if ($length <= 0) {
            $length = page_count();
        }

        $recordsTotal = (int)$this->db->count_all('ec_deal_of_the_day');

        $filter_product_id = trim((string)$this->input->post('filter_product_id'));
        $filter_discount_type = trim((string)$this->input->post('filter_discount_type'));
        $filter_timezone = trim((string)$this->input->post('filter_timezone'));
        $filter_deal_date = trim((string)$this->input->post('filter_deal_date'));

        $this->db
            ->select('d.id, d.product_id, d.discount_type, d.discount_percent, d.discount_amount, d.timezone, d.deal_date, d.status, p.name as product_name')
            ->from('ec_deal_of_the_day d')
            ->join('products p', 'p.id = d.product_id', 'left');

        if ($filter_product_id !== '') {
            $this->db->where('d.product_id', $filter_product_id);
        }
        if ($filter_discount_type !== '') {
            $this->db->where('d.discount_type', $filter_discount_type);
        }
        if ($filter_timezone !== '') {
            $this->db->where('d.timezone', $filter_timezone);
        }
        if ($filter_deal_date !== '') {
            $this->db->where('d.deal_date', $filter_deal_date);
        }

        $recordsFiltered = (int)$this->db->count_all_results('', false);
        $this->db->order_by('d.id', 'DESC');
        $this->db->limit($length, $start);
        $deals = $this->db->get()->result();

        $data = array();
        foreach ($deals as $obj) {
            $regular_price = $this->_get_product_base_price((int)($obj->product_id ?? 0));

            $discount_percent = (float)($obj->discount_percent ?? 0);
            $discount_amount = (float)($obj->discount_amount ?? 0);
            if ((string)$obj->discount_type === 'PERCENT') {
                $discount_amount = ($regular_price * $discount_percent) / 100;
            }
            $deal_price = $regular_price - $discount_amount;
            if ($deal_price < 0) {
                $deal_price = 0;
            }

            $row = array();
            $row['id'] = $obj->id;
            $row['product_name'] = $obj->product_name ?? '';
            $row['sales_price'] = number_format((float)$regular_price, 2);
            $row['discount_type'] = (string)$obj->discount_type;
            $row['discount_percent'] = number_format((float)$discount_percent, 2);
            $row['discount_amount'] = number_format((float)$discount_amount, 2);
            $row['deal_price'] = number_format((float)$deal_price, 2);
            $row['timezone'] = (string)($obj->timezone ?? 'UTC');
            $row['deal_date'] = date('d-M-Y', strtotime($obj->deal_date));
            $row['status'] = (string)($obj->status ?? '1');
            $row['status_label'] = ((string)($obj->status ?? '1') === '1') ? 'Active' : 'Inactive';
            $data[] = $row;
        }

        echo json_encode([
            "draw" => intval($this->input->post('draw')),
            "recordsTotal" => $recordsTotal,
            "recordsFiltered" => $recordsFiltered,
            "data" => $data,
        ]);
    }

    public function add()
    {
        if(!logged_in()) redirect("$this->TYPE/auth/login");
        $this->post();
    }

    public function update($id)
    {
        if(!logged_in()) redirect("$this->TYPE/auth/login");
        $this->post($id);
    }

    private function _deal_validation()
    {
        $this->load->library('form_validation');
        $this->form_validation->set_rules('product_id', 'Product', 'trim|required');
        $this->form_validation->set_rules('discount_type', 'Discount Type', 'trim|required');
        $this->form_validation->set_rules('discount_percent', 'Discount Percent', 'trim');
        $this->form_validation->set_rules('discount_amount', 'Discount Amount', 'trim');
        $this->form_validation->set_rules('deal_date', 'Deal Date', 'trim|required');
    }

    public function search_ajax_product()
    {
        if(!logged_in()) redirect("$this->TYPE/auth/login");

        $search = (string)$this->input->post('searchTerm');
        $search = trim($search);

        $this->db->select('id, name');
        $this->db->from('products');
        $this->db->where('status', '1');
        if ($search !== '') {
            $this->db->like('name', $search);
        }
        $this->db->order_by('id', 'DESC');
        $this->db->limit(20);
        $rows = $this->db->get()->result();

        $data = array();
        foreach ($rows as $r) {
            $data[] = array(
                'id' => (int)$r->id,
                'text' => (string)$r->name,
            );
        }
        echo json_encode($data);
    }

    public function ajax_get_product_prices()
    {
        if(!logged_in()) redirect("$this->TYPE/auth/login");

        $product_id = (int)$this->input->post('product_id');
        $csrf = csrf_token();
        if ($product_id <= 0) {
            echo json_encode(['success' => 0, 'msg' => 'Invalid product.', 'csrf' => $csrf]);
            return;
        }

        $p = $this->db
            ->select('id, name')
            ->from('products')
            ->where('id', $product_id)
            ->limit(1)
            ->get()->row();
        if (!$p) {
            echo json_encode(['success' => 0, 'msg' => 'Product not found.', 'csrf' => $csrf]);
            return;
        }

        $prices = $this->_get_product_prices_table($product_id);
        $base_price = $this->_get_product_base_price($product_id);

        echo json_encode([
            'success' => 1,
            'csrf' => $csrf,
            'product' => ['id' => (int)$p->id, 'name' => (string)$p->name],
            'prices' => $prices,
            'base_price' => $base_price,
        ]);
    }

    public function ajax_get_deal()
    {
        if(!logged_in()) redirect("$this->TYPE/auth/login");

        $csrf = csrf_token();
        $id = (int)$this->input->post('id');
        if ($id <= 0) {
            echo json_encode(['success' => 0, 'msg' => 'Invalid deal.', 'csrf' => $csrf]);
            return;
        }

        $deal = $this->db
            ->select('id, product_id, discount_type, discount_percent, discount_amount, timezone, deal_date, status')
            ->from('ec_deal_of_the_day')
            ->where('id', $id)
            ->limit(1)
            ->get()->row();
        if (!$deal) {
            echo json_encode(['success' => 0, 'msg' => 'Deal not found.', 'csrf' => $csrf]);
            return;
        }

        $product_id = (int)$deal->product_id;
        $p = null;
        $prices = array();
        $base_price = 0;
        if ($product_id > 0) {
            $p = $this->db
                ->select('id, name')
                ->from('products')
                ->where('id', $product_id)
                ->limit(1)
                ->get()->row();
            if ($p) {
                $prices = $this->_get_product_prices_table($product_id);
                $base_price = $this->_get_product_base_price($product_id);
            }
        }

        echo json_encode([
            'success' => 1,
            'csrf' => $csrf,
            'deal' => [
                'id' => (int)$deal->id,
                'product_id' => (string)$deal->product_id,
                'discount_type' => (string)$deal->discount_type,
                'discount_percent' => (string)$deal->discount_percent,
                'discount_amount' => (string)$deal->discount_amount,
                'timezone' => (string)$deal->timezone,
                'deal_date' => (string)$deal->deal_date,
                'status' => (string)$deal->status,
            ],
            'product' => $p ? ['id' => (int)$p->id, 'name' => (string)$p->name] : null,
            'prices' => $prices,
            'base_price' => $base_price,
        ]);
    }

    public function ajax_insert()
    {
        if(!logged_in()) redirect("$this->TYPE/auth/login");

        $csrf = csrf_token();
        $product_id = (int)$this->input->post('product_id');
        $discount_type = (string)$this->input->post('discount_type');
        $discount_percent = (float)$this->input->post('discount_percent');
        $discount_amount = (float)$this->input->post('discount_amount');
        $deal_date = (string)$this->input->post('deal_date');
        $timezone = (string)($this->input->post('timezone') ?: 'UTC');
        $deal_status = $this->input->post('status');

        if ($product_id <= 0) {
            echo json_encode(['success' => 0, 'msg' => 'Product is required.', 'csrf' => $csrf]);
            return;
        }
        if (!in_array($discount_type, ['FIXED', 'PERCENT'], true)) {
            echo json_encode(['success' => 0, 'msg' => 'Invalid discount type.', 'csrf' => $csrf]);
            return;
        }
        if (!$deal_date) {
            echo json_encode(['success' => 0, 'msg' => 'Deal date is required.', 'csrf' => $csrf]);
            return;
        }

        if ($discount_type === 'PERCENT') {
            if ($discount_percent < 0 || $discount_percent > 100) {
                echo json_encode(['success' => 0, 'msg' => 'Discount percent must be between 0 and 100.', 'csrf' => $csrf]);
                return;
            }
            $discount_amount = 0;
        } else {
            $discount_percent = 0;
            if ($discount_amount < 0) {
                echo json_encode(['success' => 0, 'msg' => 'Discount amount must be >= 0.', 'csrf' => $csrf]);
                return;
            }
        }

        $exists = $this->db
            ->select('id')
            ->from('products')
            ->where('id', $product_id)
            ->limit(1)
            ->get()->row();
        if (!$exists) {
            echo json_encode(['success' => 0, 'msg' => 'Product not found.', 'csrf' => $csrf]);
            return;
        }

        $db_data = array(
            'product_id' => (string)$product_id,
            'discount_type' => $discount_type,
            'discount_percent' => (string)$discount_percent,
            'discount_amount' => $discount_amount,
            'timezone' => $timezone,
            'deal_date' => $deal_date,
            'status' => ($deal_status !== null && in_array((string)$deal_status, ['0', '1'], true)) ? (string)$deal_status : '1',
        );

        $insert_id = $this->Query_model->insert_data('ec_deal_of_the_day', $db_data);
        if ($insert_id) {
            echo json_encode(['success' => 1, 'msg' => 'Inserted Successfully.', 'csrf' => $csrf]);
            return;
        }

        echo json_encode(['success' => 0, 'msg' => 'Insert failed.', 'csrf' => $csrf]);
    }

    public function ajax_save()
    {
        if(!logged_in()) redirect("$this->TYPE/auth/login");

        $csrf = csrf_token();
        $id = (int)$this->input->post('id');
        $product_id = (int)$this->input->post('product_id');
        $discount_type = (string)$this->input->post('discount_type');
        $discount_percent = (float)$this->input->post('discount_percent');
        $discount_amount = (float)$this->input->post('discount_amount');
        $deal_date = (string)$this->input->post('deal_date');
        $timezone = (string)($this->input->post('timezone') ?: 'UTC');
        $deal_status = $this->input->post('status');

        if ($product_id <= 0) {
            echo json_encode(['success' => 0, 'msg' => 'Product is required.', 'csrf' => $csrf]);
            return;
        }
        if (!in_array($discount_type, ['FIXED', 'PERCENT'], true)) {
            echo json_encode(['success' => 0, 'msg' => 'Invalid discount type.', 'csrf' => $csrf]);
            return;
        }
        if (!$deal_date) {
            echo json_encode(['success' => 0, 'msg' => 'Deal date is required.', 'csrf' => $csrf]);
            return;
        }

        if ($discount_type === 'PERCENT') {
            if ($discount_percent < 0 || $discount_percent > 100) {
                echo json_encode(['success' => 0, 'msg' => 'Discount percent must be between 0 and 100.', 'csrf' => $csrf]);
                return;
            }
            $discount_amount = 0;
        } else {
            $discount_percent = 0;
            if ($discount_amount < 0) {
                echo json_encode(['success' => 0, 'msg' => 'Discount amount must be >= 0.', 'csrf' => $csrf]);
                return;
            }
        }

        $exists = $this->db
            ->select('id')
            ->from('products')
            ->where('id', $product_id)
            ->limit(1)
            ->get()->row();
        if (!$exists) {
            echo json_encode(['success' => 0, 'msg' => 'Product not found.', 'csrf' => $csrf]);
            return;
        }

        if ($deal_status !== null && !in_array((string)$deal_status, ['0', '1'], true)) {
            echo json_encode(['success' => 0, 'msg' => 'Invalid status.', 'csrf' => $csrf]);
            return;
        }

        $db_data = array(
            'product_id' => (string)$product_id,
            'discount_type' => $discount_type,
            'discount_percent' => (string)$discount_percent,
            'discount_amount' => $discount_amount,
            'timezone' => $timezone,
            'deal_date' => $deal_date,
        );

        if ($deal_status !== null) {
            $db_data['status'] = (string)$deal_status;
        }

        if ($id > 0) {
            $deal_exists = $this->db
                ->select('id')
                ->from('ec_deal_of_the_day')
                ->where('id', $id)
                ->limit(1)
                ->get()->row();
            if (!$deal_exists) {
                echo json_encode(['success' => 0, 'msg' => 'Deal not found.', 'csrf' => $csrf]);
                return;
            }
            $this->Query_model->update_data('ec_deal_of_the_day', $db_data, array('id' => $id));
            echo json_encode(['success' => 1, 'msg' => 'Updated Successfully.', 'csrf' => $csrf]);
            return;
        }

        if (!isset($db_data['status'])) {
            $db_data['status'] = '1';
        }
        $insert_id = $this->Query_model->insert_data('ec_deal_of_the_day', $db_data);
        if ($insert_id) {
            echo json_encode(['success' => 1, 'msg' => 'Inserted Successfully.', 'csrf' => $csrf]);
            return;
        }
        echo json_encode(['success' => 0, 'msg' => 'Insert failed.', 'csrf' => $csrf]);
    }

    private function post($id = null)
    {
        $this->_deal_validation();

        $page_lang = get_page_language_data('admin_page_lang');
        $action_bc = isset($id) ? $page_lang->update : $page_lang->add;
        $crumbs = array($page_lang->home => "/$this->TYPE/dashboard", 'Deal of the Day' => "/$this->TYPE/deal_of_the_day", "$action_bc" => 'action');
        $breadcrumbs = $this->breadcrumbs->show($crumbs);

        $data = array();
        $data['breadcrumbs'] = $breadcrumbs;
        $data['csrf'] = csrf_token();
        $data['TYPE'] = $this->TYPE;
        $data['action'] = isset($id) ? $page_lang->update : $page_lang->add;
        $data['id'] = $id;

        $data['product_obj'] = $this->Query_model->get_data('products', array('status' => '1'), array('id' => 'DESC'));

        if (isset($id)) {
            $deal_obj = $this->Query_model->get_data_obj('ec_deal_of_the_day', array('id' => $id));
            if (!$deal_obj) {
                $this->session->set_flashdata('error', 'Invalid Error.');
                redirect("$this->TYPE/deal_of_the_day");
            }
            if (!$_POST) {
                $data['product_id'] = $deal_obj->product_id;
                $data['discount_type'] = $deal_obj->discount_type;
                $data['discount_percent'] = $deal_obj->discount_percent;
                $data['discount_amount'] = $deal_obj->discount_amount;
                $data['timezone'] = $deal_obj->timezone;
                $data['deal_date'] = $deal_obj->deal_date;
                $data['status'] = $deal_obj->status;
            }
        }

        if ($this->form_validation->run() == FALSE) {
            $this->load->template("$this->TYPE/deal_of_the_day/form", $data);
            return;
        }

        $discount_type = (string)$this->input->post('discount_type');
        $discount_percent = (float)$this->input->post('discount_percent');
        $discount_amount = (float)$this->input->post('discount_amount');
        if ($discount_type === 'PERCENT') {
            $discount_amount = 0;
        }
        if ($discount_type === 'FIXED') {
            $discount_percent = 0;
        }

        $db_data = array(
            'product_id' => (string)$this->input->post('product_id'),
            'discount_type' => $discount_type,
            'discount_percent' => (string)$discount_percent,
            'discount_amount' => $discount_amount,
            'timezone' => (string)($this->input->post('timezone') ?: 'UTC'),
            'deal_date' => (string)$this->input->post('deal_date'),
            'status' => (string)($this->input->post('status') ?: '1'),
        );

        if (isset($id)) {
            $this->Query_model->update_data('ec_deal_of_the_day', $db_data, array('id' => $id));
            $this->session->set_flashdata('success', 'Updated Successfully.');
        } else {
            $this->Query_model->insert_data('ec_deal_of_the_day', $db_data);
            $this->session->set_flashdata('success', 'Inserted Successfully.');
        }

        redirect("$this->TYPE/deal_of_the_day");
    }

    public function ajax_toggle_status()
    {
        if(!logged_in()) redirect("$this->TYPE/auth/login");

        $deal_id = (int)$this->input->post('deal_id');
        $new_status = (string)$this->input->post('status');
        $csrf = csrf_token();

        if ($deal_id <= 0 || !in_array($new_status, ['0', '1'], true)) {
            echo json_encode(['success' => 0, 'msg' => 'Invalid data.', 'csrf' => $csrf]);
            return;
        }

        $exists = $this->db
            ->select('id')
            ->from('ec_deal_of_the_day')
            ->where('id', $deal_id)
            ->limit(1)
            ->get()->row();
        if (!$exists) {
            echo json_encode(['success' => 0, 'msg' => 'Deal not found.', 'csrf' => $csrf]);
            return;
        }

        $updated = $this->Query_model->update_data('ec_deal_of_the_day', ['status' => $new_status], ['id' => $deal_id]);
        if ($updated) {
            echo json_encode(['success' => 1, 'msg' => 'Status updated.', 'csrf' => $csrf, 'status' => $new_status]);
            return;
        }

        echo json_encode(['success' => 0, 'msg' => 'Failed to update status.', 'csrf' => $csrf]);
    }

    private function _get_product_base_price($product_id)
    {
        $product_id = (int)$product_id;
        if ($product_id <= 0) {
            return 0;
        }

        $row = $this->db
            ->select('MIN(pp.price) AS min_price', false)
            ->from('product_variations v')
            ->join('product_variation_price pp', 'pp.variation_id = v.id', 'inner')
            ->where('v.product_id', $product_id)
            ->get()->row();

        if ($row && isset($row->min_price) && $row->min_price !== null) {
            return (float)$row->min_price;
        }

        return 0;
    }

    private function _get_product_prices_table($product_id)
    {
        $product_id = (int)$product_id;
        if ($product_id <= 0) {
            return [];
        }

        // Use the smallest min_qty tier per variation as its base price.
        $sub = "SELECT variation_id, MIN(COALESCE(min_qty,0)) AS min_qty FROM product_variation_price GROUP BY variation_id";
        $rows = $this->db
            ->select('v.id AS variation_id, pp.price')
            ->from('product_variations v')
            ->join("($sub) x", 'x.variation_id = v.id', 'inner', false)
            ->join('product_variation_price pp', 'pp.variation_id = v.id AND COALESCE(pp.min_qty,0) = x.min_qty', 'inner', false)
            ->where('v.product_id', $product_id)
            ->order_by('v.id', 'ASC')
            ->limit(50)
            ->get()->result();

        $out = [];
        if ($rows) {
            foreach ($rows as $r) {
                $out[] = [
                    'label' => 'Variation #' . (int)$r->variation_id,
                    'sales_price' => (string)number_format((float)$r->price, 2, '.', ''),
                    'regular_price' => (string)number_format((float)$r->price, 2, '.', ''),
                ];
            }
        }
        return $out;
    }
}

