<?php
defined('BASEPATH') OR exit('No direct script access allowed');

class Banner extends MY_Controller {

    public function __construct(){
        parent::__construct();
        $this->load->model('Query_model');
        $this->load->model('Attribute_model');
        $this->TYPE = $this->session->userdata('type');		
    }

    public function index(){

        if(!logged_in()) redirect("$this->TYPE/auth/login");

        $this->get_ajax_banner(1);
    }


    public function add($widget_id = NULL)
    {
        if(!logged_in()) redirect("$this->TYPE/auth/login");

		if (!$_POST) {
			$this->session->unset_userdata('banner_message');
			$this->session->unset_userdata('error');
		}

        if ($widget_id === null || $widget_id === '' || (int)$widget_id <= 0) {
            $widget_id = 1;
        }
        $data = array();
        $data['admin'] = 1;
        $banner_type = banner_type($widget_id);
        $page_lang = get_page_language_data('admin_page_lang');
        $crumbs = array($page_lang->home => "/$this->TYPE/dashboard", 'Banner' => "/$this->TYPE/banner", "add banner"=>'');
        $breadcrumbs = $this->breadcrumbs->show($crumbs);
        $data['breadcrumbs']    = $breadcrumbs;

        $data['csrf'] = csrf_token();
        $data['TYPE'] = $this->TYPE;
        $data['error'] = false;
        $data['type'] = '';
        $data['banner_type'] = $banner_type;
        $data['widget_id'] = $widget_id;
        $data['message']['error'] = '';

        $this->banner_validation();

        if($_POST) {
            $data['type']          		= $widget_id;
            $data['url']             	= $this->input->post('url');
            $data['title']             	= $this->input->post('title');
            $data['banner_image']       = $this->input->post('banner_image');
            $data['tag']            		= $this->input->post('tag');
            $data['description']    		= $this->input->post('description');
            $data['enabled']          	= $this->input->post('enabled');
        }else{
            if(isset($banner_id)){

                redirect("$this->TYPE/banner/add", $data);				
            }
        }
        if ($_POST && $this->form_validation->run())
        {
            $post_data = array(
                    'type'     		=> $widget_id,
                    'title'         => $data['title'],
                    'url'           => $data['url'],
                    'banner_image'  => $data['banner_image'],
                    'tag'           => $data['tag'],
                    'description'   => $data['description'],
                    'enabled'       => $data['enabled'],
                    );
            if(isset($banner_id)){
                $condition = array('banner_id' => $banner_id);
                $this->Query_model->update_data('ec_banner',$post_data, $condition);
                $ok = $this->banner_upload($banner_id, $widget_id);
                if ($ok) {
                    $this->session->set_flashdata('error', '');
                    $this->session->set_flashdata('banner_message', 'Banner updated successfully.');
                }
                redirect("$this->TYPE/banner/add/$widget_id");
            }else{
                $banner_id = $this->Query_model->insert_data('ec_banner',$post_data);
                $ok = $this->banner_upload($banner_id,$widget_id);
                if ($ok) {
                    $this->session->set_flashdata('error', '');
                    $this->session->set_flashdata('banner_message', 'Banner added successfully.');
                }
                redirect("$this->TYPE/banner/get_ajax_banner/$widget_id");
            }
        }else{
            $data['TYPE']          = $this->TYPE;
            $data['csrf']          = csrf_token();
            $this->load->template("$this->TYPE/banner/add",$data); 	
        }  

    }


    public function banner_validation()
    {
        $this->load->library('form_validation');
        $this->form_validation->set_rules('title', 'Banner Heading', 'trim|required');
		#$this->form_validation->set_rules('url', 'URL', 'trim|required');
        //$this->form_validation->set_rules('image', 'Image', 'trim|required');
		#$this->form_validation->set_rules('height', 'Banner Height in px', 'trim|required');
		#$this->form_validation->set_rules('width', 'Banner width in px', 'trim|required');
    }



    public function update($banner_id = NULL)
    {

        if(!logged_in()) redirect("$this->TYPE/auth/login");

		if (!$_POST) {
			$this->session->unset_userdata('banner_message');
			$this->session->unset_userdata('error');
		}
        $data = array();
        $data['admin'] = 1;
        $page_lang = get_page_language_data('admin_page_lang'); 
        $crumbs = array($page_lang->home => "/$this->TYPE/dashboard", 'Banner' => "/$this->TYPE/banner", "update banner"=>'');
        $breadcrumbs = $this->breadcrumbs->show($crumbs);
        $data['breadcrumbs']    = $breadcrumbs;

        $data['csrf'] = csrf_token();
        $data['TYPE'] = $this->TYPE;
        $data['error'] = false;
        $data['message']['error'] = '';

        $this->banner_validation();

        $condition = array("banner_id" => $banner_id);
        $requirement_obj = $this->Query_model->get_data_obj('ec_banner', $condition);

        //	echo "<pre>"; print_r($requirement_obj); echo "</pre>";
        //die;
        if( isset($requirement_obj) && !empty($requirement_obj) ){
			$img_arr = [];
			$img_val = isset($requirement_obj->banner_image) ? (string)$requirement_obj->banner_image : '';
			if ($img_val !== '') {
				$un = @unserialize($img_val);
				if (is_array($un)) {
					$img_arr = $un;
				}
			}
			$data['banner_id']              = $requirement_obj->banner_id;
			$data['title']                  = $requirement_obj->title;
			$data['type']                   = $requirement_obj->type;
			$data['url']                    = $requirement_obj->url;
			if ($img_arr && isset($img_arr['thumb'])) {
				$data['banner_image']           = $img_arr['thumb'];
			} else {
				$data['banner_image']           = $img_val;
			}
			$data['tag']                    = isset($requirement_obj->tag) ? $requirement_obj->tag : '';
			$data['description']            = isset($requirement_obj->description) ? $requirement_obj->description : '';
			$data['enabled']                = $requirement_obj->enabled;
		}
        if ($_POST && $this->form_validation->run())
        {   
            if($_POST){
                $post_data = array(
                        'type'          => $this->input->post('type'),
                        'title'         => $this->input->post('title'),
                        'url'           => $this->input->post('url'),
                        //'banner_image'  => $this->input->post('banner_image'),
                        'tag'           => $this->input->post('tag'),
                        'description'   => $this->input->post('description'),
                        'enabled'       => $this->input->post('enabled')
                        );
            }

            if(isset($banner_id)){
                $condition = array('banner_id' => $banner_id);
                $widget_id = $post_data['type'];
                $this->Query_model->update_data('ec_banner',$post_data, $condition);
                $ok = $this->banner_upload($banner_id,$widget_id);
                if ($ok) {
                    $this->session->set_flashdata('error', '');
                    $this->session->set_flashdata('banner_message', 'Banner updated successfully.');
                }

                redirect("$this->TYPE/banner/get_ajax_banner/$widget_id");
            }
        }

        if( isset($data['type']) ){
            $banner_type = banner_type($data['type']);
            $data['banner_type'] = $banner_type;
        }	 
        $this->load->template("$this->TYPE/banner/add",$data);
    }

    public function banner_upload($banner_id = NULL, $widget_id = NULL)
    	{	
        if(!isset($_FILES["banner_image"]["name"]) || $_FILES["banner_image"]["name"] == '' ){
			return true;
		}

		$upload_dir = rtrim(FCPATH, '/\\') . DIRECTORY_SEPARATOR . 'assets' . DIRECTORY_SEPARATOR . 'home_page_banner' . DIRECTORY_SEPARATOR;
		if (!is_dir($upload_dir)) {
			@mkdir($upload_dir, 0755, true);
		}
		@chmod($upload_dir, 0775);
		if (!is_writable($upload_dir)) {
			$this->session->set_flashdata('banner_message', '');
			$this->session->set_flashdata('error', 'The upload destination folder does not appear to be writable.');
			return false;
		}
		$config = array(				
					'upload_path' => $upload_dir,
					'allowed_types' => "gif|jpg|png|jpeg|pdf",
					'max_size' => "20240000",
					);				

		$this->load->library('Upload', $config);
		$this->upload->initialize($config);
		if ($this->upload->do_upload('banner_image'))
		{
                $data_file = $this->upload->data();	
                $ppnewimagename = $data_file["file_name"];
                $thumb_arr = explode(".", $ppnewimagename);
                $large = $thumb_arr[0] . "_large". "." . $thumb_arr[1];
                $ppthumb = $thumb_arr[0] . "_thumb". "." . $thumb_arr[1];

